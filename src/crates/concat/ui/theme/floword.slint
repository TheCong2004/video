import { Theme } from "theme.slint";
export global Floword {
    out property <color> ground: #080D1B;
    out property <color> surface: #121A2C;
    out property <color> field: #162036;
    out property <color> raised: #1A2540;
    out property <color> line: #26365F;
    out property <color> line-bright: #33466B;
    out property <color> text: #F4F7FF;
    out property <color> muted: #A7B6D3;
    out property <color> accent: #3568FF;
    out property <color> button: #3568FF;
    out property <color> button-hover: #4D7CFF;
    out property <color> violet: #7654FF;
    out property <color> cyan: #39C8FF;
    out property <color> success: #38D9A5;
    out property <color> warning: #FFBE62;
    out property <color> danger: #FF647C;
    out property <color> on-accent: #FFFFFF;
}

