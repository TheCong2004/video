// Native translation of FlowordStudio/src/index.css. Studio is deliberately
// distinct from the editing workspace; its source design is not the lime theme.
import { Theme } from "theme.slint";
export global Floword {
    out property <color> ground: Theme.dark ? #0e1118 : #f1f3f8;
    out property <color> surface: Theme.dark ? #161c28 : #ffffff;
    out property <color> field: Theme.dark ? #1e2638 : #f5f6fa;
    out property <color> raised: Theme.dark ? #263248 : #e9edf5;
    out property <color> line: Theme.dark ? #2e3a50 : #15244022;
    out property <color> text: Theme.dark ? #ffffff : #172033;
    out property <color> muted: Theme.dark ? #94a3b8 : #525c70;
    out property <color> accent: Theme.dark ? #6366f1 : #4f46e5;
    out property <color> button: #10b981;
    out property <color> violet: Theme.dark ? #818cf8 : #6151bd;
    out property <color> success: Theme.dark ? #10b981 : #18764a;
    out property <color> warning: Theme.dark ? #fbbf24 : #885b00;
    out property <color> danger: Theme.dark ? #f43f5e : #b32929;
    out property <color> on-accent: #ffffff;
}

