import { I18n } from "../i18n.slint";
import { Floword } from "../theme/floword.slint";
import { StudioCard, StudioHeading, StudioButton } from "studio-chrome.slint";

export struct StudioPublishRowItem {
    id: string,
    title: string,
    page-name: string,
    platform: string,
    status: string,
    scheduled-time: string,
    error-message: string,
}

export global StudioPublish {
    // There is no platform publisher implementation/configuration in local edition.
    out property <bool> publisher-ready: false;
    in-out property <string> platform-filter: "all";
    in-out property <string> status-filter: "all";
    in-out property <bool> busy;
    in-out property <string> status;
    in-out property <int> pending-count;
    in-out property <[StudioPublishRowItem]> items;
    callback refresh();
    callback approve(string);
    callback post-now(string);
    callback reject(string);
    callback retry(string);
}

export component StudioPublishPanel inherits VerticalLayout {
    min-width: 0px; spacing: 16px;
    StudioCard {
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioHeading { title: "Video đã xuất"; }
            StudioButton { label: StudioPublish.busy ? "Đang tải…" : "Tải lại danh sách"; enabled: !StudioPublish.busy; clicked => { StudioPublish.refresh(); } }
        }
        Text { text: "Đăng tự động chưa khả dụng. Video đã xuất vẫn được lưu trên máy."; color: Floword.muted; wrap: word-wrap; }
        if StudioPublish.status != "": Text { text: StudioPublish.status; color: Floword.warning; wrap: word-wrap; }
        if !StudioPublish.busy && StudioPublish.items.length == 0: Text { text: "Chưa có video đã xuất."; color: Floword.muted; wrap: word-wrap; }
        for item in StudioPublish.items: VerticalLayout {
            spacing: 8px; min-width: 0px;
            Rectangle { height: 1px; background: Floword.line; }
            Text { text: item.title; color: Floword.text; font-size: 16px; font-weight: 600; wrap: word-wrap; }
            Text { text: item.status == "ready" && item.platform == "local" ? "Đã xuất trên máy" : item.status; color: Floword.muted; wrap: word-wrap; }
            if item.page-name != "": Text { text: item.page-name; color: Floword.muted; wrap: word-wrap; }
            if item.scheduled-time != "": Text { text: "Lịch dự kiến: " + item.scheduled-time; color: Floword.muted; wrap: word-wrap; }
            if item.error-message != "": Text { text: item.error-message; color: Floword.danger; wrap: word-wrap; }
            if StudioPublish.publisher-ready: FlexboxLayout {
                min-width: 0px; spacing: 8px;
                if item.status == "pending" || item.status == "ready": StudioButton { label: "Duyệt xuất bản"; enabled: !StudioPublish.busy; clicked => { StudioPublish.approve(item.id); } }
                if item.status == "scheduled" || item.status == "approved" || item.status == "ready": StudioButton { label: "Đăng ngay"; enabled: !StudioPublish.busy; clicked => { StudioPublish.post-now(item.id); } }
                if item.status == "failed": StudioButton { label: "Thử lại"; enabled: !StudioPublish.busy; clicked => { StudioPublish.retry(item.id); } }
                if item.status == "pending" || item.status == "scheduled": StudioButton { label: "Hủy lịch"; enabled: !StudioPublish.busy; clicked => { StudioPublish.reject(item.id); } }
            }
        }
    }
}
