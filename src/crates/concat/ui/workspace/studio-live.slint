// SPDX-License-Identifier: AGPL-3.0-or-later
import { I18n } from "../i18n.slint";
import { Floword } from "../theme/floword.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Select } from "../primitives/primitives.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField } from "studio-chrome.slint";
import { StudioAi } from "studio-ai.slint";
import { StudioOpenTalking } from "studio-opentalking.slint";
import { StudioProducts, StudioProductsPanel } from "studio-products.slint";

export struct StudioLiveCommentRow {
    event-id: string,
    kind: string,
    username: string,
    content: string,
    time: string,
}

export global StudioLive {
    in-out property <image> video-frame;
    in-out property <string> motion-title;
    in-out property <string> motion-status;
    in-out property <bool> motion-loading;
    in-out property <bool> motion-playing;
    callback choose-motion();
    callback use-builtin-motion();
    callback stop-motion();
    callback select-avatar-motion(int);
    in-out property <string> username;
    in-out property <string> message;
    in-out property <string> state: "stopped";
    out property <bool> session-active: state == "starting" || state == "connecting" || state == "connected" || state == "degraded" || state == "disconnected" || state == "stopping";
    in-out property <string> status;
    in-out property <string> events;
    in-out property <string> inspection-result;
    in-out property <[StudioLiveCommentRow]> comments;
    in-out property <int> active-tab: 0;
    in-out property <int> total-count: 0;
    in-out property <int> comment-count: 0;
    in-out property <int> gift-count: 0;
    in-out property <int> other-count: 0;
    in-out property <bool> busy;
    in-out property <bool> auto-reply;
    in-out property <bool> auto-product-reply;
    in-out property <bool> auto-product-rotation;
    in-out property <bool> is-speaking;
    in-out property <string> displayed-subtitle: "";
    in-out property <bool> show-products;
    in-out property <bool> show-settings;
    in-out property <string> pinned-title;
    in-out property <string> pinned-price;
    in-out property <string> pinned-script;

    callback connect(username: string);
    callback disconnect();
    callback inspect(username: string);
    callback send(message: string);
    callback toggle-auto-reply();
    callback toggle-auto-product-reply();
    callback toggle-auto-product-rotation();
    callback reply-to-comment(username: string, content: string);
    callback speak-text(text: string);
    callback interrupt-speech();
    callback next-product();
    callback speak-pinned-product();
    callback set-tab(tab: int);
    in-out property <bool> output-window-open: false;
    callback toggle-output-window();
}

component LiveCheckbox inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    min-height: 20px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.checked ? Floword.success : Floword.line;
                background: root.checked ? Floword.success.with-alpha(0.2) : Floword.field;
                if root.checked: Icon {
                    x: 2px; y: 2px; width: 12px; height: 12px;
                    glyph: Glyph.check;
                    tint: Floword.success;
                }
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Floword.text : Floword.muted;
            font-size: 11.5px;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component LiveTabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    border-radius: 6px;
    background: root.active ? Floword.raised : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Floword.line;
    min-height: 25px;
    horizontal-stretch: 1;
    caption := Text {
        text: root.text;
        color: root.active ? Floword.text : Floword.muted;
        font-size: 10.5px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component VoiceWaveBar inherits Rectangle {
    in property <bool> active;
    in property <length> target-height: 16px;
    width: 3px;
    height: root.active ? root.target-height : 4px;
    border-radius: 1.5px;
    background: root.active ? Floword.success : Floword.line;
    animate height { duration: 180ms; easing: ease-in-out; }
}

export component StudioLivePage inherits VerticalLayout {
    spacing: 12px;

    // =========================================================================
    // 1. UNIFIED BROADCAST HEADER TOOLBAR (Compact 46px)
    // =========================================================================
    Rectangle {
        background: Floword.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Floword.line-bright;
        height: 46px;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            alignment: space-between;

            // Brand title & Live Status Pill
            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 7px;
                        background: Floword.cyan.with-alpha(0.18);
                        border-width: 1px;
                        border-color: Floword.cyan.with-alpha(0.4);

                        Icon {
                            glyph: Glyph.waveform;
                            size: 14px;
                            tint: Floword.cyan;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "TIKTOK LIVE AI BROADCAST";
                        color: Floword.text;
                        font-size: 13px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { width: 4px; }

                // Live status pill (Fixed height 24px)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 24px;
                        background: StudioLive.state == "connected" ? Floword.success.with-alpha(0.2)
                            : (StudioLive.state == "connecting" || StudioLive.state == "starting") ? Floword.warning.with-alpha(0.2)
                            : Floword.field;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: StudioLive.state == "connected" ? Floword.success.with-alpha(0.5)
                            : (StudioLive.state == "connecting" || StudioLive.state == "starting") ? Floword.warning.with-alpha(0.5)
                            : Floword.line;

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: StudioLive.state == "connected" ? Floword.success
                                        : (StudioLive.state == "connecting" || StudioLive.state == "starting") ? Floword.warning
                                        : Floword.muted;
                                }
                            }

                            Text {
                                text: StudioLive.state == "connected" ? I18n.t("studioLive.connected")
                                    : (StudioLive.state == "connecting" || StudioLive.state == "starting") ? I18n.t("studioLive.connecting")
                                    : I18n.t("studioLive.stopped");
                                color: StudioLive.state == "connected" ? Floword.success : Floword.text;
                                font-size: 10.5px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Center: Service Readiness indicators
            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                // Voice status badge
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 24px;
                        background: StudioOpenTalking.voice-options.length > 0 ? Floword.field : Floword.warning.with-alpha(0.12);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: StudioOpenTalking.voice-options.length > 0 ? Floword.line : Floword.warning.with-alpha(0.3);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Icon { glyph: Glyph.volume; size: 12px; tint: StudioOpenTalking.voice-options.length > 0 ? Floword.success : Floword.warning; }
                            }
                            Text {
                                text: StudioOpenTalking.voice-options.length > 0 ? I18n.t("studioLive.voiceReady") : I18n.t("studioLive.voiceNotReady");
                                color: StudioOpenTalking.voice-options.length > 0 ? Floword.text : Floword.warning;
                                font-size: 10.5px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // AI status badge
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 24px;
                        background: StudioAi.models-loaded ? Floword.field : Floword.warning.with-alpha(0.12);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: StudioAi.models-loaded ? Floword.line : Floword.warning.with-alpha(0.3);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Icon { glyph: Glyph.sparkle; size: 12px; tint: StudioAi.models-loaded ? Floword.success : Floword.warning; }
                            }
                            Text {
                                text: StudioAi.models-loaded ? I18n.t("studioLive.aiReady") : I18n.t("studioLive.aiNotReady");
                                color: StudioAi.models-loaded ? Floword.text : Floword.warning;
                                font-size: 10.5px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Auto-reply badge
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 24px;
                        background: StudioLive.auto-reply ? Floword.success.with-alpha(0.15) : Floword.field;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: StudioLive.auto-reply ? Floword.success.with-alpha(0.4) : Floword.line;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: StudioLive.auto-reply ? Floword.success : Floword.warning;
                                }
                            }
                            Text {
                                text: StudioLive.auto-reply ? "Tự động: BẬT" : "Tự động: TẮT";
                                color: StudioLive.auto-reply ? Floword.success : Floword.warning;
                                font-size: 10.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Right: Products & Settings
            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                VerticalLayout {
                    alignment: center;
                    StudioButton {
                        compact: true;
                        label: I18n.t1("studioLive.manageProductsBtn", "" + StudioProducts.rows.length);
                        clicked => { StudioLive.show-products = !StudioLive.show-products; }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    StudioButton {
                        compact: true;
                        label: I18n.t("studioLive.advancedSettings");
                        clicked => { StudioLive.show-settings = !StudioLive.show-settings; }
                    }
                }
            }
        }
    }

    if StudioLive.inspection-result != "": Rectangle {
        background: Floword.success.with-alpha(0.12);
        border-radius: 8px;
        border-width: 1px;
        border-color: Floword.success.with-alpha(0.4);
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;
            Icon { glyph: Glyph.check; size: 14px; tint: Floword.success; }
            Text {
                text: StudioLive.inspection-result;
                color: Floword.success;
                font-size: 12px;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }

    if StudioLive.status != "": Rectangle {
        background: Floword.warning.with-alpha(0.12);
        border-radius: 8px;
        border-width: 1px;
        border-color: Floword.warning.with-alpha(0.4);
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;
            Icon { glyph: Glyph.more; size: 14px; tint: Floword.warning; }
            Text {
                text: StudioLive.status;
                color: Floword.warning;
                font-size: 12px;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }

    // =========================================================================
    // 3. OPTIONAL MODALS / DRAWERS (Products & Settings)
    // =========================================================================
    if StudioLive.show-products: VerticalLayout {
        spacing: 8px;
        StudioProductsPanel { }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            StudioButton {
                compact: true;
                label: I18n.t("studioProducts.hide");
                clicked => { StudioLive.show-products = false; }
            }
        }
    }

    if StudioLive.show-settings: StudioCard {
        StudioHeading { title: I18n.t("studioLive.settingsTitle"); glyph: Glyph.settings; font-size: 14px; }
        Text { text: I18n.t("studioLive.obsGuide"); color: Floword.muted; font-size: 11.5px; wrap: word-wrap; }
        Text { text: I18n.t("studioLive.obsSceneRule"); color: Floword.text; font-size: 12px; font-weight: 600; }
        Text { text: I18n.t("studioLive.autoReplyNote"); color: Floword.warning; font-size: 11px; wrap: word-wrap; }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            StudioButton {
                compact: true;
                label: I18n.t("common.cancel");
                clicked => { StudioLive.show-settings = false; }
            }
        }
    }

    // =========================================================================
    // 4. MAIN THREE-COLUMN WORKSPACE (Optimized for 1080p Viewport)
    // =========================================================================
    HorizontalLayout {
        spacing: 12px;
        min-width: 0px;

        // ---------------------------------------------------------------------
        // COLUMN 1: LIVE STUDIO OUTPUT & AVATAR SETTINGS (Compact 295px)
        // ---------------------------------------------------------------------
        StudioCard {
            width: 295px;
            horizontal-stretch: 0;
            padding-v: 12px;
            padding-h: 12px;
            spacing: 8px;

            StudioHeading { title: "1. KẾT NỐI TIKTOK LIVE"; glyph: Glyph.waveform; font-size: 12.5px; icon-size: 15px; }

            // TikTok Username Input
            StudioField {
                compact: true;
                label: "Kênh TikTok (@username):";
                placeholder: "@ten_kenh_tiktok";
                value: StudioLive.username;
                enabled: !StudioLive.busy && !StudioLive.session-active;
                edited(text) => { StudioLive.username = text; }
            }

            HorizontalLayout {
                spacing: 6px;
                if !StudioLive.session-active: StudioButton {
                    compact: true;
                    label: "Kiểm tra phòng";
                    enabled: !StudioLive.busy && StudioLive.username != "";
                    clicked => { StudioLive.inspect(StudioLive.username); }
                }

                if !StudioLive.session-active: StudioButton {
                    compact: true;
                    label: StudioLive.busy ? "Đang kết nối…" : "Kết nối Live";
                    primary: true;
                    enabled: !StudioLive.busy && StudioLive.username != "";
                    clicked => { StudioLive.connect(StudioLive.username); }
                }

                if StudioLive.session-active: StudioButton {
                    compact: true;
                    label: StudioLive.busy ? "Đang ngắt…" : "Ngắt kết nối";
                    enabled: !StudioLive.busy;
                    clicked => { StudioLive.disconnect(); }
                }
            }

            // Connection status feedback
            Rectangle {
                background: Floword.field;
                border-radius: 6px;
                border-width: 1px;
                border-color: StudioLive.state == "connected" ? Floword.success.with-alpha(0.4) : Floword.line;
                height: 24px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 6px; height: 6px; border-radius: 3px;
                            background: StudioLive.state == "connected" ? Floword.success : Floword.warning;
                        }
                    }
                    Text {
                        text: StudioLive.state == "connected" ? "Đã kết nối phòng Live"
                            : StudioLive.state == "connecting" ? "Đang dò tìm luồng phát..."
                            : "Chưa kết nối · Nhập @username";
                        color: StudioLive.state == "connected" ? Floword.success : Floword.muted;
                        font-size: 10.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { height: 1px; background: Floword.line; }

            StudioHeading { title: "2. CHỌN NHÂN VẬT & CHUYỂN ĐỘNG LIVE"; glyph: Glyph.film; font-size: 12.5px; icon-size: 15px; }

            // Avatar selection with motion video directly embedded
            VerticalLayout {
                spacing: 4px;
                Text { text: I18n.t("studioOpenTalking.avatar"); color: Floword.text; font-size: 11.5px; font-weight: 600; }
                Select {
                    options: StudioOpenTalking.avatar-options;
                    current <=> StudioOpenTalking.avatar-index;
                    placeholder: I18n.t("studioOpenTalking.chooseAvatar");
                    height: 32px;
                    background: Floword.field;
                    border-color: Floword.line;
                    enabled: !StudioOpenTalking.busy;
                    changed(index) => {
                        StudioLive.select-avatar-motion(index);
                        StudioOpenTalking.select-avatar(index);
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    StudioButton {
                        compact: true;
                        label: "+ Thêm video / clip từ máy";
                        enabled: !StudioLive.motion-loading;
                        clicked => { StudioLive.choose-motion(); }
                    }
                    StudioButton {
                        compact: true;
                        label: StudioLive.motion-playing ? "Dừng video" : "Phát lại video";
                        enabled: !StudioLive.motion-loading;
                        clicked => {
                            if StudioLive.motion-playing {
                                StudioLive.stop-motion();
                            } else {
                                StudioLive.select-avatar-motion(StudioOpenTalking.avatar-index);
                            }
                        }
                    }
                }
                Text {
                    text: StudioLive.motion-title != ""
                        ? "🎬 Đang chạy video nhân vật: " + StudioLive.motion-title
                        : "Chọn nhân vật ở trên để tự động chạy video chuyển động chờ.";
                    color: StudioLive.motion-playing ? Floword.success : Floword.muted;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Clip chạy lặp, tắt tiếng gốc. Mắt, mặt và tay chân dùng chuyển động trong clip; chưa khớp môi theo câu AI mới.";
                    color: Floword.warning; wrap: word-wrap; font-size: 10px;
                }
            }

            // Voice selection
            VerticalLayout {
                spacing: 3px;
                Text { text: I18n.t("studioOpenTalking.voice"); color: Floword.text; font-size: 11.5px; font-weight: 600; }
                Select {
                    options: StudioOpenTalking.voice-options;
                    current <=> StudioOpenTalking.voice-index;
                    placeholder: I18n.t("studioOpenTalking.chooseVoice");
                    height: 32px;
                    background: Floword.field;
                    border-color: Floword.line;
                    enabled: !StudioOpenTalking.busy;
                }
            }

            // Model selection
            VerticalLayout {
                spacing: 3px;
                Text { text: I18n.t("studioAi.defaultModel"); color: Floword.text; font-size: 11.5px; font-weight: 600; }
                Select {
                    options: StudioAi.models;
                    current <=> StudioAi.model-index;
                    placeholder: I18n.t("studioAi.defaultModel");
                    height: 32px;
                    background: Floword.field;
                    border-color: Floword.line;
                    enabled: !StudioAi.busy && StudioAi.models-loaded;
                }
            }

            // Actions
            HorizontalLayout {
                spacing: 6px;
                StudioButton {
                    compact: true;
                    label: I18n.t("studioLive.testSpeech");
                    enabled: !StudioLive.busy && !StudioLive.is-speaking;
                    clicked => { StudioLive.speak-text(I18n.t("studioLive.testSpeechSample")); }
                }
                StudioButton {
                    compact: true;
                    label: StudioOpenTalking.busy ? I18n.t("studioOpenTalking.working") : I18n.t("studioOpenTalking.refresh");
                    enabled: !StudioOpenTalking.busy;
                    clicked => { StudioOpenTalking.refresh(); StudioAi.load-models(); }
                }
            }

            Rectangle { height: 1px; background: Floword.line; }

            // 3. LIVE OUTPUT WINDOW FOR TIKTOK LIVE STUDIO
            VerticalLayout {
                spacing: 6px;
                StudioHeading { title: "3. CỬA SỔ PHÁT TIKTOK LIVE"; glyph: Glyph.sparkle; font-size: 12.5px; icon-size: 15px; }
                Text {
                    text: "Mở cửa sổ phát chuyên dụng tỉ lệ 9:16 để TikTok LIVE Studio bắt hình sạch (không dính giao diện).";
                    color: Floword.muted;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
                StudioButton {
                    primary: !StudioLive.output-window-open;
                    label: StudioLive.output-window-open ? "Đóng Cửa Sổ Đầu Ra (Đang mở)" : "Mở Cửa Sổ Đầu Ra (TikTok LIVE)";
                    clicked => { StudioLive.toggle-output-window(); }
                }
                Text {
                    text: StudioLive.output-window-open
                        ? "Đang mở 'Concat LIVE Output'. Trong TikTok LIVE Studio: Thêm nguồn -> Quay màn hình cửa sổ -> Chọn 'Concat LIVE Output'."
                        : "Trong TikTok LIVE Studio: Thêm nguồn -> Quay màn hình cửa sổ -> Chọn 'Concat LIVE Output' sau khi mở.";
                    color: StudioLive.output-window-open ? Floword.success : Floword.muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }

        // ---------------------------------------------------------------------
        // COLUMN 2: LIVE AVATAR PREVIEW & SUBTITLES & PINNED PRODUCT
        // ---------------------------------------------------------------------
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 320px;
            spacing: 10px;

            // Virtual Host Video Screen (Compact 290px)
            Rectangle {
                background: Floword.surface;
                border-radius: 14px;
                border-width: 1px;
                border-color: Floword.line-bright;
                height: 290px;
                clip: true;

                // Virtual Host Avatar Display (Dynamic preview or default avatar)
                if StudioLive.video-frame.width > 0: Image {
                    width: 100%; height: 100%;
                    source: StudioLive.video-frame;
                    image-fit: contain;
                }
                if StudioLive.video-frame.width <= 0 && StudioOpenTalking.avatar-preview.width > 0: Image {
                    width: 100%;
                    height: 100%;
                    source: StudioOpenTalking.avatar-preview;
                    image-fit: contain;
                }
                if StudioLive.video-frame.width <= 0 && StudioOpenTalking.avatar-preview.width <= 0: Image {
                    width: 100%;
                    height: 100%;
                    source: @image-url("../../assets/avatars/mc-newscaster.png");
                    image-fit: cover;
                }

                // Dark atmospheric gradient overlay for readability
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: @linear-gradient(180deg, #080D1BDD 0%, #080D1B22 35%, #080D1B22 65%, #080D1BEE 100%);
                }

                VerticalLayout {
                    alignment: space-between;
                    padding: 10px;

                    // Top preview bar
                    HorizontalLayout {
                        alignment: space-between;

                        // Speaking / Status Pill
                        Rectangle {
                            background: #000000cc;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #ffffff20;
                            height: 24px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: StudioLive.state == "connected" ? Floword.success : Floword.warning;
                                    }
                                }
                                Text {
                                    text: StudioLive.state == "connected" ? "LIVE PHÁT SÓNG" : "CHƯA KẾT NỐI PHIÊN LIVE";
                                    color: #ffffff;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Host info badge
                        Rectangle {
                            background: #000000cc;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #ffffff20;
                            height: 24px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                alignment: center;
                                Icon { glyph: Glyph.sparkle; size: 11px; tint: Floword.cyan; }
                                Text {
                                    text: StudioLive.motion-playing ? StudioLive.motion-title : StudioOpenTalking.avatar-options.length > 0 && StudioOpenTalking.avatar-index < StudioOpenTalking.avatar-options.length
                                        ? StudioOpenTalking.avatar-options[StudioOpenTalking.avatar-index]
                                        : "Chưa chọn nhân vật";
                                    color: #ffffff;
                                    font-size: 10px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // Output window button
                        StudioButton {
                            compact: true;
                            primary: !StudioLive.output-window-open;
                            label: StudioLive.output-window-open ? "LIVE Window: BẬT" : "Mở Cửa Sổ LIVE";
                            clicked => { StudioLive.toggle-output-window(); }
                        }
                    }

                    // Bottom audio waveform & subtitle overlay
                    VerticalLayout {
                        spacing: 6px;

                        // Audio Waveform & Interrupt
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;

                            // Sound waves
                            HorizontalLayout {
                                spacing: 3px;
                                alignment: center;
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 6px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 14px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 20px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 10px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 22px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 16px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 8px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 20px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 12px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 18px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 24px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 10px; }
                            }

                            if StudioLive.is-speaking: StudioButton {
                                compact: true;
                                label: I18n.t("studioLive.interrupt");
                                clicked => { StudioLive.interrupt-speech(); }
                            }
                        }

                        // Subtitle card
                        Rectangle {
                            background: #000000dd;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: #ffffff18;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                Icon { glyph: Glyph.volume; size: 14px; tint: Floword.cyan; }
                                Text {
                                    text: StudioLive.displayed-subtitle;
                                    color: #f1f5f9;
                                    font-size: 11px;
                                    font-weight: 500;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Pinned Product Card (Compact 74px)
            Rectangle {
                background: Floword.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Floword.line;
                height: 74px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                background: Floword.success.with-alpha(0.18);
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Floword.success.with-alpha(0.3);
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    padding-top: 1px;
                                    padding-bottom: 1px;
                                    Text {
                                        text: I18n.t("studioLive.pinnedBadge");
                                        color: Floword.success;
                                        font-size: 9.5px;
                                        font-weight: 700;
                                    }
                                }
                            }
                            Text {
                                text: StudioLive.pinned-price != "" ? StudioLive.pinned-price
                                    : (StudioProducts.active-price != "" ? StudioProducts.active-price : "-- đ");
                                color: Floword.success;
                                font-size: 11.5px;
                                font-weight: 700;
                            }
                        }

                        Text {
                            text: StudioLive.pinned-title != "" ? StudioLive.pinned-title
                                : (StudioProducts.active-title != "" ? StudioProducts.active-title : I18n.t("studioLive.noProduct"));
                            color: Floword.text;
                            font-size: 12.5px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            text: StudioLive.pinned-script != "" ? StudioLive.pinned-script
                                : (StudioProducts.active-title != "" ? StudioProducts.active-title : I18n.t("studioLive.noProductScript"));
                            color: Floword.muted;
                            font-size: 10.5px;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        spacing: 5px;
                        alignment: center;

                        StudioButton {
                            compact: true;
                            label: I18n.t("studioLive.nextProduct");
                            clicked => { StudioLive.next-product(); }
                        }

                        StudioButton {
                            compact: true;
                            label: I18n.t("studioLive.speakScript");
                            primary: true;
                            enabled: !StudioLive.busy && !StudioLive.is-speaking;
                            clicked => { StudioLive.speak-pinned-product(); }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // COLUMN 3: REAL-TIME COMMENTS & AI AUTO-REPLY (Width 375px)
        // ---------------------------------------------------------------------
        StudioCard {
            width: 375px;
            horizontal-stretch: 0;
            padding-v: 12px;
            padding-h: 12px;
            spacing: 8px;

            // Header & Auto-Reply Switch
            HorizontalLayout {
                alignment: space-between;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Icon { glyph: Glyph.more; size: 15px; tint: Floword.violet; }
                    Text {
                        text: I18n.t("studioLive.commentsTitle");
                        color: Floword.text;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                StudioButton {
                    compact: true;
                    label: StudioLive.auto-reply ? I18n.t("studioLive.autoOn") : I18n.t("studioLive.autoOff");
                    primary: StudioLive.auto-reply;
                    clicked => { StudioLive.toggle-auto-reply(); }
                }
            }

            Rectangle { height: 1px; background: Floword.line; }

            // Checkbox options
            VerticalLayout {
                spacing: 4px;
                LiveCheckbox {
                    text: I18n.t("studioLive.autoProductReply");
                    checked: StudioLive.auto-product-reply;
                    toggled => { StudioLive.toggle-auto-product-reply(); }
                }
                LiveCheckbox {
                    text: I18n.t("studioLive.autoProductRotation");
                    checked: StudioLive.auto-product-rotation;
                    toggled => { StudioLive.toggle-auto-product-rotation(); }
                }
            }

            Rectangle { height: 1px; background: Floword.line; }

            // Filter Tabs
            HorizontalLayout {
                spacing: 3px;
                LiveTabButton {
                    text: I18n.t1("studioLive.tabAll", "" + StudioLive.comments.length);
                    active: StudioLive.active-tab == 0;
                    clicked => { StudioLive.active-tab = 0; }
                }
                LiveTabButton {
                    text: I18n.t("studioLive.tabComments");
                    active: StudioLive.active-tab == 1;
                    clicked => { StudioLive.active-tab = 1; }
                }
                LiveTabButton {
                    text: I18n.t("studioLive.tabGifts");
                    active: StudioLive.active-tab == 2;
                    clicked => { StudioLive.active-tab = 2; }
                }
                LiveTabButton {
                    text: I18n.t("studioLive.tabOther");
                    active: StudioLive.active-tab == 3;
                    clicked => { StudioLive.active-tab = 3; }
                }
            }

            // Real-time Event Feed List
            VerticalLayout {
                spacing: 6px;
                min-height: 140px;
                vertical-stretch: 1;

                if StudioLive.comments.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: I18n.t("studioLive.waitingEvents");
                        color: Floword.muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: I18n.t("studioLive.waitingHint");
                        color: Floword.muted;
                        font-size: 10px;
                        horizontal-alignment: center;
                    }
                }

                for comment in StudioLive.comments: Rectangle {
                    background: comment.kind == "gift" ? Floword.warning.with-alpha(0.08)
                        : (comment.kind == "like" || comment.kind == "follow") ? Floword.success.with-alpha(0.08)
                        : comment.kind == "ai" ? Floword.violet.with-alpha(0.12)
                        : Floword.field;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: comment.kind == "gift" ? Floword.warning.with-alpha(0.3)
                        : (comment.kind == "like" || comment.kind == "follow") ? Floword.success.with-alpha(0.3)
                        : comment.kind == "ai" ? Floword.violet.with-alpha(0.4)
                        : Floword.line;

                    HorizontalLayout {
                        padding: 6px;
                        spacing: 6px;
                        alignment: space-between;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            HorizontalLayout {
                                spacing: 5px;
                                Text {
                                    text: comment.username;
                                    color: comment.kind == "gift" ? Floword.warning
                                        : comment.kind == "ai" ? Floword.violet
                                        : Floword.success;
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                                if comment.time != "": Text {
                                    text: comment.time;
                                    color: Floword.muted;
                                    font-size: 9.5px;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: comment.content;
                                color: Floword.text;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        if comment.kind != "gift" && comment.kind != "like" && comment.kind != "follow" && comment.kind != "ai": StudioButton {
                            compact: true;
                            label: I18n.t("studioLive.askAi");
                            enabled: StudioLive.state == "connected" && !StudioLive.busy && !StudioLive.is-speaking;
                            clicked => { StudioLive.reply-to-comment(comment.username, comment.content); }
                        }
                    }
                }
            }

            // Bottom Chat Input & Speak
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                Rectangle {
                    background: Floword.field;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: chat-in.has-focus ? Floword.violet : Floword.line;
                    min-height: 30px;
                    max-height: 30px;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Rectangle {
                            horizontal-stretch: 1;
                            chat-in := TextInput {
                                width: 100%;
                                height: 100%;
                                text: StudioLive.message;
                                enabled: !StudioLive.busy;
                                color: Floword.text;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                edited => { StudioLive.message = self.text; }
                            }
                            if StudioLive.message == "" && !chat-in.has-focus: Text {
                                width: 100%;
                                text: I18n.t("studioLive.messageHint");
                                color: Floword.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                StudioButton {
                    compact: true;
                    label: I18n.t("studioLive.speakBtn");
                    enabled: !StudioLive.busy && !StudioLive.is-speaking && StudioLive.message != "";
                    clicked => { StudioLive.speak-text(StudioLive.message); }
                }
                StudioButton {
                    compact: true;
                    label: I18n.t("studioLive.sendBtn");
                    primary: true;
                    enabled: !StudioLive.busy && StudioLive.state == "connected" && StudioLive.message != "";
                    clicked => { StudioLive.send(StudioLive.message); }
                }
            }
        }
    }
}
