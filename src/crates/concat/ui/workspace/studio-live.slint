// SPDX-License-Identifier: AGPL-3.0-or-later
import { I18n } from "../i18n.slint";
import { Floword } from "../theme/floword.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Select } from "../primitives/primitives.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField } from "studio-chrome.slint";
import { StudioAi } from "studio-ai.slint";
import { StudioOpenTalking } from "studio-opentalking.slint";
import { StudioProducts, StudioProductsPanel } from "studio-products.slint";

export struct StudioLiveCommentRow {
    event-id: string,
    kind: string,
    username: string,
    content: string,
    time: string,
}

export global StudioLive {
    in-out property <string> username;
    in-out property <string> message;
    in-out property <string> state: "stopped";
    in-out property <string> status;
    in-out property <string> events;
    in-out property <string> inspection-result;
    in-out property <[StudioLiveCommentRow]> comments;
    in-out property <int> active-tab: 0;
    in-out property <int> total-count: 0;
    in-out property <int> comment-count: 0;
    in-out property <int> gift-count: 0;
    in-out property <int> other-count: 0;
    in-out property <bool> busy;
    in-out property <bool> auto-reply;
    in-out property <bool> auto-product-reply;
    in-out property <bool> auto-product-rotation;
    in-out property <bool> is-speaking;
    in-out property <string> displayed-subtitle: "Chào mừng bạn đến với phiên Live! Hãy nhập bình luận hoặc chọn sản phẩm để AI bắt đầu giới thiệu.";
    in-out property <bool> show-products;
    in-out property <bool> show-settings;
    in-out property <string> pinned-title;
    in-out property <string> pinned-price;
    in-out property <string> pinned-script;

    callback connect(username: string);
    callback disconnect();
    callback inspect(username: string);
    callback send(message: string);
    callback toggle-auto-reply();
    callback toggle-auto-product-reply();
    callback toggle-auto-product-rotation();
    callback reply-to-comment(username: string, content: string);
    callback speak-text(text: string);
    callback interrupt-speech();
    callback next-product();
    callback speak-pinned-product();
    callback set-tab(tab: int);
}

component LiveCheckbox inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    min-height: 22px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.checked ? Floword.success : Floword.line;
            background: root.checked ? Floword.success.with-alpha(0.2) : Floword.field;
            y: (parent.height - self.height) / 2;
            if root.checked: Icon {
                x: 2px; y: 2px; width: 14px; height: 14px;
                glyph: Glyph.check;
                tint: Floword.success;
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Floword.text : Floword.muted;
            font-size: 12px;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component LiveTabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    border-radius: 7px;
    background: root.active ? Floword.raised : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Floword.line;
    min-height: 28px;
    horizontal-stretch: 1;
    caption := Text {
        text: root.text;
        color: root.active ? Floword.text : Floword.muted;
        font-size: 11px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component VoiceWaveBar inherits Rectangle {
    in property <bool> active;
    in property <length> target-height: 16px;
    width: 3px;
    height: root.active ? root.target-height : 4px;
    border-radius: 1.5px;
    background: root.active ? Floword.success : Floword.line;
    animate height { duration: 180ms; easing: ease-in-out; }
}

export component StudioLivePage inherits VerticalLayout {
    spacing: 16px;

    // =========================================================================
    // 1. TOP HEADER TOOLBAR
    // =========================================================================
    Rectangle {
        background: Floword.surface;
        border-radius: 16px;
        border-width: 1px;
        border-color: Floword.line;

        HorizontalLayout {
            padding: 14px;
            spacing: 12px;

            // Left: Username input & Inspect & Connect
            HorizontalLayout {
                spacing: 10px;
                horizontal-stretch: 1;
                alignment: start;

                user-box := Rectangle {
                    background: Floword.field;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: user-in.has-focus ? Floword.violet : Floword.line;
                    min-height: 40px;
                    max-height: 40px;
                    min-width: 250px;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "@";
                            color: Floword.accent;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            user-in := TextInput {
                                width: 100%;
                                height: 100%;
                                text: StudioLive.username;
                                enabled: !StudioLive.busy && StudioLive.state != "connected";
                                color: Floword.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                edited => { StudioLive.username = self.text; }
                            }
                            if StudioLive.username == "" && !user-in.has-focus: Text {
                                width: 100%;
                                text: I18n.t("studioLive.usernamePlaceholder");
                                color: Floword.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if StudioLive.state != "connected" && StudioLive.state != "connecting" && StudioLive.state != "stopping": StudioButton {
                    label: I18n.t("studioLive.inspect");
                    enabled: !StudioLive.busy && StudioLive.username != "";
                    clicked => { StudioLive.inspect(StudioLive.username); }
                }

                if StudioLive.state != "connected" && StudioLive.state != "connecting" && StudioLive.state != "stopping": StudioButton {
                    label: StudioLive.busy ? I18n.t("studioLive.working") : I18n.t("studioLive.connect");
                    primary: true;
                    enabled: !StudioLive.busy && StudioLive.username != "";
                    clicked => { StudioLive.connect(StudioLive.username); }
                }

                if StudioLive.state == "connected" || StudioLive.state == "connecting" || StudioLive.state == "stopping": StudioButton {
                    label: StudioLive.busy ? I18n.t("studioLive.working") : I18n.t("studioLive.disconnect");
                    enabled: !StudioLive.busy;
                    clicked => { StudioLive.disconnect(); }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Right: Status Badge & Modals toggles
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // Status Badge Pill
                Rectangle {
                    background: Floword.field;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Floword.line;
                    min-height: 40px;
                    max-height: 40px;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            background: StudioLive.state == "connected" ? Floword.success
                                : (StudioLive.state == "connecting" || StudioLive.state == "starting") ? Floword.warning
                                : Floword.muted;
                        }

                        Text {
                            text: StudioLive.state == "connected" ? I18n.t("studioLive.connected")
                                : (StudioLive.state == "connecting" || StudioLive.state == "starting") ? I18n.t("studioLive.connecting")
                                : I18n.t("studioLive.stopped");
                            color: Floword.text;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                // Products Manager button
                StudioButton {
                    label: I18n.t1("studioLive.manageProductsBtn", "" + StudioProducts.rows.length);
                    clicked => { StudioLive.show-products = !StudioLive.show-products; }
                }

                // Advanced Settings button
                StudioButton {
                    label: I18n.t("studioLive.advancedSettings");
                    clicked => { StudioLive.show-settings = !StudioLive.show-settings; }
                }
            }
        }
    }

    // =========================================================================
    // 2. STATUS & INSPECTION NOTICES
    // =========================================================================
    Rectangle {
        background: Floword.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Floword.line;
        min-height: 42px;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 18px;
                alignment: start;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    Icon {
                        glyph: Glyph.volume;
                        size: 14px;
                        tint: StudioOpenTalking.voice-options.length > 0 ? Floword.success : Floword.warning;
                    }
                    Text {
                        text: StudioOpenTalking.voice-options.length > 0 ? I18n.t("studioLive.voiceReady") : I18n.t("studioLive.voiceNotReady");
                        color: StudioOpenTalking.voice-options.length > 0 ? Floword.text : Floword.warning;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    Icon {
                        glyph: Glyph.sparkle;
                        size: 14px;
                        tint: StudioAi.models-loaded ? Floword.success : Floword.warning;
                    }
                    Text {
                        text: StudioAi.models-loaded ? I18n.t("studioLive.aiReady") : I18n.t("studioLive.aiNotReady");
                        color: StudioAi.models-loaded ? Floword.text : Floword.warning;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: StudioLive.auto-reply ? Floword.success : Floword.warning;
                }

                Text {
                    text: StudioLive.auto-reply ? I18n.t("studioLive.autoReplyNoticeOn") : I18n.t("studioLive.autoReplyNoticeOff");
                    color: StudioLive.auto-reply ? Floword.success : Floword.warning;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }

    if StudioLive.inspection-result != "": Rectangle {
        background: Floword.success.with-alpha(0.12);
        border-radius: 10px;
        border-width: 1px;
        border-color: Floword.success.with-alpha(0.4);
        HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            Icon { glyph: Glyph.check; size: 16px; tint: Floword.success; }
            Text {
                text: StudioLive.inspection-result;
                color: Floword.success;
                font-size: 13px;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }

    if StudioLive.status != "": Rectangle {
        background: Floword.warning.with-alpha(0.12);
        border-radius: 10px;
        border-width: 1px;
        border-color: Floword.warning.with-alpha(0.4);
        HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            Icon { glyph: Glyph.more; size: 16px; tint: Floword.warning; }
            Text {
                text: StudioLive.status;
                color: Floword.warning;
                font-size: 13px;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }


    // =========================================================================
    // 3. OPTIONAL MODALS / DRAWERS (Products & Settings)
    // =========================================================================
    if StudioLive.show-products: VerticalLayout {
        spacing: 8px;
        StudioProductsPanel { }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            StudioButton {
                label: I18n.t("studioProducts.hide");
                clicked => { StudioLive.show-products = false; }
            }
        }
    }

    if StudioLive.show-settings: StudioCard {
        StudioHeading { title: I18n.t("studioLive.settingsTitle"); glyph: Glyph.settings; }
        Text { text: I18n.t("studioLive.obsGuide"); color: Floword.muted; wrap: word-wrap; }
        Text { text: I18n.t("studioLive.obsSceneRule"); color: Floword.text; font-weight: 600; }
        Text { text: I18n.t("studioLive.autoReplyNote"); color: Floword.warning; wrap: word-wrap; }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            StudioButton {
                label: I18n.t("common.cancel");
                clicked => { StudioLive.show-settings = false; }
            }
        }
    }

    // =========================================================================
    // 4. MAIN THREE-COLUMN WORKSPACE (Matching ArtCraft / Image 2)
    // =========================================================================
    HorizontalLayout {
        spacing: 16px;
        min-width: 0px;

        // ---------------------------------------------------------------------
        // COLUMN 1: LIVE STUDIO OUTPUT & AVATAR SETTINGS
        // ---------------------------------------------------------------------
        StudioCard {
            width: 300px;
            horizontal-stretch: 0;
            spacing: 12px;

            StudioHeading { title: I18n.t("studioLive.outputTitle"); glyph: Glyph.film; }

            // Mode section
            VerticalLayout {
                spacing: 4px;
                Text { text: I18n.t("studioLive.charMode"); color: Floword.text; font-size: 13px; font-weight: 600; }
                Rectangle {
                    background: Floword.field;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Floword.line;
                    HorizontalLayout {
                        padding: 8px;
                        Text { text: I18n.t("studioLive.modeMotion"); color: Floword.text; font-size: 13px; }
                    }
                }
                Text { text: I18n.t("studioLive.modeNote"); color: Floword.muted; font-size: 11px; wrap: word-wrap; }
            }

            Rectangle { height: 1px; background: Floword.line; }

            // Avatar selection
            VerticalLayout {
                spacing: 6px;
                Text { text: I18n.t("studioOpenTalking.avatar"); color: Floword.text; font-size: 13px; }
                Select {
                    options: StudioOpenTalking.avatar-options;
                    current <=> StudioOpenTalking.avatar-index;
                    placeholder: I18n.t("studioOpenTalking.chooseAvatar");
                    height: 38px;
                    background: Floword.field;
                    border-color: Floword.line;
                    enabled: !StudioOpenTalking.busy;
                }
            }

            // Voice selection
            VerticalLayout {
                spacing: 6px;
                Text { text: I18n.t("studioOpenTalking.voice"); color: Floword.text; font-size: 13px; }
                Select {
                    options: StudioOpenTalking.voice-options;
                    current <=> StudioOpenTalking.voice-index;
                    placeholder: I18n.t("studioOpenTalking.chooseVoice");
                    height: 38px;
                    background: Floword.field;
                    border-color: Floword.line;
                    enabled: !StudioOpenTalking.busy;
                }
            }

            // Model selection
            VerticalLayout {
                spacing: 6px;
                Text { text: I18n.t("studioAi.defaultModel"); color: Floword.text; font-size: 13px; }
                Select {
                    options: StudioAi.models;
                    current <=> StudioAi.model-index;
                    placeholder: I18n.t("studioAi.defaultModel");
                    height: 38px;
                    background: Floword.field;
                    border-color: Floword.line;
                    enabled: !StudioAi.busy && StudioAi.models-loaded;
                }
            }

            Text { text: I18n.t("studioLive.outputGuide"); color: Floword.muted; font-size: 11px; wrap: word-wrap; }

            // Actions
            HorizontalLayout {
                spacing: 8px;
                StudioButton {
                    label: I18n.t("studioLive.testSpeech");
                    enabled: !StudioLive.busy && !StudioLive.is-speaking;
                    clicked => { StudioLive.speak-text(I18n.t("studioLive.testSpeechSample")); }
                }
                StudioButton {
                    label: StudioOpenTalking.busy ? I18n.t("studioOpenTalking.working") : I18n.t("studioOpenTalking.refresh");
                    enabled: !StudioOpenTalking.busy;
                    clicked => { StudioOpenTalking.refresh(); StudioAi.load-models(); }
                }
            }
        }

        // ---------------------------------------------------------------------
        // COLUMN 2: LIVE AVATAR PREVIEW & SUBTITLES & PINNED PRODUCT
        // ---------------------------------------------------------------------
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 340px;
            spacing: 14px;

            // Virtual Host Video Screen
            Rectangle {
                background: #0f1420;
                border-radius: 16px;
                border-width: 1px;
                border-color: Floword.line;
                min-height: 310px;
                clip: true;

                VerticalLayout {
                    alignment: space-between;
                    padding: 14px;

                    // Top preview bar
                    HorizontalLayout {
                        alignment: space-between;

                        // Speaking / Status Pill
                        Rectangle {
                            background: #000000a0;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: #ffffff20;
                            height: 28px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: StudioLive.is-speaking ? Floword.success : Floword.warning;
                                }
                                Text {
                                    text: StudioLive.is-speaking ? I18n.t("studioLive.previewBadgeSpeaking") : I18n.t("studioLive.previewBadgeIdle");
                                    color: #ffffff;
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                            }
                        }

                        // Host info badge
                        Rectangle {
                            background: #000000a0;
                            border-radius: 14px;
                            border-width: 1px;
                            border-color: #ffffff20;
                            height: 28px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;
                                Icon { glyph: Glyph.sparkle; size: 13px; tint: Floword.success; }
                                Text {
                                    text: I18n.t("studioLive.aiHost");
                                    color: #ffffff;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }

                    // Center Canvas area
                    Rectangle {
                        min-height: 160px;
                        Text {
                            text: StudioOpenTalking.avatar-options.length > 0
                                ? (StudioOpenTalking.avatar-options[StudioOpenTalking.avatar-index] != ""
                                    ? StudioOpenTalking.avatar-options[StudioOpenTalking.avatar-index]
                                    : I18n.t("studioLive.noAvatar"))
                                : I18n.t("studioLive.noAvatar");
                            color: Floword.muted;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Bottom audio waveform & subtitle overlay
                    VerticalLayout {
                        spacing: 8px;

                        // Audio Waveform & Interrupt
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;

                            // Sound waves
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 8px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 16px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 22px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 12px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 26px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 18px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 10px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 24px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 14px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 20px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 28px; }
                                VoiceWaveBar { active: StudioLive.is-speaking; target-height: 12px; }
                            }

                            if StudioLive.is-speaking: StudioButton {
                                label: I18n.t("studioLive.interrupt");
                                clicked => { StudioLive.interrupt-speech(); }
                            }
                        }

                        // Subtitle card
                        Rectangle {
                            background: #000000c0;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #ffffff18;

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                Icon { glyph: Glyph.volume; size: 16px; tint: Floword.success; }
                                Text {
                                    text: StudioLive.displayed-subtitle;
                                    color: #f1f5f9;
                                    font-size: 12px;
                                    font-weight: 500;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Pinned Product Card (Inspired by ArtCraft)
            Rectangle {
                background: Floword.surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Floword.line;

                HorizontalLayout {
                    padding: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                background: Floword.success.with-alpha(0.18);
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Floword.success.with-alpha(0.3);
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    Text {
                                        text: I18n.t("studioLive.pinnedBadge");
                                        color: Floword.success;
                                        font-size: 10px;
                                        font-weight: 700;
                                    }
                                }
                            }
                            Text {
                                text: StudioLive.pinned-price != "" ? StudioLive.pinned-price
                                    : (StudioProducts.active-price != "" ? StudioProducts.active-price : "-- đ");
                                color: Floword.success;
                                font-size: 12px;
                                font-weight: 700;
                            }
                        }

                        Text {
                            text: StudioLive.pinned-title != "" ? StudioLive.pinned-title
                                : (StudioProducts.active-title != "" ? StudioProducts.active-title : I18n.t("studioLive.noProduct"));
                            color: Floword.text;
                            font-size: 14px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }

                        Text {
                            text: StudioLive.pinned-script != "" ? StudioLive.pinned-script
                                : (StudioProducts.active-title != "" ? StudioProducts.active-title : I18n.t("studioLive.noProductScript"));
                            color: Floword.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        alignment: center;

                        StudioButton {
                            label: I18n.t("studioLive.nextProduct");
                            clicked => { StudioLive.next-product(); }
                        }

                        StudioButton {
                            label: I18n.t("studioLive.speakScript");
                            primary: true;
                            enabled: !StudioLive.busy && !StudioLive.is-speaking;
                            clicked => { StudioLive.speak-pinned-product(); }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // COLUMN 3: REAL-TIME COMMENTS & AI AUTO-REPLY
        // ---------------------------------------------------------------------
        StudioCard {
            width: 350px;
            horizontal-stretch: 0;
            min-height: 580px;
            spacing: 12px;

            // Header & Auto-Reply Switch
            HorizontalLayout {
                alignment: space-between;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Icon { glyph: Glyph.more; size: 18px; tint: Floword.violet; }
                    Text {
                        text: I18n.t("studioLive.commentsTitle");
                        color: Floword.text;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                StudioButton {
                    label: StudioLive.auto-reply ? I18n.t("studioLive.autoOn") : I18n.t("studioLive.autoOff");
                    primary: StudioLive.auto-reply;
                    clicked => { StudioLive.toggle-auto-reply(); }
                }
            }

            Rectangle { height: 1px; background: Floword.line; }

            // Checkbox options
            VerticalLayout {
                spacing: 6px;
                LiveCheckbox {
                    text: I18n.t("studioLive.autoProductReply");
                    checked: StudioLive.auto-product-reply;
                    toggled => { StudioLive.toggle-auto-product-reply(); }
                }
                Text {
                    text: I18n.t("studioLive.autoProductReplyNote");
                    color: Floword.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                LiveCheckbox {
                    text: I18n.t("studioLive.autoProductRotation");
                    checked: StudioLive.auto-product-rotation;
                    toggled => { StudioLive.toggle-auto-product-rotation(); }
                }
            }

            Rectangle { height: 1px; background: Floword.line; }

            // Filter Tabs
            HorizontalLayout {
                spacing: 4px;
                LiveTabButton {
                    text: I18n.t1("studioLive.tabAll", "" + StudioLive.comments.length);
                    active: StudioLive.active-tab == 0;
                    clicked => { StudioLive.active-tab = 0; }
                }
                LiveTabButton {
                    text: I18n.t("studioLive.tabComments");
                    active: StudioLive.active-tab == 1;
                    clicked => { StudioLive.active-tab = 1; }
                }
                LiveTabButton {
                    text: I18n.t("studioLive.tabGifts");
                    active: StudioLive.active-tab == 2;
                    clicked => { StudioLive.active-tab = 2; }
                }
                LiveTabButton {
                    text: I18n.t("studioLive.tabOther");
                    active: StudioLive.active-tab == 3;
                    clicked => { StudioLive.active-tab = 3; }
                }
            }

            // Real-time Event Feed List
            VerticalLayout {
                spacing: 8px;
                min-height: 220px;
                vertical-stretch: 1;

                if StudioLive.comments.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: I18n.t("studioLive.waitingEvents");
                        color: Floword.muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: I18n.t("studioLive.waitingHint");
                        color: Floword.muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }

                for comment in StudioLive.comments: Rectangle {
                    background: comment.kind == "gift" ? Floword.warning.with-alpha(0.08)
                        : (comment.kind == "like" || comment.kind == "follow") ? Floword.success.with-alpha(0.08)
                        : comment.kind == "ai" ? Floword.violet.with-alpha(0.12)
                        : Floword.field;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: comment.kind == "gift" ? Floword.warning.with-alpha(0.3)
                        : (comment.kind == "like" || comment.kind == "follow") ? Floword.success.with-alpha(0.3)
                        : comment.kind == "ai" ? Floword.violet.with-alpha(0.4)
                        : Floword.line;

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        alignment: space-between;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: comment.username;
                                    color: comment.kind == "gift" ? Floword.warning
                                        : comment.kind == "ai" ? Floword.violet
                                        : Floword.success;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                                if comment.time != "": Text {
                                    text: comment.time;
                                    color: Floword.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: comment.content;
                                color: Floword.text;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }

                        if comment.kind != "gift" && comment.kind != "like" && comment.kind != "follow" && comment.kind != "ai": StudioButton {
                            label: I18n.t("studioLive.askAi");
                            enabled: StudioLive.state == "connected" && !StudioLive.busy && !StudioLive.is-speaking;
                            clicked => { StudioLive.reply-to-comment(comment.username, comment.content); }
                        }
                    }
                }
            }

            // Bottom Chat Input & Speak
            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Rectangle {
                    background: Floword.field;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: chat-in.has-focus ? Floword.violet : Floword.line;
                    min-height: 38px;
                    max-height: 38px;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        Rectangle {
                            horizontal-stretch: 1;
                            chat-in := TextInput {
                                width: 100%;
                                height: 100%;
                                text: StudioLive.message;
                                enabled: !StudioLive.busy;
                                color: Floword.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                edited => { StudioLive.message = self.text; }
                            }
                            if StudioLive.message == "" && !chat-in.has-focus: Text {
                                width: 100%;
                                text: I18n.t("studioLive.messageHint");
                                color: Floword.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                StudioButton {
                    label: I18n.t("studioLive.speakBtn");
                    enabled: !StudioLive.busy && !StudioLive.is-speaking && StudioLive.message != "";
                    clicked => { StudioLive.speak-text(StudioLive.message); }
                }
                StudioButton {
                    label: I18n.t("studioLive.sendBtn");
                    primary: true;
                    enabled: !StudioLive.busy && StudioLive.state == "connected" && StudioLive.message != "";
                    clicked => { StudioLive.send(StudioLive.message); }
                }
            }
        }
    }
}
