import { I18n } from "../i18n.slint";
import { Floword } from "../theme/floword.slint";
import { PaneScroll } from "pane.slint";
import { Glyph, Icon } from "../icons.slint";
import { Select } from "../primitives/primitives.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField, StudioStatus } from "studio-chrome.slint";
import { StudioAi } from "studio-ai.slint";
import { StudioOpenTalking } from "studio-opentalking.slint";
import { PromaxAvatarPicker, StudioPromaxAvatars } from "studio-promax-avatars.slint";
import { StudioProducts, StudioProductsPanel, TempleProductsPanel } from "studio-products.slint";
import { ControlFoldout } from "control-chrome.slint";
import { TemplePalette, TempleButton, TempleField, TempleCard, TempleToggle, TempleSelect, TempleSlider } from "temple-chrome.slint";

export struct TempleViewerRow { id: string, name: string, skin: string, coins: int, simulated: bool }

export struct StudioLiveCommentRow {
    event-id: string,
    kind: string,
    username: string,
    content: string,
    time: string,
}

export global StudioLive {
    in-out property <int> studio-tab:0;
    in-out property <string> kedi-mode:"disabled";
    in-out property <bool> kedi-ready;
    in-out property <string> kedi-product;
    in-out property <string> kedi-health;
    in-out property <string> kedi-action-error;
    in-out property <string> kedi-script;
    in-out property <bool> kedi-product-busy;
    callback kedi-enable(bool);
    callback kedi-import-product();
    in-out property <bool> kedi-available;
    in-out property <string> kedi-state: "Created";
    in-out property <string> kedi-status;
    in-out property <string> kedi-reply;
    in-out property <string> kedi-comment;
    in-out property <bool> kedi-automatic;
    callback kedi-control(string);
    callback kedi-simulate(string);
    callback kedi-speak(string);
    in-out property <image> video-frame;
    in-out property <string> motion-title;
    in-out property <string> motion-status;
    in-out property <bool> motion-loading;
    in-out property <bool> motion-playing;
    callback choose-motion();
    callback use-builtin-motion();
    callback stop-motion();
    callback select-avatar-motion(int);
    in-out property <int> avatar-source: 0;
    in-out property <bool> output-help;
    in-out property <bool> output-help-seen;
    in-out property <string> username;
    in-out property <string> message;
    in-out property <string> state: "stopped";
    out property <bool> session-active: state == "starting" || state == "connecting" || state == "connected" || state == "degraded" || state == "disconnected" || state == "stopping";
    in-out property <string> status;
    in-out property <string> events;
    in-out property <string> inspection-result;
    in-out property <[StudioLiveCommentRow]> comments;
    in-out property <int> active-tab: 0;
    in-out property <int> total-count: 0;
    in-out property <int> comment-count: 0;
    in-out property <int> gift-count: 0;
    in-out property <int> other-count: 0;
    in-out property <bool> busy;
    in-out property <bool> auto-reply;
    in-out property <bool> auto-product-reply;
    in-out property <bool> auto-product-rotation;
    in-out property <bool> is-speaking;
    in-out property <bool> lipsync-enabled: true;
    in-out property <bool> lipsync-active;
    in-out property <bool> lipsync-busy;
    in-out property <string> lipsync-url: "http://127.0.0.1:8766";
    in-out property <string> lipsync-token;
    in-out property <string> lipsync-status;
    callback connect-lipsync();
    callback ensure-lipsync();
    callback disconnect-lipsync();
    in-out property <bool> director-enabled;
    in-out property <bool> director-busy;
    in-out property <[string]> director-clips;
    in-out property <string> director-status;
    callback choose-director-clip(int);
    callback clear-director-clip(int);
    callback toggle-director();
    callback test-director-file();
    in-out property <bool> voice-server-enabled;
    in-out property <bool> voice-server-busy;
    in-out property <string> voice-server-url: "http://127.0.0.1:8767";
    in-out property <string> voice-server-token;
    in-out property <[string]> voice-server-names;
    in-out property <int> voice-server-index: -1;
    in-out property <string> voice-server-status;
    in-out property <string> reference-voice-name;
    in-out property <bool> voice-sample-mode;
    callback use-sample-voice(bool);
    callback connect-voice-server();
    callback disconnect-voice-server();
    callback select-server-voice(int);
    callback enroll-server-voice();
    callback enroll-video-voice();
    in-out property <string> displayed-subtitle: "";
    in-out property <bool> show-products;
    in-out property <bool> show-settings;
    in-out property <string> pinned-title;
    in-out property <string> pinned-price;
    in-out property <string> pinned-script;

    callback connect(username: string);
    callback disconnect();
    callback inspect(username: string);
    callback send(message: string);
    callback toggle-auto-reply();
    callback toggle-auto-product-reply();
    callback toggle-auto-product-rotation();
    callback reply-to-comment(username: string, content: string);
    callback speak-text(text: string);
    callback interrupt-speech();
    callback next-product();
    callback speak-pinned-product();
    callback set-tab(tab: int);
    in-out property <bool> output-window-open: false;
    callback toggle-output-window();
    callback open-chanh-dien();
    callback open-chanh-dien-overlay();
    callback cd-action(string, string, string, int);
    callback cd-ensure();
    callback cd-settings();
    callback cd-hide-preview();
    callback cd-reload-preview();
    in-out property <bool> cd-page-active;
    in-out property <bool> cd-preview-allowed;
    in-out property <bool> cd-preview-inline;
    in-out property <bool> cd-preview-loaded;
    in-out property <string> cd-preview-status: "Đang tải overlay LIVE…";
    in-out property <length> cd-preview-x;
    in-out property <length> cd-preview-y;
    in-out property <length> cd-preview-width;
    in-out property <length> cd-preview-height;
    in-out property <bool> cd-audio-enabled;
    in-out property <string> cd-origin;
    in-out property <bool> cd-connected;
    in-out property <bool> cd-settings-pending;
    in-out property <int> cd-capacity: 24;
    in-out property <string> cd-tt-state: "idle";
    in-out property <[TempleViewerRow]> cd-people;
    in-out property <[string]> cd-logs;
    in-out property <int> cd-log-revision;
    in-out property <int> cd-bpm: 52;
    in-out property <int> cd-voice-index;
    in-out property <int> cd-seats-index;
    in-out property <string> cd-server-status: "Server: Chưa kết nối";
    in-out property <string> cd-tiktok-status: "TikTok: Chưa kết nối";
    in-out property <string> cd-viewers-count: "0/24 người";
    in-out property <string> cd-sim-name: "Minh An";
    in-out property <string> cd-sim-text: "Nam mô A Di Đà Phật, cầu an";
    in-out property <bool> cd-bot-running: false;
    in-out property <bool> cd-mo-enabled: true;
    in-out property <bool> cd-music-enabled: true;
    in-out property <bool> cd-chant-enabled: true;
    in-out property <int> cd-bottom-tab: 0;
    in-out property <string> cd-event-log: "";
    in-out property <string> cd-script-text: "Nguyện đem công đức này, hướng về khắp tất cả, đệ tử và chúng sinh, đều trọn thành Phật đạo. Cầu chúc cho mọi người một ngày an lạc và nhiều may mắn.";
    in-out property <bool> cd-auto-reply: true;
    in-out property <bool> cd-auto-product: true;
    in-out property <string> cd-current-skin: "Sư Thầy";
}


component LiveTabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    min-width: 0px; min-height: 36px; max-height: 36px; horizontal-stretch: 1;
    background: root.active ? Floword.raised : transparent; border-radius: 8px;
    border-width: focus.has-focus || root.active ? 1px : 0px;
    border-color: focus.has-focus ? Floword.cyan : Floword.line;
    accessible-role: button; accessible-label: root.text;
    Text { width: 100%; height: 100%; text: root.text; color: root.active ? Floword.text : Floword.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
    focus := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

component LegacyLivePage inherits VerticalLayout {
    // Breakpoints must depend on the externally allocated viewport, not this
    // layout's width: Grid/Flex measurement reads its children's minimum sizes.
    // Reading root.width while choosing those sizes recurses at minimize widths.
    in property <length> viewport-width: 1080px;
    in property <length> viewport-height: 720px;
    callback configure-ai();
    callback configure-services();
    callback manage-avatars();
    property <bool> wide: root.viewport-width >= 980px;
    property <bool> single: root.viewport-width < 650px;
    property <bool> connected: StudioLive.state == "connected";
    property <bool> recovering: StudioLive.state == "degraded" || StudioLive.state == "disconnected";
    property <bool> connecting: StudioLive.state == "starting" || StudioLive.state == "connecting";
    property <string> connection-label: root.connected ? "Đã kết nối" : root.recovering ? "Đang nối lại…" : root.connecting ? "Đang kết nối…" : StudioLive.state == "stopping" ? "Đang ngắt…" : StudioLive.state == "failed" ? "Kết nối thất bại" : "Chưa kết nối";
    property <bool> has-avatar: StudioLive.avatar-source == 1 ? StudioPromaxAvatars.ready-ids.length > 0 : StudioOpenTalking.avatar-options.length > 0;
    property <bool> has-product: StudioLive.pinned-title != "" || StudioProducts.active-title != "";
    property <bool> ai-ready: StudioAi.models-loaded && StudioAi.models.length > 0;
    // Explicit externally-derived text width keeps wrapped voice instructions in
    // the card's preferred height. Do not measure the grid/card's own width here.
    property <length> voice-text-width: Math.max(0px, (root.single ? root.viewport-width : root.wide ? 256px : 232px) - 32px);
    property <image> selected-preview: StudioLive.avatar-source == 1 ? StudioPromaxAvatars.preview : StudioOpenTalking.avatar-preview;
    min-width: 0px; spacing: 16px; alignment: start;
    init => {
        StudioLive.ensure-lipsync();
        if !StudioOpenTalking.catalogs-loaded && !StudioOpenTalking.busy { StudioOpenTalking.refresh(); }
        if !StudioPromaxAvatars.loaded && !StudioPromaxAvatars.busy { StudioPromaxAvatars.refresh(); }
        if !StudioAi.models-loaded && !StudioAi.busy { StudioAi.load-models(); }
        if StudioPromaxAvatars.live-active-id != "" { StudioLive.avatar-source = 1; }
    }
    FlexboxLayout {
        spacing: 8px; min-width: 0px;
        HorizontalLayout {
            spacing: 12px; preferred-width: 350px; horizontal-stretch: 1; height: 36px;
            Text { text: "TikTok LIVE"; color: Floword.text; font-size: 20px; font-weight: 700; vertical-alignment: center; }
            // A fixed status badge avoids wrapped text asking Flexbox for its
            // own width while Flexbox is still measuring the header height.
            StudioStatus { width: 144px; height: 32px; label: root.connection-label; tone: root.connected ? 1 : root.connecting || root.recovering ? 2 : StudioLive.state == "failed" ? 3 : 0; }
        }
        StudioButton {
            label: "Sản phẩm"; compact: true;
            clicked => { StudioLive.show-products = !StudioLive.show-products; if StudioLive.show-products { StudioProducts.open = true; if !StudioProducts.loaded && !StudioProducts.busy { StudioProducts.load(); } } }
        }
    }
    if StudioLive.status != "": StudioStatus { label: StudioLive.status; tone: StudioLive.state == "failed" ? 3 : root.recovering ? 2 : 0; }
    if StudioLive.kedi-available: StudioCard {
        StudioHeading { title: "Kedi Live Commerce"; }
        Text { text: StudioLive.kedi-state + " · " + StudioLive.kedi-status; color: Floword.muted; wrap: word-wrap; min-width: 0px; }
        FlexboxLayout {
            spacing: 8px; min-width: 0px;
            StudioButton { label: StudioLive.kedi-state == "Stopped" ? "Phiên mới" : "Bắt đầu"; enabled: StudioLive.kedi-state == "Created" || StudioLive.kedi-state == "Recovering" || StudioLive.kedi-state == "Stopped"; clicked => { StudioLive.kedi-control("start"); } }
            StudioButton { label: StudioLive.kedi-state == "Paused" || !StudioLive.kedi-automatic ? "Tiếp tục" : "Tạm dừng"; enabled: StudioLive.kedi-state == "Live" || StudioLive.kedi-state == "Paused"; clicked => { StudioLive.kedi-control(StudioLive.kedi-state == "Paused" || !StudioLive.kedi-automatic ? "resume" : "pause"); } }
            StudioButton { label: "Tiếp quản"; enabled: StudioLive.kedi-state == "Live"; clicked => { StudioLive.kedi-control("takeover"); } }
            StudioButton { label: "Giới thiệu sản phẩm"; enabled: StudioLive.kedi-state == "Live"; clicked => { StudioLive.kedi-control("introduce"); } }
            StudioButton { label: "Dừng Kedi"; enabled: StudioLive.kedi-state != "Stopped"; clicked => { StudioLive.kedi-control("stop"); } }
        }
        StudioField { label: "Bình luận kiểm thử / lời nói thủ công"; value: StudioLive.kedi-comment; placeholder: "Shop ơi, giá bao nhiêu?"; edited(text) => { StudioLive.kedi-comment = text; } }
        FlexboxLayout {
            spacing: 8px; min-width: 0px;
            StudioButton { label: "Mô phỏng bình luận"; enabled: StudioLive.kedi-state == "Live"; clicked => { StudioLive.kedi-simulate(StudioLive.kedi-comment); } }
            StudioButton { label: "Nói thủ công"; enabled: StudioLive.kedi-state == "Live"; clicked => { StudioLive.kedi-speak(StudioLive.kedi-comment); } }
        }
        if StudioLive.kedi-reply != "": Text { text: StudioLive.kedi-reply; color: Floword.text; wrap: word-wrap; min-width: 0px; }
    }
    if StudioLive.show-products: StudioProductsPanel { }
    GridLayout {
        spacing: 16px; min-width: 0px;
        StudioCard {
            row: 0; col: 0; width: root.single ? Math.max(0px, root.viewport-width) : root.wide ? 256px : 232px;
            horizontal-stretch: 0; spacing: 16px;
            StudioHeading { title: "Điều khiển LIVE"; glyph: Glyph.waveform; font-size: 15px; }
            StudioField { compact: true; label: "Kênh TikTok"; placeholder: "@ten_kenh"; value: StudioLive.username; enabled: !StudioLive.busy && !StudioLive.session-active; edited(text) => { StudioLive.username = text; } }
            if !StudioLive.session-active: StudioButton {
                label: StudioLive.busy ? "Đang kết nối…" : StudioLive.state == "failed" ? "Thử kết nối lại" : "Kết nối TikTok"; primary: true;
                enabled: !StudioLive.busy && StudioLive.username != ""; clicked => { StudioLive.connect(StudioLive.username); }
            }
            if StudioLive.session-active: StudioButton { label: StudioLive.state == "stopping" ? "Đang ngắt…" : StudioLive.busy && root.connecting ? "Đang kết nối…" : root.connected ? "Ngắt kết nối" : "Hủy kết nối"; enabled: !StudioLive.busy; clicked => { StudioLive.disconnect(); } }
            Rectangle { height: 1px; background: Floword.line; }
            Text { text: "Nhân vật"; color: Floword.text; font-size: 13px; font-weight: 600; }
            HorizontalLayout {
                spacing: 4px;
                LiveTabButton { text: "Có sẵn"; active: StudioLive.avatar-source == 0; clicked => { StudioLive.avatar-source = 0; } }
                LiveTabButton { text: "Video của tôi"; active: StudioLive.avatar-source == 1; clicked => { StudioLive.avatar-source = 1; } }
            }
            if StudioLive.avatar-source == 0: VerticalLayout {
                spacing: 8px;
                if StudioOpenTalking.avatar-options.length > 0: Select { options: StudioOpenTalking.avatar-options; current <=> StudioOpenTalking.avatar-index; placeholder: "Chọn nhân vật"; enabled: !StudioOpenTalking.busy && !StudioLive.motion-loading; changed(index) => { StudioOpenTalking.select-avatar(index); } }
                if StudioOpenTalking.avatar-options.length == 0: StudioButton { label: StudioOpenTalking.busy ? "Đang tải nhân vật…" : "Tải nhân vật"; enabled: !StudioOpenTalking.busy; clicked => { StudioOpenTalking.refresh(); } }
            }
            if StudioLive.avatar-source == 1: VerticalLayout {
                spacing: 8px;
                PromaxAvatarPicker { compact: true; import-requested => { root.manage-avatars(); } }
                StudioButton { label: "Kho nhân vật"; compact: true; enabled: !StudioPromaxAvatars.busy; clicked => { root.manage-avatars(); } }
            }
            Text { text: "Giọng nói"; color: Floword.text; font-size: 13px; font-weight: 600; }
            HorizontalLayout {
                min-width: 0px; spacing: 6px;
                StudioButton { label: "Có sẵn"; compact: true; primary: !StudioLive.voice-sample-mode; enabled: !StudioLive.voice-server-busy && !StudioLive.is-speaking; clicked => { StudioLive.use-sample-voice(false); } }
                StudioButton { label: "Giọng mẫu"; compact: true; primary: StudioLive.voice-sample-mode; enabled: !StudioLive.voice-server-busy && !StudioLive.is-speaking; clicked => { StudioLive.use-sample-voice(true); } }
            }
            if !StudioLive.voice-sample-mode: VerticalLayout {
                min-width: 0px; spacing: 8px;
                if StudioOpenTalking.voice-options.length > 0: Select { options: StudioOpenTalking.voice-options; current <=> StudioOpenTalking.voice-index; placeholder: "Chọn giọng nói"; enabled: !StudioOpenTalking.busy; }
                if StudioOpenTalking.voice-options.length == 0: StudioButton { label: StudioOpenTalking.busy ? "Đang tải giọng nói…" : "Tải giọng nói"; enabled: !StudioOpenTalking.busy; clicked => { StudioOpenTalking.refresh(); } }
            }
            if StudioLive.voice-sample-mode: VerticalLayout {
                min-width: 0px; spacing: 8px;
                Text { width: root.voice-text-width; text: "Dùng giọng trong video nhân vật, hoặc tải tệp giọng riêng để AI đọc lời mới."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
                if !StudioLive.voice-server-enabled: StudioButton { label: StudioLive.voice-server-busy ? "Đang tải giọng…" : "Giọng đã lưu"; compact: true; enabled: !StudioLive.voice-server-busy && !StudioLive.is-speaking; clicked => { StudioLive.connect-voice-server(); } }
                if StudioLive.voice-server-enabled && StudioLive.voice-server-names.length > 0: VerticalLayout {
                    min-width: 0px; spacing: 8px;
                    Text { text: "Giọng đã lưu"; color: Floword.cyan; font-size: 12px; }
                    Select { options: StudioLive.voice-server-names; current: StudioLive.voice-server-index; placeholder: "Chọn giọng của bạn"; enabled: !StudioLive.voice-server-busy && !StudioLive.is-speaking; changed(index) => { StudioLive.select-server-voice(index); } }
                }
                StudioButton { label: StudioLive.voice-server-busy ? "Đang chuẩn bị giọng…" : "Lấy giọng từ video nhân vật"; enabled: !StudioLive.voice-server-busy && !StudioLive.is-speaking; clicked => { StudioLive.enroll-video-voice(); } }
                StudioButton { label: "Tải giọng lên · audio / video"; primary: true; enabled: !StudioLive.voice-server-busy && !StudioLive.is-speaking; clicked => { StudioLive.enroll-server-voice(); } }
                StudioField { compact: true; label: "Tên giọng · không bắt buộc"; placeholder: "Tự đặt tên khi để trống"; value: StudioLive.reference-voice-name; enabled: !StudioLive.voice-server-busy && !StudioLive.is-speaking; edited(value) => { StudioLive.reference-voice-name = value; } }
                Text { width: root.voice-text-width; text: "Chọn tệp có giọng của bạn, rõ một người nói và ít nhạc nền. App lấy 3–8 giây tiếng đầu để tạo giọng mới; mẫu được gửi và lưu trong dịch vụ giọng đã cấu hình."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
            }
            if StudioLive.voice-server-status != "": StudioStatus { label: StudioLive.voice-server-status; }
            StudioButton {
                compact: true; label: StudioLive.is-speaking ? "Dừng giọng nói" : "Nghe thử giọng"; enabled: !StudioLive.busy && !StudioLive.voice-server-busy;
                clicked => { if StudioLive.is-speaking { StudioLive.interrupt-speech(); } else { StudioLive.speak-text(I18n.t("studioLive.testSpeechSample")); } }
            }
            Rectangle { height: 1px; background: Floword.line; }
            StudioButton {
                label: StudioLive.output-window-open ? "Đóng màn hình LIVE" : "Mở màn hình LIVE"; primary: root.connected && !StudioLive.output-window-open;
                enabled: StudioLive.output-window-open || StudioLive.video-frame.width > 0 || (root.has-avatar && root.selected-preview.width > 0);
                clicked => { if !StudioLive.output-window-open && !StudioLive.output-help-seen { StudioLive.output-help = true; } StudioLive.toggle-output-window(); }
            }
            if StudioLive.output-help: VerticalLayout {
                spacing: 8px;
                Text { text: "TikTok LIVE Studio → Thêm nguồn → Cửa sổ → Concat LIVE Output"; color: Floword.text; font-size: 12px; wrap: word-wrap; }
                StudioButton { label: "Đã hiểu"; compact: true; clicked => { StudioLive.output-help = false; StudioLive.output-help-seen = true; } }
            }
        }
        VerticalLayout {
            row: root.single ? 1 : 0; col: root.single ? 0 : 1; min-width: 0px; horizontal-stretch: 1; spacing: 16px;
            StudioCard {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    StudioHeading { title: "Xem trước"; glyph: Glyph.film; font-size: 15px; }
                    Text { text: StudioLive.motion-loading ? "Đang tải…" : StudioLive.motion-playing ? "Đang phát" : root.has-avatar ? "Sẵn sàng" : "Chưa chọn"; color: StudioLive.motion-playing ? Floword.success : Floword.muted; font-size: 12px; vertical-alignment: center; }
                }
                Text { text: StudioLive.lipsync-enabled ? "Khớp môi AI: Tự động · Đã kết nối" : StudioLive.lipsync-busy ? "Khớp môi AI: Đang kết nối…" : "Khớp môi AI: Tự động · Sẵn sàng"; color: Floword.success; font-size: 12px; wrap: word-wrap; }
                if StudioLive.lipsync-status != "": StudioStatus { label: StudioLive.lipsync-status; }
                Rectangle {
                    min-width: 0px; height: Math.max(280px, Math.min(480px, root.viewport-height - 280px));
                    background: #080B12; border-radius: 8px; clip: true;
                    if StudioLive.video-frame.width > 0: Image { width: 100%; height: 100%; source: StudioLive.video-frame; image-fit: contain; }
                    if StudioLive.video-frame.width == 0 && root.has-avatar && root.selected-preview.width > 0: Image { width: 100%; height: 100%; source: root.selected-preview; image-fit: contain; }
                    if StudioLive.video-frame.width == 0 && (!root.has-avatar || root.selected-preview.width == 0): VerticalLayout {
                        padding: 24px; spacing: 16px; alignment: center;
                        Icon { glyph: Glyph.film; size: 32px; tint: Floword.muted; horizontal-stretch: 1; }
                        Text { text: StudioLive.motion-loading ? "Đang tải video…" : "Chọn nhân vật để xem trước"; color: Floword.muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    if StudioLive.displayed-subtitle != "": Rectangle {
                        x: 12px; y: parent.height - self.height - 12px; width: Math.max(0px, parent.width - 24px); min-height: subtitle-body.preferred-height; background: #000000cc; border-radius: 8px;
                        subtitle-body := VerticalLayout { padding: 8px; Text { text: StudioLive.displayed-subtitle; color: #ffffff; font-size: 13px; wrap: word-wrap; } }
                    }
                }
                if !StudioLive.motion-loading && StudioLive.motion-status != "" && !StudioLive.motion-playing: StudioStatus { label: StudioLive.motion-status; tone: 2; }
                HorizontalLayout {
                    spacing: 8px;
                    if !StudioLive.motion-playing: StudioButton {
                        label: StudioLive.motion-loading ? "Đang tải…" : "Xem thử chuyển động"; enabled: root.has-avatar && !StudioLive.motion-loading && !StudioPromaxAvatars.busy;
                        clicked => { if StudioLive.avatar-source == 1 { StudioPromaxAvatars.use-live(); } else { StudioLive.select-avatar-motion(StudioOpenTalking.avatar-index); } }
                    }
                    if StudioLive.motion-playing: StudioButton { label: "Dừng video"; clicked => { StudioLive.stop-motion(); } }
                    StudioButton { label: "Đổi video"; enabled: !StudioLive.motion-loading; clicked => { StudioLive.choose-motion(); } }
                }
                if StudioLive.motion-playing: Text { text: StudioLive.lipsync-active ? "Đang phát tệp hình–tiếng đồng bộ" : StudioLive.is-speaking ? "Đang dựng chuyển động khớp môi..." : "Chuyển động nhân vật sẵn sàng · Tự động khớp môi khi có lời AI"; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
            }
            StudioCard {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 4px;
                        Text { text: root.has-product ? (StudioLive.pinned-title != "" ? StudioLive.pinned-title : StudioProducts.active-title) : "Sản phẩm"; color: Floword.text; font-size: 14px; font-weight: 600; wrap: word-wrap; }
                        if root.has-product: Text { text: StudioLive.pinned-price != "" ? StudioLive.pinned-price : StudioProducts.active-price; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
                    }
                    StudioButton { label: root.has-product ? "Đổi sản phẩm" : "Chọn sản phẩm"; compact: true; clicked => { StudioLive.show-products = true; StudioProducts.open = true; if !StudioProducts.loaded && !StudioProducts.busy { StudioProducts.load(); } } }
                }
                if root.has-product: FlexboxLayout {
                    spacing: 8px;
                    StudioButton { label: "Đọc kịch bản"; enabled: StudioLive.pinned-script != "" && StudioOpenTalking.voice-options.length > 0 && !StudioLive.busy && !StudioLive.is-speaking; clicked => { StudioLive.speak-pinned-product(); } }
                    StudioButton { label: "Sản phẩm tiếp theo"; enabled: StudioProducts.rows.length > 1 && !StudioProducts.busy; clicked => { StudioLive.next-product(); } }
                }
            }
        }
        StudioCard {
            row: root.single ? 2 : root.wide ? 0 : 1; col: root.wide ? 2 : 0; colspan: !root.wide && !root.single ? 2 : 1;
            min-width: 0px; preferred-width: root.wide ? 320px : 600px; max-width: root.wide ? 320px : 4096px;
            horizontal-stretch: root.wide ? 0 : 1; spacing: 12px;
            StudioHeading { title: "Tương tác"; glyph: Glyph.more; font-size: 15px; }
            if root.ai-ready: StudioButton { compact: true; label: StudioLive.auto-reply ? "AI tự trả lời: Bật" : "AI tự trả lời: Tắt"; enabled: !StudioLive.busy; clicked => { StudioLive.toggle-auto-reply(); } }
            if !root.ai-ready: StudioButton { compact: true; label: StudioAi.busy ? "Đang tải AI…" : "Thiết lập AI trả lời"; enabled: !StudioAi.busy; clicked => { root.configure-ai(); } }
            Text { text: "Giới thiệu sản phẩm"; color: Floword.text; font-size: 13px; font-weight: 600; }
            StudioButton { label: StudioLive.auto-product-reply ? "Theo bình luận: Bật" : "Theo bình luận: Tắt"; compact: true; enabled: root.has-product || StudioLive.auto-product-reply; clicked => { StudioLive.toggle-auto-product-reply(); } }
            StudioButton { label: StudioLive.auto-product-rotation ? "Đọc luân phiên: Bật" : "Đọc luân phiên: Tắt"; compact: true; enabled: root.has-product || StudioLive.auto-product-rotation; clicked => { StudioLive.toggle-auto-product-rotation(); } }
            HorizontalLayout {
                spacing: 4px;
                LiveTabButton { text: "Tất cả"; active: StudioLive.active-tab == 0; clicked => { StudioLive.active-tab = 0; } }
                LiveTabButton { text: "Bình luận"; active: StudioLive.active-tab == 1; clicked => { StudioLive.active-tab = 1; } }
                LiveTabButton { text: "Quà"; active: StudioLive.active-tab == 2; clicked => { StudioLive.active-tab = 2; } }
                LiveTabButton { text: "Khác"; active: StudioLive.active-tab == 3; clicked => { StudioLive.active-tab = 3; } }
            }
            PaneScroll {
                height: root.wide ? Math.max(280px, Math.min(420px, root.viewport-height - 340px)) : 280px; min-width: 0px;
                VerticalLayout {
                    spacing: 8px;
                    if StudioLive.comments.length == 0: VerticalLayout {
                        padding-top: 32px; padding-bottom: 32px;
                        Text { text: root.connected ? "Chờ tương tác mới" : root.connecting || root.recovering ? "Đang kết nối TikTok…" : "Kết nối TikTok để nhận bình luận"; color: Floword.muted; font-size: 13px; wrap: word-wrap; horizontal-alignment: center; }
                    }
                    for comment in StudioLive.comments: Rectangle {
                        visible: StudioLive.active-tab == 0 || (StudioLive.active-tab == 1 && (comment.kind == "chat" || comment.kind == "ai")) || (StudioLive.active-tab == 2 && comment.kind == "gift") || (StudioLive.active-tab == 3 && comment.kind != "chat" && comment.kind != "ai" && comment.kind != "gift");
                        min-height: self.visible ? comment-body.preferred-height : 0px; max-height: self.visible ? 10000px : 0px;
                        background: comment.kind == "ai" ? Floword.raised : Floword.field; border-radius: 8px;
                        comment-body := VerticalLayout {
                            padding: 8px; spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: comment.username; color: comment.kind == "ai" ? Floword.cyan : Floword.text; font-size: 12px; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; }
                                Text { text: comment.time; color: Floword.muted; font-size: 11px; }
                            }
                            Text { text: comment.content; color: Floword.text; font-size: 13px; wrap: word-wrap; }
                            if comment.kind != "gift" && comment.kind != "like" && comment.kind != "follow" && comment.kind != "ai": StudioButton {
                                compact: true; label: "AI trả lời"; enabled: root.connected && root.ai-ready && !StudioLive.busy && !StudioLive.is-speaking;
                                clicked => { StudioLive.reply-to-comment(comment.username, comment.content); }
                            }
                        }
                    }
                }
            }
            StudioField { compact: true; label: "Nội dung"; placeholder: "Nhập câu muốn gửi hoặc đọc"; value: StudioLive.message; enabled: !StudioLive.busy; edited(text) => { StudioLive.message = text; } }
            HorizontalLayout {
                spacing: 8px;
                StudioButton { compact: true; label: "AI nói"; enabled: !StudioLive.busy && !StudioLive.is-speaking && StudioLive.message != "" && (StudioOpenTalking.voice-options.length > 0 || StudioLive.voice-server-enabled); clicked => { StudioLive.speak-text(StudioLive.message); } }
                StudioButton { compact: true; label: "Gửi"; primary: root.connected; enabled: !StudioLive.busy && root.connected && StudioLive.message != ""; clicked => { StudioLive.send(StudioLive.message); } }
            }
            if StudioLive.is-speaking: StudioButton { label: "Ngắt lời"; compact: true; clicked => { StudioLive.interrupt-speech(); } }
        }
    }
}

component LiveStudioPreview inherits StudioCard {
    in property <length> preview-height:320px;
    property <image> poster:StudioLive.avatar-source==1 ? StudioPromaxAvatars.preview : StudioOpenTalking.avatar-preview;
    StudioHeading {title:"Xem trước · hình và lời đọc";}
    Rectangle {
        min-width:0px;height:root.preview-height;background:#080b12;border-radius:8px;clip:true;
        if StudioLive.video-frame.width>0: Image {width:100%;height:100%;source:StudioLive.video-frame;image-fit:contain;}
        if StudioLive.video-frame.width==0 && root.poster.width>0: Image {width:100%;height:100%;source:root.poster;image-fit:contain;}
        if StudioLive.video-frame.width==0 && root.poster.width==0: Text {width:100%;height:100%;text:"Chọn nhân vật ở mục Nhân vật / Cử chỉ";color:#ffffff;font-size:13px;wrap:word-wrap;horizontal-alignment:center;vertical-alignment:center;}
        if StudioLive.displayed-subtitle!="": Rectangle {
            x:12px;width:Math.max(0px,parent.width - 24px);y:parent.height - self.height - 12px;min-height:caption.preferred-height;background:#000000cc;border-radius:8px;
            caption:=VerticalLayout {padding:8px;Text {text:StudioLive.displayed-subtitle;color:white;wrap:word-wrap;min-width:0px;}}
        }
    }
    Text {text:StudioLive.lipsync-active ? "Đang phát hình–tiếng đã đồng bộ" : StudioLive.motion-playing ? (StudioLive.is-speaking ? "Đang dựng chuyển động khớp môi..." : "Chuyển động nhân vật sẵn sàng · Tự động khớp môi khi có lời AI") : "Chưa có chuyển động đang phát";color:Floword.muted;wrap:word-wrap;min-width:0px;}
    if StudioLive.motion-status!="": StudioStatus {label:StudioLive.motion-status;}
}

component TemplePill inherits Rectangle {
    in property <string> label;
    in property <bool> success;
    min-height: 29px; max-height: 29px;
    preferred-width: caption.preferred-width + 20px;
    min-width: 0px; horizontal-stretch: 0;
    background: root.success ? #10b98118 : #ffffff08;
    border-radius: 15px; border-width: 1px;
    border-color: root.success ? #10b98166 : TemplePalette.line;
    caption := Text { x: 10px; width: Math.max(0px, parent.width - 20px); height: 100%; text: root.label; color: root.success ? #34d399 : TemplePalette.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
}

component TempleEventLog inherits Rectangle {
    min-width: 0px; height: 244px;
    background: TemplePalette.field; border-radius: 8px;
    border-width: 1px; border-color: TemplePalette.line;
    property <int> revision: StudioLive.cd-log-revision;
    changed revision => { log-scroll.scroll-to-bottom(); }
    log-scroll := PaneScroll {
        x: 10px; y: 10px; width: Math.max(0px, parent.width - 20px); height: parent.height - 20px;
        VerticalLayout {
            spacing: 3px; alignment: start;
            if StudioLive.cd-logs.length == 0: Text { text: "Chờ sự kiện từ máy chủ LIVE…"; color: TemplePalette.muted; font-size: 13px; wrap: word-wrap; }
            for line in StudioLive.cd-logs: Text { text: line; color: #a5b4fc; font-family: "Consolas"; font-size: 12px; wrap: word-wrap; min-width: 0px; }
        }
    }
}

export component StudioLivePage inherits Rectangle {
    in property <length> viewport-width: 1080px;
    in property <length> viewport-height: 720px;
    callback configure-ai();
    callback configure-services();
    callback manage-avatars();
    callback manage-scripts();
    property <bool> inline-preview: root.viewport-width >= 1050px;
    property <length> preview-width: Math.max(180px, Math.min(440px, Math.min(root.viewport-width * 0.27, (root.viewport-height - (root.viewport-width < 1180px ? 220px : 170px)) * 9 / 16)));
    property <length> controls-width: Math.max(0px, root.viewport-width - (root.inline-preview ? root.preview-width + 40px : 0px) - 48px);
    property <int> columns: root.controls-width >= 840px ? 3 : root.controls-width >= 540px ? 2 : 1;
    min-width: 0px;
    height: Math.max(400px, root.viewport-height);
    background: TemplePalette.ground;
    clip: true;
    init => { StudioLive.cd-ensure(); }
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            min-height: toolbar.preferred-height; vertical-stretch: 0;
            background: TemplePalette.panel;
            toolbar := GridLayout {
                padding: 15px; spacing: 10px; min-width: 0px;
                FlexboxLayout {
                    row: 0; col: 0; spacing: 9px; min-width: 0px;
                    preferred-width: root.viewport-width < 1180px ? root.viewport-width - 30px : 650px;
                    horizontal-stretch: 0;
                    Text { text: "🪷  Chánh Điện Tịnh Tâm"; font-family: "Georgia"; font-size: 19px; font-weight: 700; color: TemplePalette.gold; height: 40px; vertical-alignment: center; }
                    TemplePill { label: StudioLive.cd-server-status; success: StudioLive.cd-connected; }
                    TemplePill { label: StudioLive.cd-tiktok-status; success: StudioLive.cd-tt-state == "connected"; }
                    TemplePill { label: StudioLive.cd-viewers-count; }
                }
                HorizontalLayout {
                    row: root.viewport-width < 1180px ? 1 : 0;
                    col: root.viewport-width < 1180px ? 0 : 1;
                    spacing: 8px; alignment: end; min-width: 0px; horizontal-stretch: 1;
                    TempleButton { label: "📋 Copy Link OBS Studio"; clicked => { StudioLive.cd-action("copy-obs", "", "", 0); } }
                    TempleButton { label: "▣ Mở Cửa Sổ Phát (1080×1920)"; tone: 3; clicked => { StudioLive.open-chanh-dien-overlay(); } }
                    TempleButton { label: StudioLive.cd-audio-enabled ? "🔊 Tắt âm preview" : "🔊 Bật âm thanh"; clicked => { StudioLive.cd-action("audio", "", "", StudioLive.cd-audio-enabled ? 0 : 1); } }
                }
            }
        }
        Rectangle { height: 1px; background: TemplePalette.line; }
        HorizontalLayout {
            spacing: 0px; min-width: 0px;
            PaneScroll {
                horizontal-stretch: 1; min-width: 0px;
                VerticalLayout {
                    padding: 18px; spacing: 18px; alignment: start; min-width: 0px;
                    GridLayout {
                        spacing: 18px; min-width: 0px;
                        TempleCard {
                            row: 0; col: 0; horizontal-stretch: 1;
                            width: (root.controls-width - (root.columns - 1) * 18px) / root.columns;
                            title: "1 · KẾT NỐI TIKTOK LIVE";
                            Text { text: "Username kênh đang phát LIVE (bắt đầu bằng @)"; color: TemplePalette.muted; font-size: 13px; wrap: word-wrap; min-width: 0px; }
                            HorizontalLayout {
                                spacing: 8px; min-width: 0px;
                                TempleField { value: StudioLive.username; placeholder: "@username_cua_ban"; enabled: StudioLive.cd-tt-state != "connected" && StudioLive.cd-tt-state != "connecting"; edited(value) => { StudioLive.username = value; } }
                                TempleButton { label: "Kết nối"; tone: 1; width: 72px; enabled: StudioLive.cd-connected && StudioLive.username != "" && StudioLive.cd-tt-state != "connecting" && StudioLive.cd-tt-state != "disconnecting" && StudioLive.cd-tt-state != "connected"; clicked => { StudioLive.cd-action("connect", StudioLive.username, "", 0); } }
                                TempleButton { label: "Ngắt"; tone: 2; width: 58px; enabled: StudioLive.cd-connected && (StudioLive.cd-tt-state == "connected" || StudioLive.cd-tt-state == "connecting"); clicked => { StudioLive.cd-action("disconnect", "", "", 0); } }
                            }
                            Text { text: "Chỉ đọc sự kiện công khai của phòng LIVE (bình luận, quà, tim). Không yêu cầu bạn nhập cookie hay mật khẩu TikTok."; color: TemplePalette.muted; font-size: 13px; wrap: word-wrap; min-width: 0px; }
                            Text { text: "Danh sách đạo hữu đang ngồi tụng kinh:"; color: TemplePalette.muted; font-size: 13px; wrap: word-wrap; }
                            Rectangle {
                                height: 134px; background: TemplePalette.field; border-radius: 7px; border-width: 1px; border-color: TemplePalette.line;
                                PaneScroll {
                                    VerticalLayout {
                                        padding: 10px; spacing: 7px;
                                        if StudioLive.cd-people.length == 0: Text { text: "Chưa có ai"; color: TemplePalette.muted; horizontal-alignment: center; font-size: 13px; }
                                        for person in StudioLive.cd-people: HorizontalLayout {
                                            spacing: 7px;
                                            Text { text: person.name + (person.simulated ? " · mô phỏng" : ""); color: TemplePalette.text; font-size: 12px; wrap: word-wrap; min-width: 0px; horizontal-stretch: 1; }
                                            Text { text: person.coins > 0 ? person.coins + " 🪙" : person.skin; color: TemplePalette.gold; font-size: 11px; }
                                        }
                                    }
                                }
                            }
                        }
                        TempleCard {
                            row: root.columns == 1 ? 1 : 0; col: root.columns == 1 ? 0 : 1; horizontal-stretch: 1;
                            width: (root.controls-width - (root.columns - 1) * 18px) / root.columns;
                            title: "2 · THỬ NGHIỆM TƯƠNG TÁC";
                            HorizontalLayout {
                                spacing: 10px; min-width: 0px;
                                TempleField { label: "Tên người xem"; value: StudioLive.cd-sim-name; edited(value) => { StudioLive.cd-sim-name = value; } }
                                TempleField { label: "Bình luận / Lời nguyện"; value: StudioLive.cd-sim-text; edited(value) => { StudioLive.cd-sim-text = value; } }
                            }
                            FlexboxLayout {
                                spacing: 8px; min-width: 0px;
                                TempleButton { label: "Gửi bình luận"; enabled: StudioLive.cd-connected && StudioLive.cd-sim-text != ""; clicked => { StudioLive.cd-action("chat", StudioLive.cd-sim-name, StudioLive.cd-sim-text, 0); } }
                                TempleButton { label: "❤️ Thả tim"; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("like", StudioLive.cd-sim-name, "", 0); } }
                            }
                            Text { text: "Thử tặng quà (kèm xướng tên hồi hướng công đức):"; color: TemplePalette.muted; font-size: 13px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px; min-width: 0px;
                                TempleButton { label: "🌹 Hoa hồng · 1"; stacked: true; horizontal-stretch: 1; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("gift", StudioLive.cd-sim-name, "Hoa hồng", 1); } }
                                TempleButton { label: "🪷 Hoa sen · 30"; stacked: true; horizontal-stretch: 1; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("gift", StudioLive.cd-sim-name, "Đèn hoa sen", 30); } }
                                TempleButton { label: "🔔 Chuông · 199"; stacked: true; horizontal-stretch: 1; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("gift", StudioLive.cd-sim-name, "Chuông vàng", 199); } }
                            }
                            Text { text: "Đổ người mẫu & Bot mô phỏng:"; color: TemplePalette.muted; font-size: 13px; wrap: word-wrap; }
                            FlexboxLayout {
                                spacing: 8px; min-width: 0px;
                                for count in [15, 36, 64, 100]: TempleButton { label: count + " người"; compact: true; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("fill", "", "", count); } }
                                TempleButton { label: StudioLive.cd-bot-running ? "🤖 Tắt Bot" : "🤖 Bật Bot"; compact: true; active: StudioLive.cd-bot-running; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("bots", "", "", StudioLive.cd-bot-running ? 0 : 1); } }
                                TempleButton { label: "Làm trống"; compact: true; tone: 2; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("clear", "", "", 0); } }
                            }
                            Text { text: "Các thao tác trong bảng này là dữ liệu mô phỏng trong cảnh LIVE."; color: TemplePalette.muted; font-size: 11px; wrap: word-wrap; }
                        }
                        TempleCard {
                            row: root.columns == 3 ? 0 : root.columns == 2 ? 1 : 2;
                            col: root.columns == 3 ? 2 : 0; colspan: root.columns == 2 ? 2 : 1;
                            width: root.columns == 2 ? root.controls-width : (root.controls-width - (root.columns - 1) * 18px) / root.columns;
                            horizontal-stretch: 1; title: "3 · ÂM THANH & TỤNG NIỆM";
                            HorizontalLayout {
                                spacing: 12px; min-width: 0px;
                                TempleToggle { label: "Tiếng gõ mõ"; checked: StudioLive.cd-mo-enabled; horizontal-stretch: 1; toggled => { StudioLive.cd-mo-enabled = !StudioLive.cd-mo-enabled; StudioLive.cd-settings(); } }
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 6px;
                                    Text { text: "Nhịp mõ: " + StudioLive.cd-bpm + " BPM"; color: TemplePalette.muted; font-size: 13px; wrap: word-wrap; }
                                    TempleSlider { value: StudioLive.cd-bpm; edited(value) => { StudioLive.cd-bpm = value; StudioLive.cd-settings(); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px; min-width: 0px;
                                TempleToggle { label: "Nhạc thiền"; checked: StudioLive.cd-music-enabled; horizontal-stretch: 1; toggled => { StudioLive.cd-music-enabled = !StudioLive.cd-music-enabled; StudioLive.cd-settings(); } }
                                TempleToggle { label: "Tự đọc kinh định kỳ"; checked: StudioLive.cd-chant-enabled; horizontal-stretch: 1; toggled => { StudioLive.cd-chant-enabled = !StudioLive.cd-chant-enabled; StudioLive.cd-settings(); } }
                            }
                            HorizontalLayout {
                                spacing: 12px; min-width: 0px;
                                TempleSelect { label: "Giọng đọc AI (Edge TTS)"; options: ["Nam Minh (Giọng Nam Trầm Ấm)", "Hoài My (Giọng Nữ Nhẹ Nhàng)"]; current: StudioLive.cd-voice-index; horizontal-stretch: 1; selected(index) => { StudioLive.cd-voice-index = index; StudioLive.cd-settings(); } }
                                TempleSelect { label: "Sức chứa"; options: ["Tự động (24 → 100)", "24 chỗ", "36 chỗ", "64 chỗ", "100 chỗ"]; current: StudioLive.cd-seats-index; horizontal-stretch: 1; selected(index) => { StudioLive.cd-seats-index = index; StudioLive.cd-settings(); } }
                            }
                            FlexboxLayout {
                                spacing: 8px; min-width: 0px;
                                TempleButton { label: "Gõ mõ 1 tiếng"; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("mo", "", "", 0); } }
                                TempleButton { label: "Đọc kinh ngay"; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("chant", "", "", 0); } }
                                TempleButton { label: "🔔 Gõ chuông"; compact: true; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("bell", "", "", 0); } }
                            }
                            Text { text: "Âm thanh được phát bởi overlay. Chỉ bật preview khi cần nghe thử."; color: TemplePalette.muted; font-size: 11px; wrap: word-wrap; }
                        }
                    }
                    TempleCard {
                        FlexboxLayout {
                            min-width: 0px; spacing: 7px;
                            TempleButton { label: "📜 Nhật Ký Sự Kiện"; compact: true; active: StudioLive.cd-bottom-tab == 0; clicked => { StudioLive.cd-bottom-tab = 0; } }
                            TempleButton { label: "🤖 Avatar & Nhân Vật AI"; compact: true; active: StudioLive.cd-bottom-tab == 1; clicked => { StudioLive.cd-bottom-tab = 1; if !StudioPromaxAvatars.loaded && !StudioPromaxAvatars.busy { StudioPromaxAvatars.refresh(); } } }
                            TempleButton { label: "🛍 Sản Phẩm & Giỏ Hàng"; compact: true; active: StudioLive.cd-bottom-tab == 2; clicked => { StudioLive.cd-bottom-tab = 2; StudioProducts.open = true; if !StudioProducts.loaded && !StudioProducts.busy { StudioProducts.load(); } } }
                            TempleButton { label: "📖 Kịch Bản & Lời Đọc AI"; compact: true; active: StudioLive.cd-bottom-tab == 3; clicked => { StudioLive.cd-bottom-tab = 3; } }
                            TempleButton { label: "Điều phối LIVE & LiveBrain"; compact: true; active: StudioLive.cd-bottom-tab == 4; clicked => { StudioLive.cd-bottom-tab = 4; } }
                            Text { text: StudioLive.kedi-available ? "● LiveBrain: " + StudioLive.kedi-state : "● LiveBrain chưa khởi động"; color: StudioLive.kedi-state == "Live" ? #34d399 : TemplePalette.muted; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                        }
                        if StudioLive.cd-bottom-tab == 0: TempleEventLog { }
                        if StudioLive.cd-bottom-tab == 1: VerticalLayout {
                            spacing: 12px;
                            Text { text: "Hình tướng bồ đoàn trong cảnh Chánh Điện"; color: TemplePalette.muted; font-size: 13px; wrap: word-wrap; }
                            FlexboxLayout {
                                spacing: 8px; min-width: 0px;
                                for skin[index] in ["Sư Thầy", "Chú Tiểu", "Ni Cô", "Bà", "Nam", "Nữ"]: TempleButton { label: skin; compact: true; enabled: StudioLive.cd-connected; clicked => { StudioLive.cd-action("skin", "", index == 0 ? "monk" : index == 1 ? "child" : index == 2 ? "nun" : index == 3 ? "granny" : index == 4 ? "man" : "woman", 0); } }
                            }
                            // Use the real Concat avatar library and its existing creation route.
                            PromaxAvatarPicker { temple: true; }
                            TempleButton { label: "Mở thư viện & tạo nhân vật AI"; clicked => { root.manage-avatars(); } }
                        }
                        if StudioLive.cd-bottom-tab == 2: VerticalLayout {
                            spacing: 12px;
                            TempleProductsPanel { }
                            FlexboxLayout {
                                spacing: 8px; min-width: 0px;
                                TempleButton { label: "📌 Ghim sản phẩm lên overlay"; enabled: StudioLive.cd-connected && StudioProducts.active-title != ""; clicked => { StudioLive.cd-action("pin", StudioProducts.active-title, StudioProducts.active-price, 0); } }
                                TempleButton { label: "📢 Đọc sản phẩm đang chọn"; enabled: StudioLive.cd-connected && StudioLive.pinned-script != ""; clicked => { StudioLive.cd-action("say", "", StudioLive.pinned-script, 0); } }
                            }
                        }
                        if StudioLive.cd-bottom-tab == 3: VerticalLayout {
                            spacing: 12px;
                            TempleField { label: "Nội dung lời đọc / kịch bản cầu an"; value: StudioLive.cd-script-text; multiline: true; edited(value) => { StudioLive.cd-script-text = value; } }
                            FlexboxLayout {
                                spacing: 8px; min-width: 0px;
                                TempleButton { label: "🔊 AI đọc kịch bản ngay"; tone: 1; enabled: StudioLive.cd-connected && StudioLive.cd-script-text != ""; clicked => { StudioLive.cd-action("say", "", StudioLive.cd-script-text, 0); } }
                                TempleButton { label: "⏹ Dừng phát giọng"; tone: 2; enabled: StudioLive.cd-connected || StudioLive.is-speaking; clicked => { StudioLive.cd-action("stop", "", "", 0); if StudioLive.is-speaking { StudioLive.interrupt-speech(); } } }
                                TempleButton { label: "Thư viện kịch bản Concat"; clicked => { root.manage-scripts(); } }
                            }
                            Text { text: "Giọng đọc dùng lựa chọn Edge TTS ở bảng Âm thanh. Điều phối AI, giọng mẫu và tự động giới thiệu sản phẩm nằm ở tab Điều phối LIVE & LiveBrain."; color: TemplePalette.muted; font-size: 12px; wrap: word-wrap; }
                        }
                        if StudioLive.cd-bottom-tab == 4: LegacyLivePage {
                            viewport-width: root.controls-width - 36px; viewport-height: root.viewport-height;
                            configure-ai => { root.configure-ai(); }
                            configure-services => { root.configure-services(); }
                            manage-avatars => { root.manage-avatars(); }
                        }
                    }
                    if !root.inline-preview: TempleButton { label: "Mở preview LIVE dọc 9:16"; tone: 3; clicked => { StudioLive.open-chanh-dien-overlay(); } }
                    FlexboxLayout {
                        spacing: 8px; min-width: 0px;
                        Text { text: StudioLive.cd-origin; color: TemplePalette.muted; font-size: 11px; vertical-alignment: center; }
                        TempleButton { label: "Mở bảng điều khiển web"; compact: true; clicked => { StudioLive.open-chanh-dien(); } }
                    }
                }
            }
            Rectangle {
                width: root.inline-preview ? root.preview-width + 40px : 0px;
                min-height: 0px; visible: root.inline-preview; clip: true;
                background: #06090f;
                VerticalLayout {
                    padding: 18px; spacing: 14px; alignment: start;
                    HorizontalLayout {
                        alignment: space-between; min-width: 0px;
                        Text { text: "MÀN HÌNH PREVIEW (9:16)"; color: TemplePalette.muted; font-size: 12px; font-weight: 700; min-width: 0px; }
                        Text { text: "1080 × 1920"; color: TemplePalette.gold; font-size: 12px; font-weight: 700; }
                    }
                    native-preview := Rectangle {
                        height: root.preview-width * 16 / 9;
                        background: #080d16; border-radius: 15px;
                        border-width: 2px; border-color: #75500b;
                        // The actual overlay WebView owns animation, visitors and audio.
                        // A loading/error state replaces the old static temple imitation.
                        if !StudioLive.cd-preview-loaded: VerticalLayout {
                            padding: 20px; spacing: 14px; alignment: center;
                            Text { text: StudioLive.cd-preview-status; color: TemplePalette.muted; font-size: 13px; wrap: word-wrap; horizontal-alignment: center; }
                            TempleButton { label: "Tải lại preview"; clicked => { StudioLive.cd-reload-preview(); } }
                        }
                    }
                    Text { text: StudioLive.cd-audio-enabled ? "Preview có âm thanh" : "Preview tắt âm · Browser Source OBS độc lập"; color: TemplePalette.muted; font-size: 11px; wrap: word-wrap; }
                }
            }
        }
    }
    Timer {
        interval: 80ms;
        running: StudioLive.cd-page-active;
        triggered => {
            StudioLive.cd-preview-inline = root.inline-preview;
            if root.inline-preview {
                StudioLive.cd-preview-x = native-preview.absolute-position.x + 2px;
                StudioLive.cd-preview-y = native-preview.absolute-position.y + 2px;
                StudioLive.cd-preview-width = native-preview.width - 4px;
                StudioLive.cd-preview-height = native-preview.height - 4px;
            }
        }
    }
}
