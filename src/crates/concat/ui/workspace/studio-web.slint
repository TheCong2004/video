//! Postiz Child Workspace for Concat Studio.
//! Supports Fast Refresh / HMR in Development Mode and Local Bundle in Production Mode.

import { Floword } from "../theme/floword.slint";
import { StudioButton } from "studio-chrome.slint";

export global StudioWeb {
    in-out property <bool> active;
    in-out property <int> open-request;
    in-out property <bool> loaded: false;
    in-out property <bool> failed: false;
    in-out property <string> status: "Đang khởi tạo Postiz Workspace…";
    in-out property <string> page-title: "NexPulse · Postiz Workspace";
    in-out property <string> mode: "dev"; // "dev" or "prod"
    in-out property <length> frame-x;
    in-out property <length> frame-y;
    in-out property <length> frame-width;
    in-out property <length> frame-height;

    callback reload();
    callback home();
    callback hide-native();
}

export component StudioWebPage inherits Rectangle {
    background: Floword.ground;

    // Native Child Viewport Host (Seamless edge-to-edge layout, unified background)
    native-frame := Rectangle {
        width: 100%;
        height: 100%;
        background: Floword.ground;
        clip: true;

        if !StudioWeb.loaded: Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: Floword.ground;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        border-width: 2px;
                        border-color: Floword.accent;
                    }
                }

                Text {
                    text: StudioWeb.failed 
                        ? "Không thể kết nối tới Postiz. Vui lòng kiểm tra server rồi thử lại."
                        : "Đang tải giao diện Postiz...";
                    color: StudioWeb.failed ? Floword.danger : Floword.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    Timer {
        interval: 50ms;
        running: StudioWeb.active;
        triggered => {
            StudioWeb.frame-x = native-frame.absolute-position.x;
            StudioWeb.frame-y = native-frame.absolute-position.y;
            StudioWeb.frame-width = native-frame.width;
            StudioWeb.frame-height = native-frame.height;
        }
    }
}
