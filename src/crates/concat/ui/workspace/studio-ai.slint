import { I18n } from "../i18n.slint";
import { Floword } from "../theme/floword.slint";
import { Select } from "../primitives/primitives.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField } from "studio-chrome.slint";

export struct StudioProviderRow {
    id: string,
    name: string,
    provider: string,
    active: bool,
    model: string,
}

export global StudioAi {
    in-out property <string> backend-origin: "OmniRoute local";
    in-out property <[StudioProviderRow]> providers;
    in-out property <[string]> models;
    in-out property <int> model-index;
    in-out property <bool> busy;
    in-out property <bool> providers-loaded;
    in-out property <bool> models-loaded;
    in-out property <string> status;
    in-out property <string> prompt: "Viết kịch bản ngắn 3 cảnh về phong cảnh mùa thu";
    in-out property <string> answer;
    in-out property <string> answered-model;
    in-out property <string> test-id;
    in-out property <string> test-model;
    in-out property <bool> confirm-ask;
    in-out property <bool> new-open;
    in-out property <string> new-provider;
    in-out property <string> new-name;
    in-out property <string> new-key;
    in-out property <string> new-model;
    in-out property <string> delete-id;
    in-out property <string> change-id;
    in-out property <bool> change-active;
    in-out property <bool> copied-key: false;
    in-out property <bool> copied-endpoint: false;
    in-out property <int> zoom-percent: 90;

    callback load-providers();
    callback load-models();
    callback test-connection();
    callback ask();
    callback add-provider();
    callback change-provider();
    callback delete-provider();
    callback open-dashboard();
    callback copy-master-key();
    callback copy-master-endpoint();
    callback quick-add(string);
}

export component StudioAiPage inherits VerticalLayout {
    callback account();
    private property <bool> advanced-open;
    private property <bool> try-open;
    private property <bool> quick-options-open;
    private property <bool> new-advanced-open;
    spacing: 16px;
    min-width: 0px;
    init => {
        if !StudioAi.providers-loaded && !StudioAi.busy { StudioAi.load-providers(); }
    }

    StudioHeading { title: "Kết nối AI"; }
    if StudioAi.busy || StudioAi.status != "": Text {
        text: StudioAi.busy ? "Đang xử lý…" : StudioAi.status;
        color: Floword.muted; wrap: word-wrap;
    }

    if !StudioAi.new-open: StudioCard {
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Dịch vụ của bạn"; color: Floword.text; font-weight: 700; horizontal-stretch: 1; }
            StudioButton { label: "Làm mới"; compact: true; enabled: !StudioAi.busy; clicked => { StudioAi.load-providers(); } }
        }
        if StudioAi.providers-loaded && StudioAi.providers.length == 0: Text {
            text: "Chưa có kết nối AI. Chọn dịch vụ để thêm khóa của bạn.";
            color: Floword.muted; wrap: word-wrap;
        }
        if !StudioAi.providers-loaded && !StudioAi.busy: Text {
            text: "Chưa tải được kết nối. Bấm Làm mới để thử lại.";
            color: Floword.warning; wrap: word-wrap;
        }
        for provider in StudioAi.providers: VerticalLayout {
            spacing: 8px;
            Rectangle { height: 1px; background: Floword.line; }
            Text { text: provider.name == "" ? provider.provider : provider.name; color: Floword.text; font-size: 15px; font-weight: 700; wrap: word-wrap; }
            Text { text: provider.provider + " · " + (provider.active ? "Đang bật" : "Đã tắt") + (provider.model != "" ? " · " + provider.model : ""); color: Floword.muted; wrap: word-wrap; font-size: 12px; }
            FlexboxLayout {
                spacing: 8px;
                StudioButton { label: "Kiểm tra"; compact: true; enabled: !StudioAi.busy; clicked => { StudioAi.test-id = provider.id; StudioAi.test-model = provider.model; } }
                StudioButton { label: provider.active ? "Tắt" : "Bật"; compact: true; enabled: !StudioAi.busy; clicked => { StudioAi.change-id = provider.id; StudioAi.change-active = !provider.active; StudioAi.change-provider(); } }
                StudioButton { label: "Xóa"; compact: true; enabled: !StudioAi.busy; clicked => { StudioAi.delete-id = provider.id; } }
            }
        }
        StudioButton { label: "Thêm kết nối"; primary: true; enabled: !StudioAi.busy; clicked => { root.new-advanced-open = false; StudioAi.quick-add("gemini"); } }
        StudioButton { label: root.quick-options-open ? "Ẩn thêm nhanh" : "Thêm nhanh theo dịch vụ"; compact: true; enabled: !StudioAi.busy; clicked => { root.quick-options-open = !root.quick-options-open; } }
        if root.quick-options-open: FlexboxLayout {
            spacing: 8px;
            StudioButton { label: "+ Gemini"; compact: true; enabled: !StudioAi.busy; clicked => { StudioAi.quick-add("gemini"); } }
            StudioButton { label: "+ OpenAI"; compact: true; enabled: !StudioAi.busy; clicked => { StudioAi.quick-add("openai"); } }
            StudioButton { label: "+ Claude"; compact: true; enabled: !StudioAi.busy; clicked => { StudioAi.quick-add("anthropic"); } }
            StudioButton { label: "+ Grok"; compact: true; enabled: !StudioAi.busy; clicked => { StudioAi.quick-add("grok"); } }
            StudioButton { label: "+ DeepSeek"; compact: true; enabled: !StudioAi.busy; clicked => { StudioAi.quick-add("deepseek"); } }
        }
    }

    if StudioAi.new-open: StudioCard {
        StudioHeading { title: "Thêm kết nối"; }
        Text { text: "Dịch vụ"; color: Floword.text; font-size: 13px; font-weight: 600; }
        Select {
            options: ["Google Gemini", "OpenAI", "Claude", "Grok", "DeepSeek", "Ollama · trên máy", "Khác"];
            current: StudioAi.new-provider == "gemini" ? 0 : StudioAi.new-provider == "openai" ? 1 : StudioAi.new-provider == "anthropic" ? 2 : StudioAi.new-provider == "grok" ? 3 : StudioAi.new-provider == "deepseek" ? 4 : StudioAi.new-provider == "ollama" ? 5 : 6;
            enabled: !StudioAi.busy;
            changed(index) => {
                StudioAi.new-provider = index == 0 ? "gemini" : index == 1 ? "openai" : index == 2 ? "anthropic" : index == 3 ? "grok" : index == 4 ? "deepseek" : index == 5 ? "ollama" : "";
                if index == 6 { root.new-advanced-open = true; }
            }
        }
        StudioField { label: "Tên kết nối"; placeholder: "Ví dụ: Gemini của tôi"; value: StudioAi.new-name; enabled: !StudioAi.busy; edited(text) => { StudioAi.new-name = text; } }
        StudioField { label: "Khóa API"; secret: true; placeholder: "Dán khóa của bạn"; value: StudioAi.new-key; enabled: !StudioAi.busy; edited(text) => { StudioAi.new-key = text; } }
        Text { text: "Khóa được mã hóa trên máy."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
        StudioButton { label: root.new-advanced-open ? "Thu gọn tùy chọn" : "Tùy chọn nâng cao"; compact: true; clicked => { root.new-advanced-open = !root.new-advanced-open; } }
        if root.new-advanced-open: VerticalLayout {
            spacing: 10px;
            StudioField { label: "Mã dịch vụ · dành cho kết nối tùy chỉnh"; value: StudioAi.new-provider; enabled: !StudioAi.busy; edited(text) => { StudioAi.new-provider = text; } }
            StudioField { label: "Model mặc định · không bắt buộc"; value: StudioAi.new-model; enabled: !StudioAi.busy; edited(text) => { StudioAi.new-model = text; } }
        }
        FlexboxLayout {
            spacing: 8px;
            StudioButton { label: "Lưu kết nối"; primary: true; enabled: !StudioAi.busy && StudioAi.new-key != "" && StudioAi.new-provider != "" && StudioAi.new-name != ""; clicked => { StudioAi.add-provider(); } }
            StudioButton { label: "Hủy"; enabled: !StudioAi.busy; clicked => { StudioAi.new-key = ""; StudioAi.new-open = false; } }
        }
    }

    if StudioAi.test-id != "": StudioCard {
        StudioHeading { title: "Kiểm tra kết nối"; }
        StudioField { label: "Model"; value: StudioAi.test-model; enabled: !StudioAi.busy; edited(text) => { StudioAi.test-model = text; } }
        Text { text: "Gửi một yêu cầu AI thật, có thể dùng hạn mức hoặc tính phí."; color: Floword.warning; wrap: word-wrap; }
        FlexboxLayout {
            spacing: 8px;
            StudioButton { label: "Xác nhận kiểm tra"; primary: true; enabled: !StudioAi.busy; clicked => { StudioAi.test-connection(); } }
            StudioButton { label: "Hủy"; enabled: !StudioAi.busy; clicked => { StudioAi.test-id = ""; } }
        }
    }
    if StudioAi.delete-id != "": StudioCard {
        StudioHeading { title: "Xóa kết nối này?"; }
        Text { text: "Khóa của kết nối sẽ không còn được dùng trong ứng dụng."; color: Floword.warning; wrap: word-wrap; }
        FlexboxLayout {
            spacing: 8px;
            StudioButton { label: "Xác nhận xóa"; enabled: !StudioAi.busy; clicked => { StudioAi.delete-provider(); } }
            StudioButton { label: "Giữ lại"; enabled: !StudioAi.busy; clicked => { StudioAi.delete-id = ""; } }
        }
    }

    StudioCard {
        StudioHeading { title: "Model AI"; }
        Text { text: StudioAi.models.length > 0 ? StudioAi.models.length + " model đã tải" : "Tải model để dùng AI trong dự án và LIVE."; color: Floword.muted; wrap: word-wrap; }
        if StudioAi.models.length > 0: Select {
            options: StudioAi.models; current <=> StudioAi.model-index;
            enabled: !StudioAi.busy;
            changed(index) => { StudioAi.confirm-ask = false; }
        }
        StudioButton { label: StudioAi.models-loaded ? "Làm mới model" : "Tải model"; enabled: !StudioAi.busy; clicked => { StudioAi.load-models(); } }
        StudioButton { label: root.try-open ? "Thu gọn thử AI" : "Thử AI"; compact: true; clicked => { root.try-open = !root.try-open; } }
        if root.try-open || StudioAi.confirm-ask: VerticalLayout {
            spacing: 10px;
            StudioField { label: "Yêu cầu thử"; value: StudioAi.prompt; multiline: true; enabled: !StudioAi.busy; edited(text) => { StudioAi.prompt = text; StudioAi.confirm-ask = false; } }
            if !StudioAi.confirm-ask: StudioButton { label: "Gửi yêu cầu"; primary: true; enabled: !StudioAi.busy && StudioAi.models.length > 0 && StudioAi.prompt != ""; clicked => { StudioAi.confirm-ask = true; } }
        }
        if StudioAi.confirm-ask: VerticalLayout {
            spacing: 8px;
            Text { text: "Yêu cầu thật có thể dùng hạn mức hoặc tính phí. Model có trong danh sách không đảm bảo khóa còn hạn mức."; color: Floword.warning; wrap: word-wrap; }
            FlexboxLayout {
                spacing: 8px;
                StudioButton { label: "Xác nhận gửi"; primary: true; enabled: !StudioAi.busy; clicked => { StudioAi.ask(); } }
                StudioButton { label: "Hủy"; enabled: !StudioAi.busy; clicked => { StudioAi.confirm-ask = false; } }
            }
        }
        if StudioAi.answer != "": VerticalLayout {
            spacing: 8px;
            Text { text: StudioAi.answered-model; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
            Text { text: StudioAi.answer; color: Floword.text; wrap: word-wrap; }
        }
    }
    StudioButton { label: root.advanced-open ? "Thu gọn kết nối nâng cao" : "Kết nối nâng cao"; compact: true; clicked => { root.advanced-open = !root.advanced-open; } }
    if root.advanced-open: StudioCard {
        Text { text: StudioAi.backend-origin; color: Floword.muted; wrap: word-wrap; }
        FlexboxLayout {
            spacing: 8px;
            StudioButton { label: "Thông tin khóa kết nối"; compact: true; clicked => { StudioAi.copy-master-key(); } }
            StudioButton { label: "Thông tin địa chỉ"; compact: true; clicked => { StudioAi.copy-master-endpoint(); } }
            StudioButton { label: "Tải danh sách model"; compact: true; clicked => { StudioAi.open-dashboard(); } }
        }
    }
}
