import { I18n } from "../i18n.slint";
import { Floword } from "../theme/floword.slint";
import { Select } from "../primitives/primitives.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField } from "studio-chrome.slint";

export global StudioBrowser {
    in-out property <[string]> ids;
    in-out property <[string]> names;
    in-out property <int> index;
    in-out property <bool> busy;
    in-out property <bool> loaded;
    in-out property <string> status;
    in-out property <bool> confirm-open;
    in-out property <bool> confirm-stop;
    in-out property <string> api-origin: "http://127.0.0.1:10108";
    in-out property <string> executable;
    in-out property <string> new-token;
    in-out property <bool> token-present;
    callback refresh();
    callback start();
    callback choose-executable();
    callback save-connection();
    callback forget-token();
    callback open-grok();
    callback stop-profile();
}

export component StudioBrowserPanel inherits StudioCard {
    property <bool> advanced: false;
    property <bool> confirm-forget: false;
    min-width: 0px;
    StudioHeading { title: "Trình duyệt Nexora"; }
    Text { text: "Chọn hồ sơ trình duyệt để mở Grok. Đây là kết nối riêng, không thay đổi trình duyệt mặc định của máy."; color: Floword.muted; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 8px; height: 8px; border-radius: 4px;
            background: StudioBrowser.loaded ? Floword.success : Floword.line-bright;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: StudioBrowser.busy ? "Đang xử lý…" : StudioBrowser.loaded
                ? "Đã tải " + StudioBrowser.names.length + " hồ sơ"
                : "Chưa kiểm tra kết nối";
            color: Floword.text; font-size: 13px; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1;
        }
    }
    FlexboxLayout {
        spacing: 8px;
        StudioButton { label: "Khởi động & kết nối"; primary: !StudioBrowser.loaded; enabled: !StudioBrowser.busy; clicked => { StudioBrowser.start(); } }
        StudioButton { label: "Tải lại hồ sơ"; enabled: !StudioBrowser.busy; clicked => { StudioBrowser.refresh(); } }
    }
    if StudioBrowser.names.length > 0: Select {
        options: StudioBrowser.names; current <=> StudioBrowser.index;
        placeholder: I18n.t("studioBrowser.choose"); height: 40px;
        background: Floword.field; border-color: Floword.line; enabled: !StudioBrowser.busy;
        changed(index) => { StudioBrowser.confirm-open = false; StudioBrowser.confirm-stop = false; }
    }
    if StudioBrowser.loaded && StudioBrowser.names.length == 0: Text { text: I18n.t("studioBrowser.empty"); color: Floword.warning; wrap: word-wrap; }
    if StudioBrowser.busy || StudioBrowser.status != "": Text { text: StudioBrowser.busy ? I18n.t("studioBrowser.waiting") : StudioBrowser.status; color: Floword.warning; wrap: word-wrap; }
    if StudioBrowser.loaded: Text { text: "Đã đọc hồ sơ không có nghĩa là đã đăng nhập Grok hoặc sẵn sàng tạo video."; color: Floword.muted; wrap: word-wrap; }
    if StudioBrowser.names.length > 0: FlexboxLayout {
        spacing: 12px;
        StudioButton { label: "Mở Grok bằng hồ sơ đã chọn"; primary: true; enabled: !StudioBrowser.busy; clicked => { StudioBrowser.confirm-open = true; StudioBrowser.confirm-stop = false; } }
        StudioButton { label: "Dừng hồ sơ"; enabled: !StudioBrowser.busy; clicked => { StudioBrowser.confirm-stop = true; StudioBrowser.confirm-open = false; } }
    }
    if StudioBrowser.confirm-open || StudioBrowser.confirm-stop: VerticalLayout {
        spacing: 10px;
        Text { text: StudioBrowser.confirm-stop ? I18n.t("studioBrowser.confirmStop") : I18n.t("studioBrowser.confirmOpen"); color: Floword.warning; wrap: word-wrap; }
        StudioButton { label: StudioBrowser.confirm-stop ? "Xác nhận dừng hồ sơ" : "Xác nhận mở Grok"; enabled: !StudioBrowser.busy; clicked => { if StudioBrowser.confirm-stop { StudioBrowser.stop-profile(); } else { StudioBrowser.open-grok(); } } }
        StudioButton { label: I18n.t("common.cancel"); enabled: !StudioBrowser.busy; clicked => { StudioBrowser.confirm-open = false; StudioBrowser.confirm-stop = false; } }
    }
    StudioButton { label: root.advanced ? "Thu gọn cài đặt kết nối" : "Cài đặt kết nối…"; clicked => { root.advanced = !root.advanced; } }
    if root.advanced: VerticalLayout {
        spacing: 10px;
        min-width: 0px;
        StudioField { label: "Địa chỉ API Nexora"; value: StudioBrowser.api-origin; placeholder: "http://127.0.0.1:10108"; enabled: !StudioBrowser.busy; edited(text) => { StudioBrowser.api-origin = text; } }
        StudioField { label: "Đường dẫn Nexora"; value: StudioBrowser.executable; placeholder: "Để trống để dò tìm trên máy"; enabled: !StudioBrowser.busy; edited(text) => { StudioBrowser.executable = text; } }
        StudioButton { label: "Chọn tệp Nexora…"; enabled: !StudioBrowser.busy; clicked => { StudioBrowser.choose-executable(); } }
        StudioField { label: StudioBrowser.token-present ? "Token mới · đã có token mã hóa" : "Token API · nếu Nexora yêu cầu"; value: StudioBrowser.new-token; secret: true; enabled: !StudioBrowser.busy; edited(text) => { StudioBrowser.new-token = text; } }
        Text { text: "Token được lưu mã hóa trên máy. Lưu cấu hình không kiểm tra kết nối; sau khi lưu, chọn Tải lại hồ sơ."; color: Floword.muted; wrap: word-wrap; }
        StudioButton { label: "Lưu cấu hình"; primary: true; enabled: !StudioBrowser.busy; clicked => { root.confirm-forget = false; StudioBrowser.confirm-open = false; StudioBrowser.confirm-stop = false; StudioBrowser.save-connection(); } }
        if StudioBrowser.token-present: StudioButton { label: "Quên token đã lưu…"; enabled: !StudioBrowser.busy; clicked => { root.confirm-forget = true; } }
        if root.confirm-forget: VerticalLayout {
            spacing: 8px;
            Text { text: "Xóa token khỏi cấu hình Concat? Bạn có thể cần nhập lại để kết nối Nexora."; color: Floword.warning; wrap: word-wrap; }
            StudioButton { label: "Xác nhận quên token"; enabled: !StudioBrowser.busy; clicked => { root.confirm-forget = false; StudioBrowser.forget-token(); } }
            StudioButton { label: "Hủy"; enabled: !StudioBrowser.busy; clicked => { root.confirm-forget = false; } }
        }
    }
}
