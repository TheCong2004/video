import { I18n } from "../i18n.slint";
import { Floword } from "../theme/floword.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField } from "studio-chrome.slint";

export struct StudioProductRow {
    index: int, title: string, price: string, enabled: bool, active: bool,
}
export global StudioProducts {
    in-out property <[StudioProductRow]> rows;
    in-out property <bool> open;
    in-out property <bool> loaded;
    in-out property <bool> busy;
    in-out property <bool> dirty;
    in-out property <bool> uncertain;
    in-out property <bool> editing;
    in-out property <int> edit-index: -1;
    in-out property <int> delete-index: -1;
    in-out property <string> status;
    in-out property <string> active-title;
    in-out property <string> active-price;
    in-out property <string> title;
    in-out property <string> price;
    in-out property <string> script;
    in-out property <string> duration: "180";
    in-out property <bool> enabled: true;
    callback load();
    callback discard();
    callback new-product();
    callback edit(index: int);
    callback apply();
    callback remove(index: int);
    callback save();
    callback select-product(index: int);
    callback next-product();
}

export component StudioProductsPanel inherits StudioCard {
    HorizontalLayout {
        spacing: 12px;
        StudioHeading { title: I18n.t("studioProducts.title"); }
        Rectangle { horizontal-stretch: 1; }
        StudioButton {
            label: StudioProducts.open ? I18n.t("studioProducts.hide") : I18n.t("studioProducts.manage");
            clicked => { StudioProducts.open = !StudioProducts.open; }
        }
    }
    Text {
        text: StudioProducts.active-title == "" ? I18n.t("studioProducts.noSelection")
            : StudioProducts.active-title + " · " + StudioProducts.active-price;
        color: StudioProducts.active-title == "" ? Floword.muted : Floword.success;
        wrap: word-wrap;
    }
    if StudioProducts.open: VerticalLayout {
        spacing: 12px;
        Text { text: I18n.t("studioProducts.scope"); color: Floword.muted; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            StudioButton { label: I18n.t("studioProducts.load"); enabled: !StudioProducts.busy && !StudioProducts.dirty && !StudioProducts.editing; clicked => { StudioProducts.load(); } }
            StudioButton { label: I18n.t("studioProducts.add"); enabled: StudioProducts.loaded && !StudioProducts.busy && !StudioProducts.editing && !StudioProducts.uncertain && StudioProducts.rows.length < 200; clicked => { StudioProducts.new-product(); } }
            StudioButton { label: I18n.t("studioProducts.save"); primary: true; enabled: StudioProducts.dirty && !StudioProducts.busy && !StudioProducts.editing && !StudioProducts.uncertain; clicked => { StudioProducts.save(); } }
            StudioButton { label: I18n.t("studioProducts.next"); enabled: StudioProducts.loaded && !StudioProducts.busy && !StudioProducts.dirty && !StudioProducts.editing && !StudioProducts.uncertain; clicked => { StudioProducts.next-product(); } }
        }
        if StudioProducts.dirty || StudioProducts.uncertain: StudioButton {
            label: I18n.t("studioProducts.discard"); enabled: !StudioProducts.busy;
            clicked => { StudioProducts.discard(); }
        }
        Text { text: StudioProducts.busy ? I18n.t("studioLive.working") : StudioProducts.status; color: Floword.warning; wrap: word-wrap; }
        if StudioProducts.loaded && StudioProducts.rows.length == 0: Text { text: I18n.t("studioProducts.empty"); color: Floword.muted; wrap: word-wrap; }
        for product in StudioProducts.rows: VerticalLayout {
            spacing: 6px;
            Text { text: product.title + " · " + product.price; color: product.active ? Floword.success : Floword.text; font-weight: 600; wrap: word-wrap; }
            Text { text: product.enabled ? I18n.t("studioProducts.enabled") : I18n.t("studioProducts.disabled"); color: Floword.muted; }
            HorizontalLayout {
                spacing: 8px;
                StudioButton { label: I18n.t("studioProducts.edit"); enabled: !StudioProducts.busy && !StudioProducts.editing && !StudioProducts.uncertain; clicked => { StudioProducts.edit(product.index); } }
                StudioButton { label: I18n.t("studioProducts.select"); enabled: !StudioProducts.busy && !StudioProducts.editing && !StudioProducts.dirty && !StudioProducts.uncertain && product.enabled; clicked => { StudioProducts.select-product(product.index); } }
                StudioButton { label: I18n.t("studioProducts.remove"); enabled: !StudioProducts.busy && !StudioProducts.editing && !StudioProducts.uncertain; clicked => { StudioProducts.delete-index = product.index; } }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { height: 1px; background: Floword.line; }
        }
        if StudioProducts.delete-index >= 0: VerticalLayout {
            Text { text: I18n.t("studioProducts.confirmRemove"); color: Floword.warning; wrap: word-wrap; }
            HorizontalLayout {
                StudioButton { label: I18n.t("studioProducts.remove"); enabled: !StudioProducts.busy; clicked => { StudioProducts.remove(StudioProducts.delete-index); } }
                StudioButton { label: I18n.t("common.cancel"); clicked => { StudioProducts.delete-index = -1; } }
            }
        }
        if StudioProducts.editing: VerticalLayout {
            spacing: 10px;
            StudioField { label: I18n.t("studioProducts.name"); value: StudioProducts.title; edited(text) => { StudioProducts.title = text; } }
            HorizontalLayout {
                spacing: 12px;
                StudioField { label: I18n.t("studioProducts.price"); value: StudioProducts.price; edited(text) => { StudioProducts.price = text; } }
                StudioField { label: I18n.t("studioProducts.duration"); value: StudioProducts.duration; edited(text) => { StudioProducts.duration = text; } }
            }
            StudioField { label: I18n.t("studioProducts.script"); multiline: true; value: StudioProducts.script; edited(text) => { StudioProducts.script = text; } }
            StudioButton { label: StudioProducts.enabled ? I18n.t("studioProducts.enabled") : I18n.t("studioProducts.disabled"); clicked => { StudioProducts.enabled = !StudioProducts.enabled; } }
            HorizontalLayout {
                StudioButton { label: I18n.t("studioProducts.apply"); primary: true; clicked => { StudioProducts.apply(); } }
                StudioButton { label: I18n.t("common.cancel"); clicked => { StudioProducts.editing = false; } }
            }
        }
    }
}
