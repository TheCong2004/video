// Native form translated from FlowordStudio/ProductionPipelineView.tsx.
import { I18n } from "../i18n.slint";
import { Select, NumberField } from "../primitives/primitives.slint";
import { Floword } from "../theme/floword.slint";
import { Glyph, Icon } from "../icons.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField, StudioMetric } from "studio-chrome.slint";
import { StudioBrowserPanel } from "studio-browser.slint";

export struct StudioRunRow {
    id: string,
    workflow: string,
    status: string,
    node: string,
    created: string,
    completed: int,
    total: int,
}

export global ProductionStudio {
    in-out property <[string]> workflow-ids;
    in-out property <[string]> workflow-names;
    in-out property <int> workflow-index;
    in-out property <string> brief;
    in-out property <string> sources;
    in-out property <float> scenes: 6;
    in-out property <float> duration: 60;
    in-out property <string> character-anchor;
    in-out property <string> visual-style;
    in-out property <string> motion-prompt;
    in-out property <int> visual-engine-index: 0;
    in-out property <[string]> visual-engine-options: ["OmniRoute Video (AI Native)", "Grok Web Automation", "FAL Fast Generation"];
    in-out property <int> current-phase: 1;
    in-out property <string> extra-inputs: "{}";
    in-out property <bool> busy;
    in-out property <bool> ready;
    in-out property <bool> uncertain;
    in-out property <bool> confirm-start;
    in-out property <string> status;
    in-out property <string> active-run;
    in-out property <[StudioRunRow]> runs;
    in-out property <[StudioRunRow]> history-runs;
    in-out property <bool> runs-loaded;
    in-out property <string> cancel-id;
    in-out property <string> resume-id;
    callback load-runs();
    callback check-plan();
    callback start-run();
    callback cancel-run(id: string);
    callback resume-run(id: string);
    public function invalidate() { self.ready = false; self.confirm-start = false; }
}

export component StudioRunList inherits VerticalLayout {
    in property <bool> history-only;
    spacing: 12px;
    HorizontalLayout {
        StudioHeading { title: root.history-only ? I18n.t("nativeStudio.history") : I18n.t("nativeStudio.jobs"); }
        StudioButton { label: I18n.t("nativeStudio.refresh"); enabled: !ProductionStudio.busy; clicked => { ProductionStudio.load-runs(); } }
    }
    if ProductionStudio.runs-loaded && (root.history-only ? ProductionStudio.history-runs.length : ProductionStudio.runs.length) == 0: StudioCard {
        Text { text: I18n.t("nativeStudio.noRuns"); color: Floword.muted; wrap: word-wrap; }
    }
    if !ProductionStudio.runs-loaded: StudioCard {
        Text { text: I18n.t("nativeStudio.loadRunsHint"); color: Floword.muted; wrap: word-wrap; }
    }
    for run in (root.history-only ? ProductionStudio.history-runs : ProductionStudio.runs): StudioCard {
        VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                Text { text: run.workflow; color: Floword.text; font-size: 18px; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; }
                Rectangle {
                    background: run.status == "completed" ? Floword.success.with-alpha(0.18)
                        : run.status == "failed" ? Floword.danger.with-alpha(0.18)
                        : Floword.warning.with-alpha(0.18);
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: run.status == "completed" ? Floword.success.with-alpha(0.3)
                        : run.status == "failed" ? Floword.danger.with-alpha(0.3)
                        : Floword.warning.with-alpha(0.3);
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; padding-top: 2px; padding-bottom: 2px;
                        Text {
                            text: run.status == "completed" ? "Hoàn thành"
                                : run.status == "running" ? "Đang chạy"
                                : run.status == "failed" ? "Thất bại"
                                : run.status;
                            color: run.status == "completed" ? Floword.success : run.status == "failed" ? Floword.danger : Floword.warning;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                }
            }
            Text { text: run.id + " · " + run.created; color: Floword.muted; font-size: 13px; wrap: word-wrap; }
            Text { text: I18n.t2("nativeStudio.stepCount", "\{run.completed}", "\{run.total}") + " · Node: " + run.node; color: Floword.text; font-size: 13px; wrap: word-wrap; }
            if !root.history-only && (run.status == "running" || run.status == "queued" || run.status == "waiting" || run.status == "pending"): HorizontalLayout {
                if run.status == "waiting": StudioButton { label: I18n.t("nativeStudio.resumeJob"); enabled: !ProductionStudio.busy && !ProductionStudio.uncertain; clicked => { ProductionStudio.cancel-id = ""; ProductionStudio.resume-id = run.id; } }
                StudioButton { label: I18n.t("nativeStudio.cancelJob"); enabled: !ProductionStudio.busy; clicked => { ProductionStudio.resume-id = ""; ProductionStudio.cancel-id = run.id; } }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
    if ProductionStudio.cancel-id != "": StudioCard {
        Text { text: I18n.t1("nativeStudio.cancelConfirm", ProductionStudio.cancel-id); color: Floword.warning; wrap: word-wrap; }
        HorizontalLayout {
            StudioButton { label: I18n.t("nativeStudio.confirm"); enabled: !ProductionStudio.busy && !ProductionStudio.uncertain; clicked => { ProductionStudio.cancel-run(ProductionStudio.cancel-id); } }
            StudioButton { label: I18n.t("common.cancel"); enabled: !ProductionStudio.busy; clicked => { ProductionStudio.cancel-id = ""; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if ProductionStudio.resume-id != "": StudioCard {
        Text { text: I18n.t1("nativeStudio.resumeConfirm", ProductionStudio.resume-id); color: Floword.warning; wrap: word-wrap; }
        HorizontalLayout {
            StudioButton { label: I18n.t("nativeStudio.confirm"); primary: true; enabled: !ProductionStudio.busy && !ProductionStudio.uncertain; clicked => { ProductionStudio.resume-run(ProductionStudio.resume-id); } }
            StudioButton { label: I18n.t("common.cancel"); enabled: !ProductionStudio.busy; clicked => { ProductionStudio.resume-id = ""; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component StudioProduction inherits VerticalLayout {
    spacing: 18px;
    property <bool> advanced-open: false;

    // HERO BANNER WITH 3D ILLUSTRATION & BEGINNER GUIDE
    Rectangle {
        height: 160px;
        border-radius: 16px;
        clip: true;
        background: Floword.surface;
        border-width: 1px;
        border-color: Floword.line-bright;

        Image {
            width: 100%;
            height: 100%;
            source: @image-url("../assets/studio-production.jpg");
            image-fit: cover;
        }

        // Dark gradient & glassmorphic overlay for maximum readability
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(90deg, #080D1BEE 0%, #080D1BDD 45%, #080D1B77 75%, #080D1B22 100%);
        }

        HorizontalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 20px;
            padding-bottom: 20px;
            alignment: space-between;

            VerticalLayout {
                spacing: 8px;
                alignment: center;
                max-width: 680px;

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        background: Floword.violet.with-alpha(0.25);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Floword.violet;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            spacing: 6px;
                            Icon { glyph: Glyph.sparkle; size: 12px; tint: Floword.cyan; }
                            Text { text: "XƯỞNG SẢN XUẤT VIDEO AI · 7 CÔNG ĐOẠN"; color: Floword.cyan; font-size: 11px; font-weight: 700; }
                        }
                    }
                }

                Text {
                    text: "Biến ý tưởng thành video điện ảnh hoàn chỉnh";
                    color: Floword.text;
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    text: "Chỉ 3 bước đơn giản: 1. Viết ý tưởng   →   2. Kiểm tra trước khi tạo   →   3. Bắt đầu tạo video";
                    color: Floword.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }

            // Quick status pill
            VerticalLayout {
                alignment: center;
                Rectangle {
                    background: Floword.raised.with-alpha(0.9);
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Floword.line-bright;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        alignment: center;
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "Trạng thái xưởng"; color: Floword.muted; font-size: 11px; }
                            Text {
                                text: ProductionStudio.busy ? "Đang xử lý..." : (ProductionStudio.ready ? "Đã sẵn sàng tạo" : "Đang chờ ý tưởng");
                                color: ProductionStudio.busy ? Floword.warning : (ProductionStudio.ready ? Floword.success : Floword.cyan);
                                font-size: 13px;
                                font-weight: 700;
                            }
                        }
                    }
                }
            }
        }
    }

    // 1. PIPELINE 7-PHASE VISUALIZER RIBBON (Matching ArtCraft ProductionPipelineView)
    Rectangle {
        background: Floword.surface;
        border-radius: 14px;
        border-width: 1px;
        border-color: Floword.line;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px;
                    Icon { glyph: Glyph.film; size: 18px; tint: Floword.violet; }
                    Text { text: "QUY TRÌNH 7 CÔNG ĐOẠN TỰ ĐỘNG"; color: Floword.violet; font-size: 13px; font-weight: 700; }
                }
                Text { text: "Hệ thống AI tự động điều phối từ đầu đến cuối"; color: Floword.muted; font-size: 12px; }
            }

            // Stepper pills with neon accents
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                Rectangle {
                    background: Floword.field; border-radius: 8px; border-width: 1px; border-color: Floword.cyan.with-alpha(0.4); horizontal-stretch: 1;
                    HorizontalLayout { padding: 8px; spacing: 6px; alignment: center;
                        Text { text: "1"; color: Floword.cyan; font-size: 12px; font-weight: 700; }
                        Text { text: "Nguồn & Ý tưởng"; color: Floword.text; font-size: 12px; }
                    }
                }
                Rectangle {
                    background: Floword.field; border-radius: 8px; border-width: 1px; border-color: Floword.line; horizontal-stretch: 1;
                    HorizontalLayout { padding: 8px; spacing: 6px; alignment: center;
                        Text { text: "2"; color: Floword.violet; font-size: 12px; font-weight: 700; }
                        Text { text: "Kịch bản"; color: Floword.text; font-size: 12px; }
                    }
                }
                Rectangle {
                    background: Floword.field; border-radius: 8px; border-width: 1px; border-color: Floword.line; horizontal-stretch: 1;
                    HorizontalLayout { padding: 8px; spacing: 6px; alignment: center;
                        Text { text: "3"; color: Floword.violet; font-size: 12px; font-weight: 700; }
                        Text { text: "Tư liệu"; color: Floword.text; font-size: 12px; }
                    }
                }
                Rectangle {
                    background: Floword.field; border-radius: 8px; border-width: 1px; border-color: Floword.line; horizontal-stretch: 1;
                    HorizontalLayout { padding: 8px; spacing: 6px; alignment: center;
                        Text { text: "4"; color: Floword.violet; font-size: 12px; font-weight: 700; }
                        Text { text: "Nhân vật"; color: Floword.text; font-size: 12px; }
                    }
                }
                Rectangle {
                    background: Floword.field; border-radius: 8px; border-width: 1px; border-color: Floword.line; horizontal-stretch: 1;
                    HorizontalLayout { padding: 8px; spacing: 6px; alignment: center;
                        Text { text: "5"; color: Floword.violet; font-size: 12px; font-weight: 700; }
                        Text { text: "Sinh hình AI"; color: Floword.text; font-size: 12px; }
                    }
                }
                Rectangle {
                    background: Floword.field; border-radius: 8px; border-width: 1px; border-color: Floword.line; horizontal-stretch: 1;
                    HorizontalLayout { padding: 8px; spacing: 6px; alignment: center;
                        Text { text: "6"; color: Floword.violet; font-size: 12px; font-weight: 700; }
                        Text { text: "Lồng tiếng"; color: Floword.text; font-size: 12px; }
                    }
                }
                Rectangle {
                    background: Floword.field; border-radius: 8px; border-width: 1px; border-color: Floword.line; horizontal-stretch: 1;
                    HorizontalLayout { padding: 8px; spacing: 6px; alignment: center;
                        Text { text: "7"; color: Floword.violet; font-size: 12px; font-weight: 700; }
                        Text { text: "Dựng & Xuất"; color: Floword.text; font-size: 12px; }
                    }
                }
            }
        }
    }

    // 2. MAIN PRODUCTION WORKSPACE
    HorizontalLayout {
        spacing: 18px;
        min-width: 0px;

        // LEFT COLUMN: Brief, Character Anchor & Prompts
        StudioCard {
            min-width: 360px;
            horizontal-stretch: 2;
            StudioHeading { title: I18n.t("nativeStudio.briefSection"); glyph: Glyph.text-mark; }
            StudioField {
                label: I18n.t("nativeStudio.brief"); placeholder: I18n.t("nativeStudio.briefExample"); multiline: true;
                value: ProductionStudio.brief; enabled: !ProductionStudio.busy;
                edited(text) => { ProductionStudio.brief = text; ProductionStudio.invalidate(); }
            }
            StudioField {
                label: "Nhân vật chính (giữ ngoại hình nhất quán)";
                placeholder: "Ví dụ: Người phụ nữ 35 tuổi, áo dài xanh thẫm, tóc búi thấp, khuôn mặt thanh tú...";
                value: ProductionStudio.character-anchor; enabled: !ProductionStudio.busy;
                edited(text) => { ProductionStudio.character-anchor = text; }
            }
            StudioField {
                label: "Phong cách hình ảnh";
                placeholder: "Ví dụ: Phong cách điện ảnh, ánh sáng hoàng hôn ấm áp, màu sắc tự nhiên...";
                value: ProductionStudio.visual-style; enabled: !ProductionStudio.busy;
                edited(text) => { ProductionStudio.visual-style = text; }
            }
            StudioField {
                label: I18n.t("nativeStudio.sources"); multiline: false; value: ProductionStudio.sources; enabled: !ProductionStudio.busy;
                placeholder: "https://... (URL bài viết, liên kết tham khảo)";
                edited(text) => { ProductionStudio.sources = text; ProductionStudio.invalidate(); }
            }
            HorizontalLayout {
                spacing: 18px;
                VerticalLayout {
                    spacing: 8px;
                    Text { text: I18n.t("nativeStudio.scenes"); color: Floword.text; font-size: 13px; font-weight: 600; }
                    NumberField { value <=> ProductionStudio.scenes; minimum: 1; maximum: 30; height: 38px; background: Floword.field; border-color: Floword.line; enabled: !ProductionStudio.busy; changed(v) => { ProductionStudio.invalidate(); } }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: I18n.t("nativeStudio.duration"); color: Floword.text; font-size: 13px; font-weight: 600; }
                    NumberField { value <=> ProductionStudio.duration; minimum: 10; maximum: 7200; height: 38px; background: Floword.field; border-color: Floword.line; enabled: !ProductionStudio.busy; changed(v) => { ProductionStudio.invalidate(); } }
                }
            }
        }

        // RIGHT COLUMN: Visual Engine, Workflow & Execution Controls
        StudioCard {
            min-width: 320px;
            horizontal-stretch: 1;
            StudioHeading { title: I18n.t("nativeStudio.executionSection"); glyph: Glyph.sparkle; }

            // Visual engine selection
            VerticalLayout {
                spacing: 6px;
                Text { text: "Công cụ AI tạo hình ảnh/video:"; color: Floword.text; font-size: 13px; font-weight: 600; }
                Select {
                    height: 38px;
                    background: Floword.field; border-color: Floword.line;
                    options: ProductionStudio.visual-engine-options; current <=> ProductionStudio.visual-engine-index;
                    placeholder: "Chọn công cụ AI"; enabled: !ProductionStudio.busy;
                }
            }

            // Workflow definition selection
            VerticalLayout {
                spacing: 6px;
                Text { text: I18n.t("nativeStudio.workflow"); color: Floword.text; font-size: 13px; font-weight: 600; }
                Select {
                    height: 38px;
                    background: Floword.field; border-color: Floword.line;
                    options: ProductionStudio.workflow-names; current <=> ProductionStudio.workflow-index;
                    placeholder: I18n.t("nativeStudio.selectWorkflow"); enabled: !ProductionStudio.busy;
                    changed(index) => { ProductionStudio.invalidate(); }
                }
            }

            Text { text: "Nếu bạn mới sử dụng, hãy giữ lựa chọn được đề xuất. Quy trình quyết định cách các công đoạn được tự động thực hiện."; color: Floword.muted; font-size: 13px; wrap: word-wrap; }
            Text { text: I18n.t("nativeStudio.workflowHint"); color: Floword.muted; font-size: 12px; wrap: word-wrap; }

            StudioButton {
                label: root.advanced-open ? "Ẩn tùy chọn nâng cao" : "Hiện tùy chọn nâng cao";
                clicked => { root.advanced-open = !root.advanced-open; }
            }
            if root.advanced-open: StudioField {
                label: "Cấu hình nâng cao (JSON)"; multiline: true; value: ProductionStudio.extra-inputs; enabled: !ProductionStudio.busy;
                edited(text) => { ProductionStudio.extra-inputs = text; ProductionStudio.invalidate(); }
            }

            if !ProductionStudio.ready && !ProductionStudio.busy: Text {
                text: "Hãy bấm Kiểm tra trước khi tạo để xác nhận các thiết lập đã sẵn sàng.";
                color: Floword.muted; font-size: 13px; wrap: word-wrap;
            }
            if ProductionStudio.ready && !ProductionStudio.busy: Text {
                text: "Đã kiểm tra. Bạn có thể bắt đầu tạo video.";
                color: Floword.success; font-size: 13px; wrap: word-wrap;
            }
            VerticalLayout {
                spacing: 8px;
                StudioButton {
                    label: ProductionStudio.busy ? "Đang kiểm tra..." : "Bước 2 · Kiểm tra trước khi tạo";
                    enabled: !ProductionStudio.busy && ProductionStudio.workflow-ids.length > 0 && !ProductionStudio.uncertain;
                    clicked => { ProductionStudio.check-plan(); }
                }
                StudioButton {
                    label: "Bước 3 · Bắt đầu tạo video"; primary: true;
                    enabled: !ProductionStudio.busy && ProductionStudio.ready && !ProductionStudio.uncertain;
                    clicked => { ProductionStudio.confirm-start = true; }
                }
            }
        }
    }

    StudioBrowserPanel { }

    if ProductionStudio.confirm-start: StudioCard {
        Text { text: I18n.t("nativeStudio.startConfirm"); color: Floword.warning; wrap: word-wrap; }
        HorizontalLayout {
            StudioButton { label: I18n.t("nativeStudio.confirm"); primary: true; enabled: !ProductionStudio.busy; clicked => { ProductionStudio.start-run(); } }
            StudioButton { label: I18n.t("common.cancel"); enabled: !ProductionStudio.busy; clicked => { ProductionStudio.confirm-start = false; } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if ProductionStudio.status != "": StudioCard {
        Text { text: ProductionStudio.status; color: ProductionStudio.uncertain ? Floword.warning : Floword.muted; wrap: word-wrap; }
    }
}
