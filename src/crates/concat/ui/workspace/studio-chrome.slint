import { Floword } from "../theme/floword.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";

export component StudioCard inherits Rectangle {
    in property <length> spacing: 14px;
    in property <length> padding-v: 20px;
    in property <length> padding-h: 20px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Floword.line-bright;
    background: @linear-gradient(180deg, #141D32 0%, #101728 100%);
    min-width: 0px;
    min-height: body.preferred-height;
    vertical-stretch: 0;
    clip: true;

    // Subtle top border hairline highlight for cinematic depth
    Rectangle {
        y: 0px;
        x: 16px;
        width: parent.width - 32px;
        height: 1px;
        background: @linear-gradient(90deg, #00000000 0%, #39C8FF33 50%, #00000000 100%);
    }

    body := VerticalLayout {
        padding-top: root.padding-v;
        padding-bottom: root.padding-v;
        padding-left: root.padding-h;
        padding-right: root.padding-h;
        spacing: root.spacing;
        min-width: 0px;
        @children
    }
}

export component StudioHeading inherits HorizontalLayout {
    in property <string> title;
    in property <Glyph> glyph: Glyph.sparkle;
    in property <length> font-size: 16px;
    in property <length> icon-size: 18px;
    spacing: 8px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Icon { glyph: root.glyph; size: root.icon-size; tint: Floword.cyan; }
    }
    Text { text: root.title; color: Floword.text; font-size: root.font-size; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
}

export component StudioButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked();
    min-height: root.compact ? 30px : 40px;
    max-height: root.compact ? 30px : 40px;
    min-width: caption.preferred-width + (root.compact ? 16px : 24px);
    border-radius: root.compact ? 8px : 10px;
    border-width: 1px;
    border-color: focus.has-focus ? Floword.cyan
        : root.primary ? (touch.has-hover ? Floword.cyan : Floword.button)
        : (touch.has-hover ? Floword.line-bright : Floword.line);
    background: root.primary
        ? (touch.has-hover ? Floword.button-hover : Floword.button)
        : (touch.has-hover ? Floword.raised : Floword.field);
    animate background, border-color { duration: 140ms; easing: ease-in-out; }
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    caption := Text {
        text: root.label;
        color: root.primary ? Floword.on-accent : Floword.text;
        font-size: root.compact ? 12px : 13.5px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component StudioField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> placeholder;
    in property <bool> multiline;
    in property <bool> secret;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback edited(text: string);
    property <string> draft;
    init => { root.draft = root.value; }
    changed value => { if root.secret || !input.has-focus { root.draft = root.value; } }
    min-height: root.multiline ? 164px : (root.compact ? 56px : 78px);
    max-height: root.multiline ? 164px : (root.compact ? 56px : 78px);
    background: transparent;
    VerticalLayout {
        spacing: root.compact ? 5px : 9px;
        Text { text: root.label; color: Floword.text; font-size: root.compact ? 12px : 14px; wrap: word-wrap; }
        Rectangle {
            background: Floword.field;
            border-radius: root.compact ? 8px : 10px;
            border-width: 1px;
            border-color: input.has-focus ? Floword.cyan : Floword.line;
            animate border-color { duration: 140ms; easing: ease-in-out; }
            clip: true;
            input := TextInput {
                x: 10px; y: root.compact ? 6px : 10px; width: parent.width - 20px; height: parent.height - (root.compact ? 12px : 20px);
                text <=> root.draft;
                single-line: !root.multiline;
                input-type: root.secret ? password : text;
                wrap: word-wrap;
                read-only: !root.enabled;
                color: Floword.text;
                font-size: root.compact ? 12px : 14px;
                edited => { root.edited(self.text); }
            }
            if root.draft == "" && !input.has-focus: Text {
                x: 10px; y: root.compact ? 6px : 10px; width: parent.width - 20px; height: parent.height - (root.compact ? 12px : 20px);
                text: root.placeholder;
                color: Floword.muted;
                font-size: root.compact ? 12px : 14px;
                vertical-alignment: center;
            }
        }
    }
}

export component StudioMetric inherits StudioCard {
    in property <string> label;
    in property <string> value;
    Text { text: root.label; color: Floword.muted; font-size: 13px; wrap: word-wrap; }
    Text { text: root.value; color: Floword.text; font-size: 26px; font-weight: 700; wrap: word-wrap; }
}
