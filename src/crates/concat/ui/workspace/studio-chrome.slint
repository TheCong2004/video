import { Floword } from "../theme/floword.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";

export component StudioCard inherits Rectangle {
    in property <length> spacing: 14px;
    border-radius: 18px;
    border-width: 1px;
    border-color: Floword.line;
    background: Floword.surface;
    min-width: 0px;
    min-height: body.preferred-height;
    vertical-stretch: 0;
    body := VerticalLayout {
        padding: 20px;
        spacing: root.spacing;
        min-width: 0px;
        @children
    }
}

export component StudioHeading inherits HorizontalLayout {
    in property <string> title;
    in property <Glyph> glyph: Glyph.sparkle;
    spacing: 10px;
    Icon { glyph: root.glyph; size: 20px; tint: Floword.violet; }
    Text { text: root.title; color: Floword.text; font-size: 18px; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; }
}

export component StudioButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    min-height: 42px;
    max-height: 42px;
    min-width: caption.preferred-width + 24px;
    border-radius: 11px;
    border-width: 1px;
    border-color: focus.has-focus ? Floword.violet : (root.primary ? Floword.button : Floword.line);
    background: root.primary ? (touch.has-hover ? Floword.button-hover : Floword.button) : touch.has-hover ? Floword.raised : Floword.field;
    animate background { duration: 160ms; easing: ease-in-out; }
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    caption := Text {
        text: root.label;
        color: root.primary ? Floword.on-accent : Floword.text;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component StudioField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> placeholder;
    in property <bool> multiline;
    in property <bool> secret;
    in property <bool> enabled: true;
    callback edited(text: string);
    property <string> draft;
    init => { root.draft = root.value; }
    changed value => { if root.secret || !input.has-focus { root.draft = root.value; } }
    min-height: root.multiline ? 164px : 78px;
    max-height: root.multiline ? 164px : 78px;
    background: transparent;
    VerticalLayout {
        spacing: 9px;
        Text { text: root.label; color: Floword.text; font-size: 14px; wrap: word-wrap; }
        Rectangle {
            background: Floword.field;
            border-radius: 10px;
            border-width: 1px;
            border-color: input.has-focus ? Floword.violet : Floword.line;
            clip: true;
            input := TextInput {
                x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px;
                text <=> root.draft;
                single-line: !root.multiline;
                input-type: root.secret ? password : text;
                wrap: word-wrap;
                read-only: !root.enabled;
                accessible-label: root.label;
                color: Floword.text;
                font-size: 15px;
                selection-background-color: Floword.accent;
                selection-foreground-color: Floword.on-accent;
                edited => { root.edited(self.text); }
            }
            if root.draft == "" && !input.has-focus: Text {
                x: 12px; y: 10px; width: parent.width - 24px;
                text: root.placeholder; color: Floword.muted; font-size: 15px; wrap: word-wrap;
            }
        }
    }
}

export component StudioMetric inherits StudioCard {
    in property <string> label;
    in property <string> value;
    Text { text: root.label; color: Floword.muted; font-size: 13px; wrap: word-wrap; }
    Text { text: root.value; color: Floword.text; font-size: 26px; font-weight: 700; wrap: word-wrap; }
}
