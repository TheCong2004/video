// SPDX-License-Identifier: AGPL-3.0-or-later
import { I18n } from "../i18n.slint";
import { Floword } from "../theme/floword.slint";
import { Select } from "../primitives/primitives.slint";
import { Glyph, Icon } from "../icons.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField } from "studio-chrome.slint";
import { PromaxAvatarPanel } from "studio-promax-avatars.slint";

export struct StudioAvatarRow { id: string, label: string, model-type: string }
export struct StudioVoiceRow { id: string, label: string }
export struct StudioSceneRow { id: string, label: string }
export struct StudioVideoModelRow { id: string, label: string }
export struct StudioVideoJobRow {
    id: string, title: string, status: string, avatar: string,
    driver: string, created: string, duration: string,
}

export global StudioOpenTalking {
    in-out property <int> active-tab: 0; // 0: Create, 1: Avatars, 2: Voices, 3: Interactive/Live, 4: History
    in-out property <string> engine-status: "OFFLINE";
    in-out property <image> avatar-preview;
    in-out property <bool> jobs-running;
    in-out property <[StudioAvatarRow]> avatars;
    in-out property <[StudioVoiceRow]> voices;
    in-out property <[StudioSceneRow]> scenes;
    in-out property <[StudioVideoModelRow]> models;
    in-out property <[StudioVideoJobRow]> jobs;
    in-out property <[string]> avatar-options;
    in-out property <[string]> voice-options;
    in-out property <[string]> scene-options;
    in-out property <[string]> model-options;
    in-out property <int> avatar-index;
    in-out property <int> voice-index;
    in-out property <int> scene-index;
    in-out property <int> model-index;
    in-out property <string> title;
    in-out property <string> script;
    in-out property <string> duration-seconds: "10";
    in-out property <string> gesture-seconds: "5";
    in-out property <string> gesture-url: "http://127.0.0.1:8768";
    in-out property <string> gesture-token;
    in-out property <string> gesture-image-name;
    in-out property <image> gesture-image;
    in-out property <string> gesture-audio-name;
    in-out property <string> gesture-status;
    in-out property <bool> gesture-busy;
    in-out property <bool> gesture-consent;
    callback choose-gesture-image();
    callback choose-gesture-audio();
    callback clear-gesture-audio();
    callback generate-gestures();
    in-out property <bool> busy;
    in-out property <bool> catalogs-loaded;
    in-out property <string> status;
    in-out property <bool> confirm-create;
    in-out property <string> stop-id;
    in-out property <string> delete-id;
    callback refresh();
    callback refresh-jobs();
    callback create();
    callback stop(id: string);
    callback delete(id: string);
    callback import-video(id: string);
    callback play-video(id: string);
    callback use-live-video(id: string);
    callback open-export-folder();
    callback select-avatar(int);
    callback select-voice(int);
    callback test-voice(int);
    callback set-tab(int);
}

component StudioCharacterMotionSetup inherits StudioCard {
    in property <length> text-width: 500px;
    in property <[string]> clips;
    in property <bool> enabled-profile;
    in property <bool> busy;
    in property <string> status;
    callback choose-motion-clip(int);
    callback clear-motion-clip(int);
    callback toggle-motion-clips();
    StudioHeading { title: "Chuẩn bị cử chỉ nhân vật"; glyph: Glyph.film; }
    Text { width: root.text-width; text: "AI tạo sẵn ba clip cùng nhân vật. Tạo xong sẽ tự lưu và gán cho LIVE; khi trả lời, LIVE chọn cử chỉ rồi khớp môi với lời mới. Chỉ tạo trước phiên LIVE."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
    if StudioOpenTalking.gesture-image.width > 0: Image { source: StudioOpenTalking.gesture-image; width: root.text-width; height: 140px; image-fit: contain; }
    StudioButton { label: StudioOpenTalking.gesture-image-name == "" ? "1. Chọn ảnh nhân vật để AI tạo cử chỉ" : "Đổi ảnh · " + StudioOpenTalking.gesture-image-name; enabled: !StudioOpenTalking.gesture-busy && !root.busy; clicked => { StudioOpenTalking.choose-gesture-image(); } }
    FlexboxLayout {
        min-width: 0px; spacing: 8px;
        StudioButton { label: StudioOpenTalking.gesture-audio-name == "" ? "2. Tải âm thanh dẫn cử chỉ (tùy chọn)" : "Âm thanh: " + StudioOpenTalking.gesture-audio-name; enabled: !StudioOpenTalking.gesture-busy && !root.busy; clicked => { StudioOpenTalking.choose-gesture-audio(); } }
        if StudioOpenTalking.gesture-audio-name != "": StudioButton { label: "Dùng giọng đang chọn"; enabled: !StudioOpenTalking.gesture-busy; clicked => { StudioOpenTalking.clear-gesture-audio(); } }
    }
    Text { width: root.text-width; text: "Không tải âm thanh: dùng giọng đã chọn ở trên hoặc giọng mẫu LIVE. Khi bấm Tạo, ảnh và âm thanh sẽ được gửi tới dịch vụ AI đã thiết lập để tạo clip."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
    StudioField { label: "3. Số giây mỗi clip cử chỉ · từ 2 đến 10"; value: StudioOpenTalking.gesture-seconds; enabled: !StudioOpenTalking.gesture-busy; edited(value) => { StudioOpenTalking.gesture-seconds = value; } }
    StudioButton { label: StudioOpenTalking.gesture-consent ? "Đã xác nhận quyền sử dụng ảnh và giọng" : "Tôi có quyền dùng ảnh và giọng này · bấm xác nhận"; primary: StudioOpenTalking.gesture-consent; enabled: !StudioOpenTalking.gesture-busy; clicked => { StudioOpenTalking.gesture-consent = !StudioOpenTalking.gesture-consent; } }
    StudioButton { label: StudioOpenTalking.gesture-busy ? "Đang tạo bộ cử chỉ…" : "Tạo 3 clip cử chỉ bằng AI và gán cho LIVE"; primary: true; enabled: !root.busy && !StudioOpenTalking.gesture-busy && StudioOpenTalking.gesture-consent && StudioOpenTalking.gesture-image-name != ""; clicked => { StudioOpenTalking.generate-gestures(); } }
    if StudioOpenTalking.gesture-status != "": Text { width: root.text-width; text: StudioOpenTalking.gesture-status; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
    for label[index] in ["Trả lời", "Chào người xem", "Giới thiệu sản phẩm"]: VerticalLayout {
        min-width: 0px; spacing: 6px;
        Text { width: root.text-width; text: label + ": " + (index < root.clips.length ? root.clips[index] : "Chưa chọn clip"); color: Floword.text; font-size: 12px; wrap: word-wrap; }
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioButton { label: "Chọn clip"; compact: true; enabled: !root.busy; clicked => { root.choose-motion-clip(index); } }
            StudioButton { label: "Bỏ chọn"; compact: true; enabled: !root.busy; clicked => { root.clear-motion-clip(index); } }
        }
    }
    StudioButton { label: root.enabled-profile ? "Đang dùng bộ cử chỉ đã chuẩn bị" : "Dùng bộ cử chỉ này"; primary: root.enabled-profile; enabled: !root.busy; clicked => { root.toggle-motion-clips(); } }
    if root.status != "": Text { text: root.status; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
}

export component StudioOpenTalkingPage inherits VerticalLayout {
    in property <length> viewport-width: 1080px;
    in property <[string]> motion-clips;
    in property <bool> motion-enabled;
    in property <bool> motion-busy;
    in property <string> motion-status;
    callback choose-motion-clip(int);
    callback clear-motion-clip(int);
    callback toggle-motion-clips();
    in-out property <bool> is-live-route: false;
    in property <length> viewport-height: 720px;
    property <bool> stacked: root.width < 840px;
    property <int> tab-columns: root.width < 660px ? 2 : root.width < 1080px ? 3 : 5;
    private property <bool> advanced-open;
    callback navigate-to-live();
    spacing: 16px;
    alignment: start;
    min-width: 0px;
    init => { if !StudioOpenTalking.catalogs-loaded && !StudioOpenTalking.busy { StudioOpenTalking.refresh(); } }
    Timer {
        interval: 3s;
        running: StudioOpenTalking.jobs-running && !StudioOpenTalking.busy;
        triggered => { StudioOpenTalking.refresh-jobs(); }
    }

    HorizontalLayout {
        spacing: 8px;
        StudioHeading { title: "Video nhân vật"; }
        StudioButton { label: "Làm mới"; compact: true; enabled: !StudioOpenTalking.busy; clicked => { StudioOpenTalking.refresh(); } }
    }
    FlexboxLayout {
        spacing: 8px;
        StudioButton { label: "Tạo video"; primary: StudioOpenTalking.active-tab == 0; compact: true; clicked => { StudioOpenTalking.active-tab = 0; } }
        StudioButton { label: "Nhân vật"; primary: StudioOpenTalking.active-tab == 1; compact: true; clicked => { StudioOpenTalking.active-tab = 1; } }
        StudioButton { label: "Giọng đọc"; primary: StudioOpenTalking.active-tab == 2; compact: true; clicked => { StudioOpenTalking.active-tab = 2; } }
        StudioButton { label: "LIVE"; primary: StudioOpenTalking.active-tab == 3; compact: true; clicked => { StudioOpenTalking.active-tab = 3; root.navigate-to-live(); } }
        StudioButton { label: "Video đã tạo"; primary: StudioOpenTalking.active-tab == 4; compact: true; clicked => { StudioOpenTalking.active-tab = 4; } }
    }
    if StudioOpenTalking.status != "": Text { text: StudioOpenTalking.status; color: Floword.muted; font-size: 12px; wrap: word-wrap; }

    // TAB 0: TẠO VIDEO NGƯỜI ẢO
    if StudioOpenTalking.active-tab == 0: VerticalLayout {
        spacing: 16px;

        // 2-COLUMN WORKSPACE
        GridLayout {
            spacing: 18px;
            min-width: 0px;

            // LEFT COLUMN: Character, Voice, Driver, Scene, Script
            StudioCard {
                row: 0;
                col: 0;
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 440px;
                spacing: 14px;

                StudioHeading { title: "Nhân vật và giọng đọc"; glyph: Glyph.film; }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: I18n.t("studioOpenTalking.avatar"); color: Floword.text; font-size: 13px; font-weight: 600; }
                    Select { options: StudioOpenTalking.avatar-options; current <=> StudioOpenTalking.avatar-index; changed(index) => { StudioOpenTalking.select-avatar(index); } placeholder: I18n.t("studioOpenTalking.chooseAvatar"); height: 38px; background: Floword.field; border-color: Floword.line; enabled: !StudioOpenTalking.busy; }
                }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: I18n.t("studioOpenTalking.voice"); color: Floword.text; font-size: 13px; font-weight: 600; }
                    Select { options: StudioOpenTalking.voice-options; current <=> StudioOpenTalking.voice-index; placeholder: I18n.t("studioOpenTalking.chooseVoice"); height: 38px; background: Floword.field; border-color: Floword.line; enabled: !StudioOpenTalking.busy; }
                }

                StudioButton { label: root.advanced-open ? "Thu gọn tùy chọn" : "Tùy chọn nâng cao"; compact: true; clicked => { root.advanced-open = !root.advanced-open; } }
                if root.advanced-open: VerticalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Text { text: I18n.t("studioOpenTalking.driver"); color: Floword.text; font-size: 13px; font-weight: 600; }
                        Select { options: StudioOpenTalking.model-options; current <=> StudioOpenTalking.model-index; placeholder: I18n.t("studioOpenTalking.noDriver"); height: 38px; background: Floword.field; border-color: Floword.line; enabled: !StudioOpenTalking.busy; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Text { text: I18n.t("studioOpenTalking.scene"); color: Floword.text; font-size: 13px; font-weight: 600; }
                        Select { options: StudioOpenTalking.scene-options; current <=> StudioOpenTalking.scene-index; placeholder: I18n.t("studioOpenTalking.noScene"); height: 38px; background: Floword.field; border-color: Floword.line; enabled: !StudioOpenTalking.busy; }
                    }
                }

                Rectangle { height: 1px; background: Floword.line; }

                StudioHeading { title: "Nội dung"; glyph: Glyph.text-mark; }

                StudioField { label: I18n.t("studioOpenTalking.videoTitle"); value: StudioOpenTalking.title; enabled: !StudioOpenTalking.busy; edited(text) => { StudioOpenTalking.title = text; } }
                StudioField { label: "Thời lượng video không lời (giây) · 1–120"; value: StudioOpenTalking.duration-seconds; enabled: !StudioOpenTalking.busy; edited(text) => { StudioOpenTalking.duration-seconds = text; } }
                Text { text: "Video có lời giữ đủ lời thoại; thời lượng theo âm thanh. Clip cử chỉ AI có ô số giây riêng bên dưới."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
                StudioField { label: I18n.t("studioOpenTalking.script"); placeholder: I18n.t("studioOpenTalking.scriptHint"); multiline: true; value: StudioOpenTalking.script; enabled: !StudioOpenTalking.busy; edited(text) => { StudioOpenTalking.script = text; } }
            }

            // RIGHT COLUMN: 3D Preview, Preconditions & Creation Trigger
            VerticalLayout {
                row: root.stacked ? 1 : 0;
                col: root.stacked ? 0 : 1;
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 440px;
                spacing: 14px;
                alignment: start;

                // 3D Avatar Preview Screen Card
                Rectangle {
                    background: Floword.surface;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Floword.line-bright;
                    clip: true;
                    // Do not let the source image's intrinsic size stretch the
                    // entire form. Scale with the available window, not the photo.
                    height: Math.clamp(Math.min(self.width * 0.72, root.viewport-height * 0.52), 240px, 480px);

                    // 3D Avatar High-Definition Illustration
                    Image {
                        width: 100%;
                        height: 100%;
                        source: StudioOpenTalking.avatar-preview;
                        image-fit: contain;
                    }
                    if StudioOpenTalking.avatar-preview.width == 0: VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Icon { glyph: Glyph.film; size: 32px; tint: Floword.muted; }
                        Text { text: "Chọn nhân vật để xem trước"; color: Floword.muted; horizontal-alignment: center; wrap: word-wrap; }
                    }

                    // Glassmorphic subtle edge vignette
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: @linear-gradient(180deg, #080D1B40 0%, #00000000 35%, #00000000 65%, #080D1B99 100%);
                    }

                    VerticalLayout {
                        alignment: space-between;
                        padding: 14px;

                        Text { text: "Xem trước"; color: Floword.text; font-size: 12px; }

                        // Bottom overlay subtitle/voice note
                        Rectangle {
                            background: #000000cc;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #ffffff20;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Icon { glyph: Glyph.volume; size: 14px; tint: Floword.cyan; }
                                Text {
                                    text: StudioOpenTalking.script != "" ? StudioOpenTalking.script : "Chưa có lời thoại";
                                    color: #f1f5f9;
                                    font-size: 12px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Preconditions & Trigger Card
                StudioCard {
                    spacing: 12px;
                    if StudioOpenTalking.avatar-options.length == 0: Text { text: "Chưa có nhân vật. Mở mục Nhân vật hoặc bấm Làm mới."; color: Floword.warning; wrap: word-wrap; }
                    if StudioOpenTalking.voice-options.length == 0: Text { text: "Chưa có giọng đọc. Mở mục Giọng đọc hoặc bấm Làm mới."; color: Floword.warning; wrap: word-wrap; }
                    if StudioOpenTalking.model-options.length == 0: Text { text: "Chưa có bộ tạo video. Bấm Làm mới để kiểm tra."; color: Floword.warning; wrap: word-wrap; }
                    if root.advanced-open: Text { text: I18n.t("studioOpenTalking.motionNote"); color: Floword.muted; wrap: word-wrap; font-size: 12px; }
                    StudioButton {
                        label: StudioOpenTalking.busy ? "Đang tạo video…"
                            : StudioOpenTalking.script != "" ? "Tạo video có lời thoại"
                            : "Tạo video không lời";
                        primary: true;
                        enabled: !StudioOpenTalking.busy && StudioOpenTalking.catalogs-loaded
                            && StudioOpenTalking.avatar-options.length > 0 && StudioOpenTalking.voice-options.length > 0
                            && StudioOpenTalking.model-options.length > 0;
                        clicked => { StudioOpenTalking.confirm-create = true; }
                    }
                }
            }
        }

    }

        if StudioOpenTalking.confirm-create || StudioOpenTalking.stop-id != "" || StudioOpenTalking.delete-id != "": StudioCard {
            Text {
                text: StudioOpenTalking.confirm-create ? I18n.t("studioOpenTalking.confirmCreate")
                    : StudioOpenTalking.stop-id != "" ? I18n.t1("studioOpenTalking.confirmStop", StudioOpenTalking.stop-id)
                    : I18n.t1("studioOpenTalking.confirmDelete", StudioOpenTalking.delete-id);
                color: Floword.warning; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                StudioButton {
                    label: I18n.t("studioOpenTalking.confirm"); primary: true; enabled: !StudioOpenTalking.busy;
                    clicked => {
                        if StudioOpenTalking.confirm-create { StudioOpenTalking.create(); }
                        else if StudioOpenTalking.stop-id != "" { StudioOpenTalking.stop(StudioOpenTalking.stop-id); }
                        else { StudioOpenTalking.delete(StudioOpenTalking.delete-id); }
                    }
                }
                StudioButton {
                    label: I18n.t("common.cancel"); enabled: !StudioOpenTalking.busy;
                    clicked => { StudioOpenTalking.confirm-create = false; StudioOpenTalking.stop-id = ""; StudioOpenTalking.delete-id = ""; }
                }
            }
        }


    if StudioOpenTalking.active-tab == 0: StudioCharacterMotionSetup {
        text-width: Math.max(0px, root.viewport-width - 32px);
        clips: root.motion-clips; enabled-profile: root.motion-enabled;
        busy: root.motion-busy; status: root.motion-status;
        choose-motion-clip(index) => { root.choose-motion-clip(index); }
        clear-motion-clip(index) => { root.clear-motion-clip(index); }
        toggle-motion-clips => { root.toggle-motion-clips(); }
    }
    // TAB 1: KHO NHÂN VẬT (Avatars Catalog)
    if StudioOpenTalking.active-tab == 1: VerticalLayout {
        spacing: 16px;

        PromaxAvatarPanel { navigate-to-live => { root.navigate-to-live(); } }

        StudioCard {
            StudioHeading { title: "Nhân vật có sẵn"; }
            StudioButton { label: root.advanced-open ? "Ẩn thông tin kỹ thuật" : "Thông tin kỹ thuật"; compact: true; clicked => { root.advanced-open = !root.advanced-open; } }

            if StudioOpenTalking.avatars.length == 0: Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Floword.line;
                background: Floword.field;

                HorizontalLayout {
                    padding: 30px;
                    alignment: center;
                    Text { text: I18n.t("studioOpenTalking.emptyAvatars"); color: Floword.muted; font-size: 14px; }
                }
            }

            for avatar[index] in StudioOpenTalking.avatars: Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Floword.line;
                background: Floword.field;

                FlexboxLayout {
                    padding: 14px;
                    spacing: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 14px;

                        // Avatar Thumbnail Box
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 10px;
                            background: #6366f122;
                            border-width: 1px;
                            border-color: #6366f144;

                            Text {
                                text: "👤";
                                font-size: 22px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: avatar.label;
                                color: Floword.text;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            if root.advanced-open: Text {
                                text: "Model: " + avatar.model-type + " · ID: " + avatar.id;
                                color: Floword.muted;
                                font-size: 12px;
                            }
                        }
                    }

                    // Actions
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        StudioButton {
                            label: "Chọn tạo video";
                            clicked => {
                                StudioOpenTalking.select-avatar(index);
                                StudioOpenTalking.active-tab = 0;
                            }
                        }

                        StudioButton {
                            label: "Dùng cho LIVE";
                            primary: true;
                            clicked => {
                                StudioOpenTalking.select-avatar(index);
                                StudioOpenTalking.active-tab = 3;
                            }
                        }
                    }
                }
            }
        }
    }

    // TAB 2: GIỌNG NÓI & LỒNG TIẾNG (Voices)
    if StudioOpenTalking.active-tab == 2: VerticalLayout {
        spacing: 16px;

        StudioCard {
            StudioHeading { title: I18n.t("studioOpenTalking.tabVoices") + " (" + StudioOpenTalking.voices.length + ")"; }
            Text { text: "Các giọng đọc TTS sẵn sàng cho lồng tiếng video và tương tác livestream."; color: Floword.muted; font-size: 13px; }

            if StudioOpenTalking.voices.length == 0: Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Floword.line;
                background: Floword.field;

                HorizontalLayout {
                    padding: 30px;
                    alignment: center;
                    Text { text: I18n.t("studioOpenTalking.emptyVoices"); color: Floword.muted; font-size: 14px; }
                }
            }

            for voice[index] in StudioOpenTalking.voices: Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Floword.line;
                background: Floword.field;

                FlexboxLayout {
                    padding: 14px;
                    spacing: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 14px;

                        // Mic Icon Box
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 10px;
                            background: #ec489922;
                            border-width: 1px;
                            border-color: #ec489944;

                            Text {
                                text: "🎙️";
                                font-size: 20px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: voice.label;
                                color: Floword.text;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            if root.advanced-open: Text {
                                text: "Mã giọng: " + voice.id;
                                color: Floword.muted;
                                font-size: 12px;
                            }
                        }
                    }

                    // Actions
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        StudioButton {
                            label: "Nghe thử giọng";
                            clicked => {
                                StudioOpenTalking.test-voice(index);
                            }
                        }

                        StudioButton {
                            label: "Chọn giọng này";
                            primary: true;
                            clicked => {
                                StudioOpenTalking.voice-index = index;
                                StudioOpenTalking.active-tab = 0;
                            }
                        }
                    }
                }
            }
        }
    }

    // TAB 3: HỘI THOẠI TRỰC TIẾP
    if StudioOpenTalking.active-tab == 3: StudioCard {
        StudioHeading { title: "LIVE"; }
        Text {
            text: "Chọn nhân vật, kết nối kênh và theo dõi bình luận.";
            color: Floword.muted;
            font-size: 13px;
        }
        HorizontalLayout {
            StudioButton {
                label: "Mở LIVE";
                primary: true;
                clicked => { root.navigate-to-live(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // TAB 4: LỊCH SỬ VIDEO (Video Jobs)
    if StudioOpenTalking.active-tab == 4: VerticalLayout {
        spacing: 16px;

        StudioCard {
            StudioHeading { title: I18n.t("studioOpenTalking.history") + " (" + StudioOpenTalking.jobs.length + ")"; }
            StudioButton { label: root.advanced-open ? "Ẩn chi tiết" : "Chi tiết video"; compact: true; clicked => { root.advanced-open = !root.advanced-open; } }

            if StudioOpenTalking.catalogs-loaded && StudioOpenTalking.jobs.length == 0:
                Text { text: I18n.t("studioOpenTalking.empty"); color: Floword.muted; wrap: word-wrap; font-size: 13px; }

            for job in StudioOpenTalking.jobs: VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: job.title;
                        color: Floword.text;
                        font-size: 15px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    // Status Badge
                    Rectangle {
                        border-radius: 6px;
                        background: job.status == "completed" ? #10b98122 : job.status == "processing" ? #3b82f622 : #ef444422;
                        border-width: 1px;
                        border-color: job.status == "completed" ? #10b98155 : job.status == "processing" ? #3b82f655 : #ef444455;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;

                            Text {
                                text: job.status == "completed" ? "Đã xong" : job.status == "processing" ? "Đang tạo" : job.status == "queued" ? "Đang chờ" : job.status == "cancelled" ? "Đã dừng" : job.status == "failed" ? "Chưa hoàn tất" : job.status;
                                color: job.status == "completed" ? #34d399 : job.status == "processing" ? #60a5fa : #f87171;
                                font-size: 11px;
                                font-weight: 700;
                            }
                        }
                    }
                }

                if root.advanced-open: Text { text: "ID: " + job.id + " · Driver: " + job.driver + " · Thời lượng: " + job.duration + " · Ngày tạo: " + job.created; color: Floword.muted; font-size: 12px; }

                FlexboxLayout {
                    spacing: 8px;
                    if job.status == "queued" || job.status == "processing": StudioButton {
                        label: I18n.t("studioOpenTalking.stop"); enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.stop-id = job.id; }
                    }
                    if job.status == "completed": StudioButton {
                        label: "▶ Xem video"; primary: true; enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.play-video(job.id); }
                    }
                    if job.status == "completed": StudioButton {
                        label: "Dùng cho LIVE"; enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.use-live-video(job.id); root.navigate-to-live(); }
                    }
                    if job.status == "completed": StudioButton {
                        label: "📁 Mở thư mục"; enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.open-export-folder(); }
                    }
                    if job.status == "completed": StudioButton {
                        label: I18n.t("studioOpenTalking.importVideo"); enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.import-video(job.id); }
                    }
                    if job.status == "completed" || job.status == "failed" || job.status == "cancelled": StudioButton {
                        label: I18n.t("studioOpenTalking.delete"); enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.delete-id = job.id; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 1px; background: Floword.line; }
            }
        }
    }
}
