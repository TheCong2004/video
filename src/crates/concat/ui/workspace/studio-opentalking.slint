// SPDX-License-Identifier: AGPL-3.0-or-later
import { I18n } from "../i18n.slint";
import { Floword } from "../theme/floword.slint";
import { Select } from "../primitives/primitives.slint";
import { Glyph, Icon } from "../icons.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField } from "studio-chrome.slint";

export struct StudioAvatarRow { id: string, label: string, model-type: string }
export struct StudioVoiceRow { id: string, label: string }
export struct StudioSceneRow { id: string, label: string }
export struct StudioVideoModelRow { id: string, label: string }
export struct StudioVideoJobRow {
    id: string, title: string, status: string, avatar: string,
    driver: string, created: string, duration: string,
}

export global StudioOpenTalking {
    in-out property <int> active-tab: 0; // 0: Create, 1: Avatars, 2: Voices, 3: Interactive/Live, 4: History
    in-out property <string> engine-status: "OFFLINE";
    in-out property <image> avatar-preview;
    in-out property <bool> jobs-running;
    in-out property <[StudioAvatarRow]> avatars;
    in-out property <[StudioVoiceRow]> voices;
    in-out property <[StudioSceneRow]> scenes;
    in-out property <[StudioVideoModelRow]> models;
    in-out property <[StudioVideoJobRow]> jobs;
    in-out property <[string]> avatar-options;
    in-out property <[string]> voice-options;
    in-out property <[string]> scene-options;
    in-out property <[string]> model-options;
    in-out property <int> avatar-index;
    in-out property <int> voice-index;
    in-out property <int> scene-index;
    in-out property <int> model-index;
    in-out property <string> title;
    in-out property <string> script;
    in-out property <bool> busy;
    in-out property <bool> catalogs-loaded;
    in-out property <string> status;
    in-out property <bool> confirm-create;
    in-out property <string> stop-id;
    in-out property <string> delete-id;
    callback refresh();
    callback refresh-jobs();
    callback create();
    callback stop(id: string);
    callback delete(id: string);
    callback import-video(id: string);
    callback play-video(id: string);
    callback use-live-video(id: string);
    callback open-export-folder();
    callback select-avatar(int);
    callback select-voice(int);
    callback test-voice(int);
    callback set-tab(int);
}

export component StudioOpenTalkingPage inherits VerticalLayout {
    in-out property <bool> is-live-route: false;
    in property <length> viewport-height: 720px;
    property <bool> stacked: root.width < 840px;
    property <int> tab-columns: root.width < 660px ? 2 : root.width < 1080px ? 3 : 5;
    callback navigate-to-live();
    spacing: 16px;
    alignment: start;
    min-width: 0px;
    init => { if !StudioOpenTalking.catalogs-loaded && !StudioOpenTalking.busy { StudioOpenTalking.refresh(); } }
    Timer {
        interval: 3s;
        running: StudioOpenTalking.jobs-running && !StudioOpenTalking.busy;
        triggered => { StudioOpenTalking.refresh-jobs(); }
    }

    // TOP HEADER CARD (Matches ArtCraft OpenTalking Studio Hub)
    Rectangle {
        border-radius: 16px;
        border-width: 1px;
        border-color: Floword.line;
        background: Floword.surface;
        min-height: header-layout.preferred-height;

        header-layout := VerticalLayout {
            padding: 16px;
            spacing: 14px;

            // Row 1: Brand title, Engine status badge & Refresh button
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;

                    // Avatar Robot Icon
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 12px;
                        background: Floword.cyan.with-alpha(0.18);
                        border-width: 1px;
                        border-color: Floword.cyan.with-alpha(0.4);

                        Icon {
                            glyph: Glyph.film;
                            size: 20px;
                            tint: Floword.cyan;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;

                        FlexboxLayout {
                            spacing: 8px;
                            Text {
                                text: "OPENTALKING STUDIO";
                                color: Floword.text;
                                font-size: 17px;
                                font-weight: 800;
                            }

                            // Engine Status Pill
                            Rectangle {
                                border-radius: 10px;
                                background: StudioOpenTalking.engine-status != "OFFLINE" ? Floword.success.with-alpha(0.2) : Floword.danger.with-alpha(0.2);
                                border-width: 1px;
                                border-color: StudioOpenTalking.engine-status != "OFFLINE" ? Floword.success.with-alpha(0.4) : Floword.danger.with-alpha(0.4);

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;

                                    Text {
                                        text: "ENGINE " + StudioOpenTalking.engine-status;
                                        color: StudioOpenTalking.engine-status != "OFFLINE" ? Floword.success : Floword.danger;
                                        font-size: 10px;
                                        font-weight: 700;
                                    }
                                }
                            }
                        }

                        Text {
                            text: I18n.t("studioOpenTalking.subtitle");
                            color: Floword.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                // Refresh Button
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Floword.line;
                        background: refresh-touch.has-hover ? Floword.raised : Floword.field;

                        Icon {
                            glyph: Glyph.sparkle;
                            size: 16px;
                            tint: Floword.cyan;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        refresh-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { StudioOpenTalking.refresh(); }
                        }
                    }
                }
            }

            // Row 2: Navigation Tabs (5 Tabs: Create, Avatars, Voices, Interactive, History)
            GridLayout {
                spacing: 8px;

                // Tab 0: Tạo Video Người Ảo
                Rectangle {
                    row: 0;
                    col: 0;
                    border-radius: 10px;
                    background: StudioOpenTalking.active-tab == 0 ? Floword.raised : tab0-touch.has-hover ? Floword.raised.with-alpha(0.6) : Floword.field;
                    border-width: 1px;
                    border-color: StudioOpenTalking.active-tab == 0 ? Floword.cyan : Floword.line;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                        Icon { glyph: Glyph.film; size: 14px; tint: StudioOpenTalking.active-tab == 0 ? Floword.cyan : Floword.muted; }
                        Text {
                            text: I18n.t("studioOpenTalking.tabCreate");
                            color: StudioOpenTalking.active-tab == 0 ? Floword.cyan : Floword.text;
                            font-size: 13px;
                            font-weight: StudioOpenTalking.active-tab == 0 ? 700 : 500;
                        }
                    }

                    tab0-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { StudioOpenTalking.active-tab = 0; }
                    }
                }

                // Tab 1: Kho Nhân Vật
                Rectangle {
                    row: 0;
                    col: 1;
                    border-radius: 10px;
                    background: StudioOpenTalking.active-tab == 1 ? Floword.raised : tab1-touch.has-hover ? Floword.raised.with-alpha(0.6) : Floword.field;
                    border-width: 1px;
                    border-color: StudioOpenTalking.active-tab == 1 ? Floword.violet : Floword.line;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                        Icon { glyph: Glyph.sparkle; size: 14px; tint: StudioOpenTalking.active-tab == 1 ? Floword.violet : Floword.muted; }
                        Text {
                            text: I18n.t("studioOpenTalking.tabAvatars") + " (" + StudioOpenTalking.avatars.length + ")";
                            color: StudioOpenTalking.active-tab == 1 ? Floword.violet : Floword.text;
                            font-size: 13px;
                            font-weight: StudioOpenTalking.active-tab == 1 ? 700 : 500;
                        }
                    }

                    tab1-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { StudioOpenTalking.active-tab = 1; }
                    }
                }

                // Tab 2: Giọng Nói & Lồng Tiếng
                Rectangle {
                    row: root.tab-columns == 2 ? 1 : 0;
                    col: root.tab-columns == 2 ? 0 : 2;
                    border-radius: 10px;
                    background: StudioOpenTalking.active-tab == 2 ? Floword.raised : tab2-touch.has-hover ? Floword.raised.with-alpha(0.6) : Floword.field;
                    border-width: 1px;
                    border-color: StudioOpenTalking.active-tab == 2 ? Floword.violet : Floword.line;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                        Icon { glyph: Glyph.volume; size: 14px; tint: StudioOpenTalking.active-tab == 2 ? Floword.violet : Floword.muted; }
                        Text {
                            text: I18n.t("studioOpenTalking.tabVoices") + " (" + StudioOpenTalking.voices.length + ")";
                            color: StudioOpenTalking.active-tab == 2 ? Floword.violet : Floword.text;
                            font-size: 13px;
                            font-weight: StudioOpenTalking.active-tab == 2 ? 700 : 500;
                        }
                    }

                    tab2-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { StudioOpenTalking.active-tab = 2; }
                    }
                }

                // Tab 3: Hội Thoại Trực Tiếp (Active Pill with LIVE badge)
                Rectangle {
                    row: root.tab-columns < 5 ? 1 : 0;
                    col: root.tab-columns == 2 ? 1 : root.tab-columns == 3 ? 0 : 3;
                    border-radius: 10px;
                    background: StudioOpenTalking.active-tab == 3 ? Floword.raised : tab3-touch.has-hover ? Floword.raised.with-alpha(0.6) : Floword.field;
                    border-width: 1px;
                    border-color: StudioOpenTalking.active-tab == 3 ? Floword.danger : Floword.line;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                        Icon { glyph: Glyph.waveform; size: 14px; tint: StudioOpenTalking.active-tab == 3 ? Floword.danger : Floword.muted; }
                        Text {
                            text: I18n.t("studioOpenTalking.tabInteractive");
                            color: StudioOpenTalking.active-tab == 3 ? Floword.text : Floword.text;
                            font-size: 13px;
                            font-weight: 700;
                        }

                        // LIVE tag
                        Rectangle {
                            border-radius: 4px;
                            background: Floword.danger;

                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                padding-top: 1px;
                                padding-bottom: 1px;
                                Text {
                                    text: "LIVE";
                                    color: #ffffff;
                                    font-size: 9px;
                                    font-weight: 800;
                                }
                            }
                        }
                    }

                    tab3-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            StudioOpenTalking.active-tab = 3;
                            root.navigate-to-live();
                        }
                    }
                }

                // Tab 4: Lịch Sử Video
                Rectangle {
                    row: root.tab-columns == 2 ? 2 : root.tab-columns == 3 ? 1 : 0;
                    col: root.tab-columns == 2 ? 0 : root.tab-columns == 3 ? 1 : 4;
                    border-radius: 10px;
                    background: StudioOpenTalking.active-tab == 4 ? Floword.raised : tab4-touch.has-hover ? Floword.raised.with-alpha(0.6) : Floword.field;
                    border-width: 1px;
                    border-color: StudioOpenTalking.active-tab == 4 ? Floword.cyan : Floword.line;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                        Icon { glyph: Glyph.clock; size: 14px; tint: StudioOpenTalking.active-tab == 4 ? Floword.cyan : Floword.muted; }
                        Text {
                            text: I18n.t("studioOpenTalking.tabHistory") + " (" + StudioOpenTalking.jobs.length + ")";
                            color: StudioOpenTalking.active-tab == 4 ? Floword.cyan : Floword.text;
                            font-size: 13px;
                            font-weight: StudioOpenTalking.active-tab == 4 ? 700 : 500;
                        }
                    }

                    tab4-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { StudioOpenTalking.active-tab = 4; }
                    }
                }

            }

            if StudioOpenTalking.status != "": Rectangle {
                border-radius: 8px;
                background: Floword.field;
                border-width: 1px;
                border-color: Floword.line;

                HorizontalLayout {
                    padding: 8px;
                    Text { text: StudioOpenTalking.status; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
                }
            }
        }
    }

    // TAB 0: TẠO VIDEO NGƯỜI ẢO
    if StudioOpenTalking.active-tab == 0: VerticalLayout {
        spacing: 16px;

        // 3-STEP BEGINNER PIPELINE GUIDE
        Rectangle {
            background: Floword.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Floword.line-bright;
            HorizontalLayout {
                padding: 12px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 6px;
                        background: Floword.cyan.with-alpha(0.2);
                        Text { text: "1"; color: Floword.cyan; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Chọn Nhân Vật"; color: Floword.text; font-size: 12px; font-weight: 600; }
                }

                Text { text: "→"; color: Floword.muted; font-size: 14px; vertical-alignment: center; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 6px;
                        background: Floword.violet.with-alpha(0.2);
                        Text { text: "2"; color: Floword.violet; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Chọn Giọng & Kịch Bản"; color: Floword.text; font-size: 12px; font-weight: 600; }
                }

                Text { text: "→"; color: Floword.muted; font-size: 14px; vertical-alignment: center; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 6px;
                        background: Floword.success.with-alpha(0.2);
                        Text { text: "3"; color: Floword.success; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Tạo Video 1-Chạm"; color: Floword.text; font-size: 12px; font-weight: 600; }
                }
            }
        }


        // 2-COLUMN WORKSPACE
        GridLayout {
            spacing: 18px;
            min-width: 0px;

            // LEFT COLUMN: Character, Voice, Driver, Scene, Script
            StudioCard {
                row: 0;
                col: 0;
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 440px;
                max-height: self.min-height;
                spacing: 14px;

                StudioHeading { title: "1. THIẾT LẬP NHÂN VẬT & MÔ HÌNH"; glyph: Glyph.film; }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: I18n.t("studioOpenTalking.avatar"); color: Floword.text; font-size: 13px; font-weight: 600; }
                    Select { options: StudioOpenTalking.avatar-options; current <=> StudioOpenTalking.avatar-index; changed(index) => { StudioOpenTalking.select-avatar(index); } placeholder: I18n.t("studioOpenTalking.chooseAvatar"); height: 38px; background: Floword.field; border-color: Floword.line; enabled: !StudioOpenTalking.busy; }
                }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: I18n.t("studioOpenTalking.voice"); color: Floword.text; font-size: 13px; font-weight: 600; }
                    Select { options: StudioOpenTalking.voice-options; current <=> StudioOpenTalking.voice-index; placeholder: I18n.t("studioOpenTalking.chooseVoice"); height: 38px; background: Floword.field; border-color: Floword.line; enabled: !StudioOpenTalking.busy; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Text { text: I18n.t("studioOpenTalking.driver"); color: Floword.text; font-size: 13px; font-weight: 600; }
                        Select { options: StudioOpenTalking.model-options; current <=> StudioOpenTalking.model-index; placeholder: I18n.t("studioOpenTalking.noDriver"); height: 38px; background: Floword.field; border-color: Floword.line; enabled: !StudioOpenTalking.busy; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Text { text: I18n.t("studioOpenTalking.scene"); color: Floword.text; font-size: 13px; font-weight: 600; }
                        Select { options: StudioOpenTalking.scene-options; current <=> StudioOpenTalking.scene-index; placeholder: I18n.t("studioOpenTalking.noScene"); height: 38px; background: Floword.field; border-color: Floword.line; enabled: !StudioOpenTalking.busy; }
                    }
                }

                Rectangle { height: 1px; background: Floword.line; }

                StudioHeading { title: "2. TIÊU ĐỀ & KỊCH BẢN"; glyph: Glyph.text-mark; }

                StudioField { label: I18n.t("studioOpenTalking.videoTitle"); value: StudioOpenTalking.title; enabled: !StudioOpenTalking.busy; edited(text) => { StudioOpenTalking.title = text; } }
                StudioField { label: I18n.t("studioOpenTalking.script"); placeholder: I18n.t("studioOpenTalking.scriptHint"); multiline: true; value: StudioOpenTalking.script; enabled: !StudioOpenTalking.busy; edited(text) => { StudioOpenTalking.script = text; } }
            }

            // RIGHT COLUMN: 3D Preview, Preconditions & Creation Trigger
            VerticalLayout {
                row: root.stacked ? 1 : 0;
                col: root.stacked ? 0 : 1;
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 440px;
                spacing: 14px;
                alignment: start;

                // 3D Avatar Preview Screen Card
                Rectangle {
                    background: Floword.surface;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Floword.line-bright;
                    clip: true;
                    // Do not let the source image's intrinsic size stretch the
                    // entire form. Scale with the available window, not the photo.
                    height: Math.clamp(Math.min(self.width * 0.72, root.viewport-height * 0.52), 240px, 480px);

                    // 3D Avatar High-Definition Illustration
                    Image {
                        width: 100%;
                        height: 100%;
                        source: StudioOpenTalking.avatar-preview;
                        image-fit: contain;
                    }

                    // Glassmorphic subtle edge vignette
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: @linear-gradient(180deg, #080D1B40 0%, #00000000 35%, #00000000 65%, #080D1B99 100%);
                    }

                    VerticalLayout {
                        alignment: space-between;
                        padding: 14px;

                        // Top header pills
                        HorizontalLayout {
                            alignment: space-between;
                            Rectangle {
                                background: #000000c0;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #ffffff20;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px;
                                    spacing: 6px;
                                    Rectangle {
                                        width: 8px; height: 8px; border-radius: 4px;
                                        background: StudioOpenTalking.engine-status != "OFFLINE" ? Floword.success : Floword.danger;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "ENGINE " + StudioOpenTalking.engine-status;
                                        color: #ffffff; font-size: 11px; font-weight: 700;
                                    }
                                }
                            }

                            Rectangle {
                                background: #000000c0;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #ffffff20;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px;
                                    spacing: 6px;
                                    Icon { glyph: Glyph.film; size: 12px; tint: Floword.cyan; }
                                    Text {
                                        text: StudioOpenTalking.avatar-options.length > 0 && StudioOpenTalking.avatar-index < StudioOpenTalking.avatar-options.length
                                            ? StudioOpenTalking.avatar-options[StudioOpenTalking.avatar-index]
                                            : "Chưa chọn nhân vật";
                                        color: Floword.text; font-size: 11px; font-weight: 600;
                                    }
                                }
                            }
                        }

                        // Bottom overlay subtitle/voice note
                        Rectangle {
                            background: #000000cc;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #ffffff20;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Icon { glyph: Glyph.volume; size: 14px; tint: Floword.cyan; }
                                Text {
                                    text: StudioOpenTalking.script != "" ? StudioOpenTalking.script : "Xem trước nhân vật ảo & kịch bản hội thoại. Nhập nội dung để bắt đầu kết xuất.";
                                    color: #f1f5f9;
                                    font-size: 12px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Preconditions & Trigger Card
                StudioCard {
                    spacing: 12px;
                    StudioHeading { title: "3. KIỂM TRA ĐIỀU KIỆN & BẮT ĐẦU"; glyph: Glyph.sparkle; }

                    // Condition check items
                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            glyph: StudioOpenTalking.avatar-options.length > 0 ? Glyph.check : Glyph.close;
                            size: 14px;
                            tint: StudioOpenTalking.avatar-options.length > 0 ? Floword.success : Floword.warning;
                        }
                        Text {
                            text: StudioOpenTalking.avatar-options.length > 0 ? "Đã xác nhận nhân vật phát biểu" : "Chưa chọn nhân vật";
                            color: StudioOpenTalking.avatar-options.length > 0 ? Floword.text : Floword.muted;
                            font-size: 12px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            glyph: StudioOpenTalking.voice-options.length > 0 ? Glyph.check : Glyph.close;
                            size: 14px;
                            tint: StudioOpenTalking.voice-options.length > 0 ? Floword.success : Floword.warning;
                        }
                        Text {
                            text: StudioOpenTalking.voice-options.length > 0 ? "Đã nạp giọng đọc AI" : "Chưa chọn giọng nói";
                            color: StudioOpenTalking.voice-options.length > 0 ? Floword.text : Floword.muted;
                            font-size: 12px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            glyph: Glyph.check;
                            size: 14px;
                            tint: Floword.success;
                        }
                        Text {
                            text: StudioOpenTalking.script != "" ? "Kịch bản: Đã nhập nội dung" : "Kịch bản tùy chọn: Để trống (Tự động tạo video cử động tự nhiên)";
                            color: Floword.text;
                            font-size: 12px;
                        }
                    }

                    Text { text: I18n.t("studioOpenTalking.motionNote"); color: Floword.muted; wrap: word-wrap; font-size: 11px; }

                    StudioButton {
                        label: StudioOpenTalking.busy ? "Đang xử lý kết xuất..."
                            : StudioOpenTalking.script != "" ? "Bắt đầu tạo Video Khớp Lời Nói"
                            : "Tạo Video Chuyển Động Chờ (Không cần kịch bản)";
                        primary: true;
                        enabled: !StudioOpenTalking.busy && StudioOpenTalking.catalogs-loaded
                            && StudioOpenTalking.avatar-options.length > 0 && StudioOpenTalking.voice-options.length > 0
                            && StudioOpenTalking.model-options.length > 0;
                        clicked => { StudioOpenTalking.create(); }
                    }
                }
            }
        }

        if StudioOpenTalking.confirm-create || StudioOpenTalking.stop-id != "" || StudioOpenTalking.delete-id != "": StudioCard {
            Text {
                text: StudioOpenTalking.confirm-create ? I18n.t("studioOpenTalking.confirmCreate")
                    : StudioOpenTalking.stop-id != "" ? I18n.t1("studioOpenTalking.confirmStop", StudioOpenTalking.stop-id)
                    : I18n.t1("studioOpenTalking.confirmDelete", StudioOpenTalking.delete-id);
                color: Floword.warning; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                StudioButton {
                    label: I18n.t("studioOpenTalking.confirm"); primary: true; enabled: !StudioOpenTalking.busy;
                    clicked => {
                        if StudioOpenTalking.confirm-create { StudioOpenTalking.create(); }
                        else if StudioOpenTalking.stop-id != "" { StudioOpenTalking.stop(StudioOpenTalking.stop-id); }
                        else { StudioOpenTalking.delete(StudioOpenTalking.delete-id); }
                    }
                }
                StudioButton {
                    label: I18n.t("common.cancel"); enabled: !StudioOpenTalking.busy;
                    clicked => { StudioOpenTalking.confirm-create = false; StudioOpenTalking.stop-id = ""; StudioOpenTalking.delete-id = ""; }
                }
            }
        }
    }

    // TAB 1: KHO NHÂN VẬT (Avatars Catalog)
    if StudioOpenTalking.active-tab == 1: VerticalLayout {
        spacing: 16px;

        StudioCard {
            StudioHeading { title: I18n.t("studioOpenTalking.tabAvatars") + " (" + StudioOpenTalking.avatars.length + ")"; }
            Text { text: "Danh sách các nhân vật ảo đã cấu hình trên máy. Bạn có thể chọn nhân vật để tạo video hoặc phát Livestream."; color: Floword.muted; font-size: 13px; }

            if StudioOpenTalking.avatars.length == 0: Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Floword.line;
                background: Floword.field;

                HorizontalLayout {
                    padding: 30px;
                    alignment: center;
                    Text { text: I18n.t("studioOpenTalking.emptyAvatars"); color: Floword.muted; font-size: 14px; }
                }
            }

            for avatar[index] in StudioOpenTalking.avatars: Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Floword.line;
                background: Floword.field;

                HorizontalLayout {
                    padding: 14px;
                    spacing: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 14px;

                        // Avatar Thumbnail Box
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 10px;
                            background: #6366f122;
                            border-width: 1px;
                            border-color: #6366f144;

                            Text {
                                text: "👤";
                                font-size: 22px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: avatar.label;
                                color: Floword.text;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Model: " + avatar.model-type + " · ID: " + avatar.id;
                                color: Floword.muted;
                                font-size: 12px;
                            }
                        }
                    }

                    // Actions
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        StudioButton {
                            label: "Chọn tạo video";
                            clicked => {
                                StudioOpenTalking.select-avatar(index);
                                StudioOpenTalking.active-tab = 0;
                            }
                        }

                        StudioButton {
                            label: "Dùng cho LIVE";
                            primary: true;
                            clicked => {
                                StudioOpenTalking.select-avatar(index);
                                StudioOpenTalking.active-tab = 3;
                            }
                        }
                    }
                }
            }
        }
    }

    // TAB 2: GIỌNG NÓI & LỒNG TIẾNG (Voices)
    if StudioOpenTalking.active-tab == 2: VerticalLayout {
        spacing: 16px;

        StudioCard {
            StudioHeading { title: I18n.t("studioOpenTalking.tabVoices") + " (" + StudioOpenTalking.voices.length + ")"; }
            Text { text: "Các giọng đọc TTS sẵn sàng cho lồng tiếng video và tương tác livestream."; color: Floword.muted; font-size: 13px; }

            if StudioOpenTalking.voices.length == 0: Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Floword.line;
                background: Floword.field;

                HorizontalLayout {
                    padding: 30px;
                    alignment: center;
                    Text { text: I18n.t("studioOpenTalking.emptyVoices"); color: Floword.muted; font-size: 14px; }
                }
            }

            for voice[index] in StudioOpenTalking.voices: Rectangle {
                border-radius: 12px;
                border-width: 1px;
                border-color: Floword.line;
                background: Floword.field;

                HorizontalLayout {
                    padding: 14px;
                    spacing: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 14px;

                        // Mic Icon Box
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 10px;
                            background: #ec489922;
                            border-width: 1px;
                            border-color: #ec489944;

                            Text {
                                text: "🎙️";
                                font-size: 20px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: voice.label;
                                color: Floword.text;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Mã giọng: " + voice.id;
                                color: Floword.muted;
                                font-size: 12px;
                            }
                        }
                    }

                    // Actions
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        StudioButton {
                            label: "Nghe thử giọng";
                            clicked => {
                                StudioOpenTalking.test-voice(index);
                            }
                        }

                        StudioButton {
                            label: "Chọn giọng này";
                            primary: true;
                            clicked => {
                                StudioOpenTalking.voice-index = index;
                                StudioOpenTalking.active-tab = 0;
                            }
                        }
                    }
                }
            }
        }
    }

    // TAB 3: HỘI THOẠI TRỰC TIẾP
    if StudioOpenTalking.active-tab == 3: StudioCard {
        StudioHeading { title: "Hội Thoại Trực Tiếp (TikTok LIVE Studio)"; }
        Text {
            text: "Mở màn hình TikTok LIVE Studio 3 cột đầy đủ (Màn hình Live, sóng âm, ghim sản phẩm & sự kiện). Bấm nút bên dưới để vào phiên Live:";
            color: Floword.muted;
            font-size: 13px;
        }
        HorizontalLayout {
            StudioButton {
                label: "Mở TikTok LIVE Studio";
                primary: true;
                clicked => { root.navigate-to-live(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // TAB 4: LỊCH SỬ VIDEO (Video Jobs)
    if StudioOpenTalking.active-tab == 4: VerticalLayout {
        spacing: 16px;

        StudioCard {
            StudioHeading { title: I18n.t("studioOpenTalking.history") + " (" + StudioOpenTalking.jobs.length + ")"; }

            if StudioOpenTalking.catalogs-loaded && StudioOpenTalking.jobs.length == 0:
                Text { text: I18n.t("studioOpenTalking.empty"); color: Floword.muted; wrap: word-wrap; font-size: 13px; }

            for job in StudioOpenTalking.jobs: VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: job.title;
                        color: Floword.text;
                        font-size: 15px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    // Status Badge
                    Rectangle {
                        border-radius: 6px;
                        background: job.status == "completed" ? #10b98122 : job.status == "processing" ? #3b82f622 : #ef444422;
                        border-width: 1px;
                        border-color: job.status == "completed" ? #10b98155 : job.status == "processing" ? #3b82f655 : #ef444455;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;

                            Text {
                                text: job.status;
                                color: job.status == "completed" ? #34d399 : job.status == "processing" ? #60a5fa : #f87171;
                                font-size: 11px;
                                font-weight: 700;
                            }
                        }
                    }
                }

                Text { text: "ID: " + job.id + " · Driver: " + job.driver + " · Thời lượng: " + job.duration + " · Ngày tạo: " + job.created; color: Floword.muted; font-size: 12px; }

                HorizontalLayout {
                    spacing: 8px;
                    if job.status == "queued" || job.status == "processing": StudioButton {
                        label: I18n.t("studioOpenTalking.stop"); enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.stop-id = job.id; }
                    }
                    if job.status == "completed": StudioButton {
                        label: "▶ Xem video"; primary: true; enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.play-video(job.id); }
                    }
                    if job.status == "completed": StudioButton {
                        label: "Dùng cho LIVE"; enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.use-live-video(job.id); root.navigate-to-live(); }
                    }
                    if job.status == "completed": StudioButton {
                        label: "📁 Mở thư mục"; enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.open-export-folder(); }
                    }
                    if job.status == "completed": StudioButton {
                        label: I18n.t("studioOpenTalking.importVideo"); enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.import-video(job.id); }
                    }
                    if job.status == "completed" || job.status == "failed" || job.status == "cancelled": StudioButton {
                        label: I18n.t("studioOpenTalking.delete"); enabled: !StudioOpenTalking.busy;
                        clicked => { StudioOpenTalking.delete-id = job.id; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 1px; background: Floword.line; }
            }
        }
    }
}
