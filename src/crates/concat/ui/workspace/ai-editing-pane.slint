import { Theme } from "../theme/theme.slint";
import { Button, Select, NumberField } from "../primitives/primitives.slint";
import { StudioField } from "studio-chrome.slint";
import { StudioAi } from "studio-ai.slint";
import { PaneScroll } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";

export global AiEditing {
    in-out property <string> prompt;
    in-out property <string> status: "Open a project, load models, then request a draft";
    in-out property <[string]> changes;
    in-out property <bool> busy;
    in-out property <bool> ready;
    in-out property <bool> preview-ready;
    in-out property <float> time;
    in-out property <image> before;
    in-out property <image> after;
    callback generate();
    callback cancel();
    callback approve();
    callback reject();
    callback preview();
    callback synchronize();
}

export component AiEditingPane inherits Rectangle {
    in property <int> pane-seat;
    in property <bool> pane-removable: true;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();
    background: Theme.panel;
    Timer { interval: 1000ms; running: true; triggered => { AiEditing.synchronize(); } }
    VerticalLayout {
        spacing: 8px;
        padding: 10px;
        HorizontalLayout {
            Text { text: "AI Editing · native draft"; color: Theme.fg; font-size: Theme.fs; horizontal-stretch: 1; }
            PaneSwitcher { kind: PaneKind.ai-editing; seat: root.pane-seat;
                removable: root.pane-removable;
                picked(kind) => { root.pane-picked(kind); }
                removed => { root.pane-removed(); }
            }
        }
        PaneScroll {
            VerticalLayout {
                spacing: 10px;
                alignment: start;
                Text { text: "AI proposes split, trim, move, remove and titles against this whole active timeline (up to 256 clips). It receives clip IDs and timing, not media paths. Your timeline is unchanged until Approve. Sending a request may use your provider quota."; wrap: word-wrap; color: Theme.fg-muted; font-size: Theme.fs; }
                Button { label: "Load configured models"; enabled: !StudioAi.busy && !AiEditing.busy; clicked => { StudioAi.load-models(); } }
                Select { options: StudioAi.models; current <=> StudioAi.model-index; enabled: !AiEditing.busy; }
                Text { text: StudioAi.status; wrap: word-wrap; color: Theme.fg-muted; font-size: Theme.fs; }
                StudioField { label: "Editing instruction"; placeholder: "Describe changes to this timeline"; multiline: true; value <=> AiEditing.prompt; enabled: !AiEditing.busy; }
                Button { label: "Request AI draft"; primary: true; enabled: !AiEditing.busy && StudioAi.models.length > 0; clicked => { AiEditing.generate(); } }
                if AiEditing.busy: Button { label: "Cancel / ignore response"; clicked => { AiEditing.cancel(); } }
                Text { text: AiEditing.status; wrap: word-wrap; color: Theme.fg-muted; font-size: Theme.fs; }
                for change in AiEditing.changes: Text { text: change; wrap: word-wrap; color: Theme.fg; font-size: Theme.fs; }
                if AiEditing.ready: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Preview time (seconds)"; color: Theme.fg-muted; font-size: Theme.fs; }
                    NumberField { value <=> AiEditing.time; minimum: 0; maximum: 360000; step: 1; }
                    Button { label: "Render before / draft"; enabled: !AiEditing.busy; clicked => { AiEditing.preview(); } }
                    if AiEditing.preview-ready: VerticalLayout {
                        Text { text: "Current timeline"; color: Theme.fg; font-size: Theme.fs; }
                        Image { source: AiEditing.before; height: 180px; image-fit: contain; }
                        Text { text: "Isolated draft · not applied"; color: Theme.fg; font-size: Theme.fs; }
                        Image { source: AiEditing.after; height: 180px; image-fit: contain; }
                    }
                    Button { label: "Approve · apply as one undo"; primary: true; enabled: !AiEditing.busy && AiEditing.preview-ready; clicked => { AiEditing.approve(); } }
                    Button { label: "Reject draft"; enabled: !AiEditing.busy; clicked => { AiEditing.reject(); } }
                }
            }
        }
    }
}
