import { Theme } from "../theme/theme.slint";
import { Button, Select, NumberField } from "../primitives/primitives.slint";
import { StudioField } from "studio-chrome.slint";
import { StudioAi } from "studio-ai.slint";
import { PaneScroll } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";

export global AiEditing {
    in-out property <string> prompt;
    in-out property <bool> external-mode: true;
    in-out property <bool> auto-apply: false;
    in-out property <string> selected-ai: "gemini";
    in-out property <bool> waiting-result: false;
    in-out property <bool> project-open;
    in-out property <string> project-info;
    in-out property <bool> bridge-enabled;
    in-out property <bool> bridge-busy;
    in-out property <bool> web-connected;
    in-out property <string> mcp-config;
    in-out property <string> web-context;
    in-out property <string> web-result;
    in-out property <bool> web-import-open;
    in-out property <bool> show-mcp;
    in-out property <bool> agent-mode: false;
    in-out property <float> max-turns: 6;
    in-out property <string> status: "";
    in-out property <[string]> changes;
    in-out property <bool> busy;
    in-out property <bool> ready;
    in-out property <bool> preview-ready;
    in-out property <float> time;
    in-out property <image> before;
    in-out property <image> after;
    callback generate(); callback cancel(); callback approve(); callback reject();
    callback preview(); callback synchronize(); callback toggle-bridge();
    callback save-mcp-config(); callback export-context(); callback import-plan();
    callback prepare-web-context(); callback submit-web-result(); callback open-web-chat(string);
    callback dispatch-ai(string);
    callback connect-web-chat(string); callback disconnect-web-chat();
}

export component AiEditingPane inherits Rectangle {
    // Local disclosure state must not change the native project/bridge state.
    property <bool> show-api-tools: false;
    in property <bool> embedded: false;
    in property <int> pane-seat;
    in property <bool> pane-removable: true;
    callback pane-picked(kind: PaneKind); callback pane-removed();
    background: Theme.panel;
    min-width: 0px;
    clip: true;
    copy-buffer := TextInput {
        width: 1px; height: 1px; opacity: 0;
        text: AiEditing.web-context; read-only: true;
    }
    paste-buffer := TextInput {
        width: 1px; height: 1px; opacity: 0;
        text <=> AiEditing.web-result;
    }
    Timer { interval: 500ms; running: true; triggered => { AiEditing.synchronize(); } }
    VerticalLayout {
        spacing: 8px; padding: 10px;
        HorizontalLayout {
            Text { text: "Trợ lý chỉnh sửa AI"; color: Theme.fg; font-size: Theme.fs; horizontal-stretch: 1; }
            if !root.embedded: PaneSwitcher { kind: PaneKind.ai-editing; seat: root.pane-seat; removable: root.pane-removable;
                picked(kind) => { root.pane-picked(kind); } removed => { root.pane-removed(); }
            }
        }
        PaneScroll {
            VerticalLayout {
                spacing: 12px; alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    Button { label: "Chat web"; block: true; primary: AiEditing.external-mode; enabled: !AiEditing.busy; clicked => { AiEditing.external-mode = true; } }
                    Button { label: "Dùng API key"; block: true; primary: !AiEditing.external-mode; enabled: !AiEditing.busy; clicked => { AiEditing.external-mode = false; } }
                }
                if AiEditing.external-mode: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 6px;
                        Button { label: "ChatGPT"; block: true; primary: AiEditing.selected-ai == "chatgpt"; enabled: !AiEditing.bridge-busy; clicked => { AiEditing.selected-ai = "chatgpt"; } }
                        Button { label: "Gemini"; block: true; primary: AiEditing.selected-ai == "gemini"; enabled: !AiEditing.bridge-busy; clicked => { AiEditing.selected-ai = "gemini"; } }
                        Button { label: "Claude"; block: true; primary: AiEditing.selected-ai == "claude"; enabled: !AiEditing.bridge-busy; clicked => { AiEditing.selected-ai = "claude"; } }
                    }
                    Button {
                        label: AiEditing.bridge-busy ? "Đang kết nối…" : AiEditing.web-connected ? "Quay lại cửa sổ chat" : "Mở chat & kết nối dự án";
                        block: true; primary: true; enabled: AiEditing.project-open && !AiEditing.bridge-busy;
                        clicked => { AiEditing.connect-web-chat(AiEditing.selected-ai); }
                    }
                    if AiEditing.web-connected: Button {
                        label: "Ngắt kết nối chat"; block: true;
                        clicked => { AiEditing.disconnect-web-chat(); }
                    }
                }
                if !AiEditing.external-mode: VerticalLayout {
                    spacing: 8px;
                    Select { options: StudioAi.models; current <=> StudioAi.model-index; enabled: !AiEditing.busy && !StudioAi.busy; placeholder: "Chọn model đã cấu hình"; }
                    StudioField { label: "Yêu cầu chỉnh sửa"; placeholder: "Nhập yêu cầu cắt hoặc sửa timeline..."; multiline: true; input-height: 80px; compact: true; value: AiEditing.prompt; edited(text) => { AiEditing.prompt = text; } enabled: !AiEditing.busy; }
                    Button { label: "Tạo bản nháp chỉnh sửa"; block: true; primary: true; enabled: AiEditing.project-open && !AiEditing.busy && AiEditing.prompt != ""; clicked => { AiEditing.generate(); } }
                }
                if AiEditing.status != "": Text { text: AiEditing.status; wrap: word-wrap; color: Theme.fg-muted; font-size: Theme.fs; }
                if AiEditing.ready: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Bản nháp chỉnh sửa đã sẵn sàng"; color: Theme.fg; font-size: Theme.fs; }
                    Button { label: "Áp dụng vào Timeline"; block: true; primary: true; enabled: !AiEditing.busy; clicked => { AiEditing.approve(); } }
                    Button { label: "Bỏ qua bản nháp"; block: true; enabled: !AiEditing.busy; clicked => { AiEditing.reject(); } }
                }
            }
        }
    }
}
