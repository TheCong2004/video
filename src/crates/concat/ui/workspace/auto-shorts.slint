// SPDX-License-Identifier: AGPL-3.0-or-later
// Native review surface. All analysis, playback and export are controller callbacks.
import { Floword } from "../theme/floword.slint";
import { Select, NumberField } from "../primitives/primitives.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField } from "studio-chrome.slint";
import { PaneScroll } from "pane.slint";

export struct ShortsRow {
    id: string,
    title: string,
    hook: string,
    reason: string,
    range: string,
    score: string,
    review: string,
    status: string,
    selected: bool,
    thumbnail: image,
}

export struct TranscriptRow {
    id: string,
    time: string,
    text: string,
    marker: string,
}

export global AutoShorts {
    in-out property <string> source-label;
    in-out property <string> source-info;
    in-out property <float> source-duration;
    in-out property <string> transcript-label;
    in-out property <string> status;
    in-out property <string> diagnostics;
    in-out property <string> analysis-note;
    in-out property <bool> analyzed;
    in-out property <bool> busy;
    in-out property <bool> has-source;
    in-out property <float> progress;
    in-out property <int> target-count: 3;
    in-out property <int> min-duration: 15;
    in-out property <int> max-duration: 60;
    in-out property <int> aspect-index: 0;
    in-out property <int> quality-index: 0;
    in-out property <int> caption-index: 0;
    in-out property <int> genre-index: 0;
    in-out property <int> ai-mode-index: 0;
    in-out property <bool> advanced: false;
    in-out property <string> output-label;
    in-out property <int> selected-count;
    in-out property <int> result-count;
    in-out property <string> query;
    in-out property <int> sort-index;
    in-out property <bool> review-only;
    in-out property <bool> selected-only;
    in-out property <[ShortsRow]> rows;
    in-out property <bool> watch-enabled;
    in-out property <string> watch-label;
    in-out property <int> cue-count;
    in-out property <[TranscriptRow]> transcript-rows;
    in-out property <string> transcript-query;
    in-out property <string> transcript-page;
    in-out property <bool> transcript-previous;
    in-out property <bool> transcript-next;
    in-out property <string> transcript-range;
    in-out property <string> transcript-notice;
    in-out property <bool> transcript-has-range;
    in-out property <string> cue-editor-label;
    in-out property <string> cue-editor-text;
    in-out property <bool> transcript-undo;
    in-out property <bool> transcript-redo;
    in-out property <bool> repetitions-only;
    in-out property <bool> repetitions-scanned;
    in-out property <int> repetition-count;
    callback find-repetitions();
    callback transcript-search();
    callback transcript-paginate(int);
    callback transcript-select(string, int);
    callback transcript-save();
    callback transcript-history(bool);
    callback transcript-create();
    callback transcript-export();
    callback choose-source();
    callback choose-transcript();
    callback analyze();
    callback cancel();
    callback toggle-selected(string);
    callback preview(string);
    callback stage(string);
    callback export-selected();
    callback choose-output();
    callback open-output();
    callback retry();
    callback choose-watch();
    callback toggle-watch();
    callback refresh-results();
    in-out property <string> url-query;
    callback import-url();
    callback activate-preview();
    callback toggle-preview();
}

component ShortsNumber inherits VerticalLayout {
    in property <string> label;
    in property <int> value;
    in property <int> minimum: 1;
    in property <int> maximum: 12;
    callback edited(int);
    min-width: 0px;
    preferred-width: 156px;
    horizontal-stretch: 1;
    spacing: 6px;
    Text { text: root.label; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
    NumberField {
        value: root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step: 1;
        enabled: !AutoShorts.busy;
        changed(value) => { root.edited(Math.round(value)); }
    }
}

component ShortsChoice inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in-out property <int> current;
    min-width: 0px;
    preferred-width: 220px;
    horizontal-stretch: 1;
    spacing: 6px;
    Text { text: root.label; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
    Select { min-width: 0px; options: root.options; current <=> root.current; enabled: !AutoShorts.busy; }
}

export component AutoShortsPage inherits VerticalLayout {
    property <bool> duration-blocked: AutoShorts.has-source && AutoShorts.source-duration < AutoShorts.min-duration;
    private property <bool> diagnostics-open;
    min-width: 0px;
    spacing: 16px;
    alignment: start;
    FlexboxLayout {
        min-width: 0px;
        spacing: 12px;
        Text { text: "Video dài → clip ngắn"; color: Floword.text; font-size: 20px; font-weight: 700; wrap: word-wrap; min-width: 0px; horizontal-stretch: 1; }
        StudioButton { label: AutoShorts.advanced ? "Thu gọn nâng cao" : "Tùy chọn nâng cao"; compact: true; clicked => { AutoShorts.advanced = !AutoShorts.advanced; } }
    }
    Text { text: "Ví dụ: video 20 phút → 3 clip dài 15–60 giây. Lấy từ video có sẵn, không tạo thêm cảnh mới."; color: Floword.muted; font-size: 13px; wrap: word-wrap; }

    StudioCard {
        padding-h: 16px; padding-v: 16px;
        StudioHeading { title: "1. Chọn video gốc"; }
        Text { text: AutoShorts.has-source ? AutoShorts.source-label : "Chưa chọn video"; color: Floword.text; font-size: 14px; font-weight: 600; wrap: word-wrap; }
        if AutoShorts.source-info != "": Text { text: AutoShorts.source-info; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioButton { label: AutoShorts.has-source ? "Đổi video" : "Chọn video"; primary: !AutoShorts.has-source; enabled: !AutoShorts.busy; clicked => { AutoShorts.choose-source(); } }
            if AutoShorts.has-source: StudioButton { label: "Thêm phụ đề (nếu có)"; enabled: !AutoShorts.busy; clicked => { AutoShorts.choose-transcript(); } }
        }
        if AutoShorts.transcript-label != "": Text { text: AutoShorts.transcript-label; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
        if root.duration-blocked: Text {
            text: AutoShorts.source-duration < 4 ? "Video chỉ dài " + Math.round(AutoShorts.source-duration * 10) / 10 + " giây. Cần video dài ít nhất 4 giây; tính năng này không kéo dài video."
                : "Video chỉ dài " + Math.round(AutoShorts.source-duration * 10) / 10 + " giây, nhưng clip ngắn nhất đang đặt " + AutoShorts.min-duration + " giây. Chọn video dài hơn hoặc giảm độ dài bên dưới.";
            color: Floword.warning; font-size: 13px; wrap: word-wrap;
        }
    }

    StudioCard {
        padding-h: 16px; padding-v: 16px;
        StudioHeading { title: "2. Chọn độ dài clip"; }
        FlexboxLayout {
            min-width: 0px; spacing: 12px;
            ShortsNumber { label: "Lấy tối đa bao nhiêu clip?"; value: AutoShorts.target-count; minimum: 1; maximum: 12; edited(value) => { AutoShorts.target-count = value; } }
            ShortsNumber { label: "Độ dài từ (giây)"; value: AutoShorts.min-duration; minimum: 4; maximum: 180; edited(value) => { AutoShorts.min-duration = value; } }
            ShortsNumber { label: "Đến (giây)"; value: AutoShorts.max-duration; minimum: 4; maximum: 180; edited(value) => { AutoShorts.max-duration = value; } }
        }
        if AutoShorts.advanced: FlexboxLayout {
            min-width: 0px; spacing: 12px;
            ShortsChoice { label: "Tỷ lệ khung hình"; options: ["9:16 · Dọc", "16:9 · Ngang", "1:1 · Vuông", "4:5 · Bài đăng"]; current <=> AutoShorts.aspect-index; }
            ShortsChoice { label: "Độ phân giải"; options: ["720p", "1080p", "4K"]; current <=> AutoShorts.quality-index; }
            ShortsChoice { label: "Kiểu phụ đề"; options: ["Không thêm phụ đề", "Clean Minimal", "TikTok Bold", "Podcast", "Cinematic", "Gaming"]; current <=> AutoShorts.caption-index; }
        }
        if AutoShorts.advanced: VerticalLayout {
            spacing: 12px; min-width: 0px;
            FlexboxLayout {
                min-width: 0px; spacing: 12px;
                ShortsChoice { label: "Cách phân tích"; options: ["Bằng chứng cục bộ", "AI đã cấu hình"]; current <=> AutoShorts.ai-mode-index; }
                ShortsChoice { label: "Loại nội dung"; options: ["Tự động", "Podcast", "Livestream", "Gaming", "Giáo dục", "Review", "Bán hàng", "Phỏng vấn", "Vlog", "Giải trí", "Âm nhạc", "Hình ảnh"]; current <=> AutoShorts.genre-index; }
            }
            Text { text: AutoShorts.ai-mode-index == 1 ? "Chỉ gửi transcript/bằng chứng khi bấm Phân tích; dùng model và hạn mức đã cấu hình trong AI Keys. Không tự gửi video lên dịch vụ AI." : "Phân tích cục bộ dựa trên dữ liệu nguồn; không giả vờ hiểu ngữ nghĩa khi chưa dùng AI. Điểm là gợi ý, bạn cần xem lại đoạn trước khi xuất."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
        }
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioButton { label: AutoShorts.busy ? "Đang tìm đoạn…" : AutoShorts.analyzed ? "Tìm lại đoạn" : "Tìm đoạn để cắt"; primary: true; enabled: AutoShorts.has-source && !AutoShorts.busy && !root.duration-blocked && AutoShorts.min-duration <= AutoShorts.max-duration; clicked => { if AutoShorts.analyzed { AutoShorts.retry(); } else { AutoShorts.analyze(); } } }
            if AutoShorts.busy: StudioButton { label: "Hủy tác vụ"; clicked => { AutoShorts.cancel(); } }
        }
        if AutoShorts.min-duration > AutoShorts.max-duration: Text { text: "Thời lượng ngắn nhất không được lớn hơn dài nhất."; color: #fbbf24; font-size: 12px; wrap: word-wrap; }
        if AutoShorts.busy: Rectangle {
            height: 5px; min-width: 0px; border-radius: 3px; background: Floword.field;
            Rectangle { width: parent.width * Math.max(0, Math.min(1, AutoShorts.progress)); height: parent.height; border-radius: 3px; background: Floword.cyan; }
        }
        if AutoShorts.status != "": Text { text: AutoShorts.status; color: Floword.muted; font-size: 13px; wrap: word-wrap; }
        if AutoShorts.analysis-note != "": Text { text: AutoShorts.analysis-note; color: Floword.warning; font-size: 12px; wrap: word-wrap; }
        if AutoShorts.diagnostics != "": StudioButton { label: root.diagnostics-open ? "Ẩn thông tin kiểm tra" : "Thông tin kiểm tra"; compact: true; clicked => { root.diagnostics-open = !root.diagnostics-open; } }
        if root.diagnostics-open && AutoShorts.diagnostics != "": Text { text: AutoShorts.diagnostics; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
    }

    if AutoShorts.analyzed: StudioCard {
        padding-h: 16px; padding-v: 16px; spacing: 10px;
        StudioHeading { title: "Cắt theo lời thoại"; }
        Text { text: AutoShorts.cue-count > 0 ? "Tìm câu → chọn Bắt đầu và Kết thúc → Thêm clip. Mốc cắt theo cả câu, không chính xác từng từ." : "Chưa có lời thoại. Thêm phụ đề SRT/VTT đúng video rồi tìm lại đoạn để hệ thống tự động nhận diện."; color: Floword.muted; font-size: 13px; wrap: word-wrap; }
        if AutoShorts.cue-count > 0: VerticalLayout {
            min-width: 0px; spacing: 10px;
            StudioField { label: "Tìm trong lời thoại"; placeholder: "Nhập câu hoặc cụm từ có dấu…"; compact: true; value: AutoShorts.transcript-query; enabled: !AutoShorts.busy; edited(text) => { AutoShorts.transcript-query = text; AutoShorts.transcript-search(); } }
            FlexboxLayout {
                min-width: 0px; spacing: 8px;
                StudioButton { label: AutoShorts.repetitions-scanned ? "Tìm lại câu nói lặp" : "Tìm câu nói lặp"; compact: true; enabled: !AutoShorts.busy; clicked => { AutoShorts.find-repetitions(); } }
                StudioButton { label: AutoShorts.repetitions-only ? "Hiện mọi câu" : "Chỉ hiện câu có thể lặp"; compact: true; enabled: !AutoShorts.busy && AutoShorts.repetition-count > 0; clicked => { AutoShorts.repetitions-only = !AutoShorts.repetitions-only; AutoShorts.transcript-search(); } }
            }
            if AutoShorts.repetitions-scanned: Text { text: AutoShorts.repetition-count + " cặp có thể lặp (tối đa 2.000). Chỉ so chữ ở các câu gần nhau, không kết luận bản nào tốt hơn và không tự xóa."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
            Text { text: AutoShorts.transcript-page; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
            PaneScroll {
                height: AutoShorts.transcript-rows.length > 0 ? 300px : 48px;
                min-width: 0px;
                property <string> current-page: AutoShorts.transcript-page;
                changed current-page => { self.scroll-to-top(); }
                if AutoShorts.transcript-rows.length == 0: Text { text: "Không có câu khớp. Thử cụm từ khác hoặc xóa từ khóa."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
                for cue in AutoShorts.transcript-rows: VerticalLayout {
                    min-width: 0px; spacing: 6px;
                    Text { text: cue.time + (cue.marker != "" ? " · " + cue.marker : ""); color: Floword.cyan; font-size: 12px; wrap: word-wrap; }
                    Text { text: cue.text; color: Floword.text; font-size: 13px; wrap: word-wrap; }
                    FlexboxLayout {
                        min-width: 0px; spacing: 6px;
                        StudioButton { label: "Bắt đầu"; compact: true; enabled: !AutoShorts.busy; clicked => { AutoShorts.transcript-select(cue.id, 0); } }
                        StudioButton { label: "Kết thúc"; compact: true; enabled: !AutoShorts.busy; clicked => { AutoShorts.transcript-select(cue.id, 1); } }
                        StudioButton { label: "Sửa câu"; compact: true; enabled: !AutoShorts.busy; clicked => { AutoShorts.transcript-select(cue.id, 2); } }
                    }
                }
            }
            FlexboxLayout {
                min-width: 0px; spacing: 8px;
                StudioButton { label: "Trang trước"; compact: true; enabled: !AutoShorts.busy && AutoShorts.transcript-previous; clicked => { AutoShorts.transcript-paginate(-1); } }
                StudioButton { label: "Trang sau"; compact: true; enabled: !AutoShorts.busy && AutoShorts.transcript-next; clicked => { AutoShorts.transcript-paginate(1); } }
            }
            if AutoShorts.cue-editor-label != "": VerticalLayout {
                min-width: 0px; spacing: 8px;
                StudioField { label: AutoShorts.cue-editor-label; compact: true; value: AutoShorts.cue-editor-text; enabled: !AutoShorts.busy; edited(text) => { AutoShorts.cue-editor-text = text; } }
                StudioButton { label: "Lưu câu đã sửa"; compact: true; enabled: !AutoShorts.busy; clicked => { AutoShorts.transcript-save(); } }
            }
            FlexboxLayout {
                min-width: 0px; spacing: 8px;
                StudioButton { label: "Hoàn tác lời thoại"; compact: true; enabled: !AutoShorts.busy && AutoShorts.transcript-undo; clicked => { AutoShorts.transcript-history(false); } }
                StudioButton { label: "Làm lại"; compact: true; enabled: !AutoShorts.busy && AutoShorts.transcript-redo; clicked => { AutoShorts.transcript-history(true); } }
                StudioButton { label: "Lưu bản phụ đề SRT"; compact: true; enabled: !AutoShorts.busy; clicked => { AutoShorts.transcript-export(); } }
            }
            Text { text: AutoShorts.transcript-range; color: Floword.cyan; font-size: 13px; wrap: word-wrap; }
            StudioButton { label: "Thêm vùng chọn vào danh sách clip"; primary: true; enabled: !AutoShorts.busy && AutoShorts.transcript-has-range; clicked => { AutoShorts.transcript-create(); } }
            if AutoShorts.transcript-notice != "": Text { text: AutoShorts.transcript-notice; color: Floword.cyan; font-size: 13px; wrap: word-wrap; }
            Text { text: "Sửa lời thoại chỉ đổi phụ đề, không đổi tiếng nói. Các thay đổi ở phiên này: lưu bản SRT để giữ lại trước khi đổi nguồn, tìm lại đoạn hoặc đóng app. Clip mới vẫn cần xem trước và chọn xuất."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
        }
    }

    if AutoShorts.result-count > 0: StudioHeading { title: "3. Xem và chọn clip · đã chọn " + AutoShorts.selected-count + "/" + AutoShorts.result-count; }
    if AutoShorts.result-count > 0: StudioCard {
        padding-h: 16px; padding-v: 16px; spacing: 10px;
        StudioField { label: "Tìm trong kết quả"; placeholder: "Tiêu đề, mở đầu hoặc lý do…"; compact: true; value: AutoShorts.query; enabled: !AutoShorts.busy; edited(text) => { AutoShorts.query = text; AutoShorts.refresh-results(); } }
        ShortsChoice { label: "Sắp xếp"; options: ["Điểm cao trước", "Thời gian nguồn", "Thời lượng ngắn trước"]; current: AutoShorts.sort-index; changed current => { AutoShorts.sort-index = self.current; AutoShorts.refresh-results(); } }
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioButton { label: AutoShorts.review-only ? "✓ Chỉ đoạn cần xem lại" : "Chỉ đoạn cần xem lại"; compact: true; primary: false; enabled: !AutoShorts.busy; clicked => { AutoShorts.review-only = !AutoShorts.review-only; AutoShorts.refresh-results(); } }
            StudioButton { label: AutoShorts.selected-only ? "✓ Chỉ đoạn đã chọn" : "Chỉ đoạn đã chọn"; compact: true; primary: false; enabled: !AutoShorts.busy; clicked => { AutoShorts.selected-only = !AutoShorts.selected-only; AutoShorts.refresh-results(); } }
        }
        Text { text: "Bộ lọc chỉ đổi danh sách đang xem. Các đoạn đã chọn vẫn được giữ và vẫn nằm trong lần xuất."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
    }
    if AutoShorts.rows.length == 0 && AutoShorts.result-count > 0: StudioCard {
        padding-h: 16px; padding-v: 16px;
        Text { text: AutoShorts.busy ? "Đợi kết quả từ tác vụ đang chạy. Chưa có đoạn nào sẵn sàng để xuất." : AutoShorts.result-count > 0 ? "Không có đoạn khớp bộ lọc hiện tại. Xóa từ khóa hoặc tắt bộ lọc; các lựa chọn trước đó vẫn được giữ." : "Chưa có kết quả. Chọn video và bấm Phân tích; chỉ các đoạn đã kiểm tra hợp lệ mới xuất hiện ở đây."; color: Floword.muted; font-size: 13px; wrap: word-wrap; }
    }
    for row in AutoShorts.rows: StudioCard {
        padding-h: 16px; padding-v: 16px; spacing: 10px;
        FlexboxLayout {
            min-width: 0px; spacing: 12px;
            Image { source: row.thumbnail; width: 112px; height: 70px; image-fit: contain; }
            VerticalLayout {
                min-width: 0px; preferred-width: 260px; horizontal-stretch: 1; spacing: 5px;
                Text { text: row.title; color: Floword.text; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                Text { text: row.range + (row.score != "" ? " · " + row.score : ""); color: Floword.cyan; font-size: 12px; wrap: word-wrap; }
                if row.status != "": Text { text: row.status; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
            }
        }
        if row.hook != "": Text { text: "Mở đầu: " + row.hook; color: Floword.text; font-size: 13px; wrap: word-wrap; }
        if row.reason != "": Text { text: row.reason; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
        if row.review != "": Text { text: row.review; color: #fbbf24; font-size: 12px; wrap: word-wrap; }
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioButton { label: row.selected ? "✓ Đã chọn" : "Chọn đoạn này"; compact: true; primary: false; enabled: !AutoShorts.busy; clicked => { AutoShorts.toggle-selected(row.id); } }
            StudioButton { label: "Xem đoạn"; compact: true; enabled: !AutoShorts.busy; clicked => { AutoShorts.preview(row.id); } }
            StudioButton { label: "Dựng trên timeline"; compact: true; enabled: !AutoShorts.busy; clicked => { AutoShorts.stage(row.id); } }
        }
    }

    if AutoShorts.result-count > 0: StudioCard {
        padding-h: 16px; padding-v: 16px;
        StudioHeading { title: "Lưu thành video"; }
        Text { text: AutoShorts.output-label != "" ? AutoShorts.output-label : "Chọn thư mục lưu trước khi xuất. Không tự ghi đè video đang có."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioButton { label: "Chọn nơi lưu"; enabled: !AutoShorts.busy; clicked => { AutoShorts.choose-output(); } }
            StudioButton { label: "Xuất " + AutoShorts.selected-count + " đoạn đã chọn"; primary: true; enabled: !AutoShorts.busy && AutoShorts.selected-count > 0 && AutoShorts.output-label != ""; clicked => { AutoShorts.export-selected(); } }
            StudioButton { label: "Mở thư mục"; enabled: !AutoShorts.busy && AutoShorts.output-label != ""; clicked => { AutoShorts.open-output(); } }
        }
        Text { text: "Xuất video không tự đăng bài. Có thể hoàn tác chỉnh sửa trên timeline."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
    }

    if AutoShorts.advanced: StudioCard {
        padding-h: 16px; padding-v: 16px;
        StudioHeading { title: "Theo dõi thư mục nguồn"; }
        Text { text: AutoShorts.watch-label != "" ? AutoShorts.watch-label : "Chưa chọn thư mục theo dõi."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioButton { label: "Chọn thư mục"; enabled: !AutoShorts.busy && !AutoShorts.watch-enabled; clicked => { AutoShorts.choose-watch(); } }
            StudioButton { label: AutoShorts.watch-enabled ? "Dừng theo dõi" : "Bật theo dõi"; primary: AutoShorts.watch-enabled; enabled: !AutoShorts.busy && AutoShorts.watch-label != ""; clicked => { AutoShorts.toggle-watch(); } }
        }
        Text { text: "Chỉ xử lý tệp trong thư mục bạn chọn. Không tự xuất hoặc đăng bài khi chưa duyệt kết quả."; color: Floword.muted; font-size: 12px; wrap: word-wrap; }
    }
}
