        }

        // Module Pipeline DAG (6 Node Stages)
        Rectangle {
            background: Floword.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Floword.line-bright;
            clip: true;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 8px; height: 8px; border-radius: 4px; background: Floword.warning;
