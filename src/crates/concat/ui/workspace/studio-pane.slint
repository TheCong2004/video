                            }
                            Text { text: "OmniRoute Gateway"; color: Floword.text; font-size: 13px; font-weight: 700; }
                            Text { text: "Định tuyến 160+ LLMs, Circuit Breaker tự động."; color: Floword.muted; font-size: 11px; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
