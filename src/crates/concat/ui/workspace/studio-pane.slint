                            }
                            Text { text: "Ý Tưởng & Kịch Bản"; color: Floword.text; font-size: 13px; font-weight: 700; }
                            Text { text: "Nhập đề tài, AI mở rộng phân cảnh kịch bản."; color: Floword.muted; font-size: 11px; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                            StudioButton { label: "Mở Kịch Bản"; clicked => { root.navigate(StudioRoute.scripts); } }
