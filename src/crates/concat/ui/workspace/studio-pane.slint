            background: Floword.surface;
            border-radius: 18px;
            border-width: 1px;
            border-color: Floword.line-bright;
            clip: true;

            HorizontalLayout {
                padding: 22px;
                spacing: 22px;
                alignment: space-between;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            background: Floword.cyan.with-alpha(0.18);
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Floword.cyan.with-alpha(0.35);
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; padding-top: 3px; padding-bottom: 3px;
                                Text {
                                    text: "XƯỞNG SẢN XUẤT VIDEO AI · OBSIDIAN V2";
