import { I18n } from "../i18n.slint";
import { Theme, Button, Select } from "../primitives/primitives.slint";
import { StudioAiPage } from "studio-ai.slint";
import { StudioBrowser } from "studio-browser.slint";
import { StudioPagesPanel } from "studio-pages.slint";
import { StudioOpenTalking, StudioOpenTalkingPage } from "studio-opentalking.slint";
import { StudioLivePage, StudioLive } from "studio-live.slint";
import { StudioBulkPanel } from "studio-bulk.slint";
import { StudioPublishPanel } from "studio-publish.slint";
import { StudioScripts, ScriptLibrary } from "studio-scripts.slint";
import { ProductionStudio, StudioProduction, StudioRunList } from "studio-production.slint";
import { Floword } from "../theme/floword.slint";
import { Glyph, Icon } from "../icons.slint";
import { StudioCard, StudioHeading, StudioButton, StudioField, StudioMetric, LiquidBackground } from "studio-chrome.slint";
import { StudioChannels } from "studio-pages.slint";
import { AutoShortsPage } from "auto-shorts.slint";
import { StudioFilmPage, FilmStudio } from "studio-film.slint";
export { FilmStudio } from "studio-film.slint";
import { LauncherUi } from "../launcher-ui.slint";
import { KediFactoryPanel, KediProviderPanel, KediFactory } from "studio-kedi-factory.slint";
import { AiControlPage, AiControl } from "studio-ai-control.slint";
export { AiControl, ControlStepRow } from "studio-ai-control.slint";
export { KediFactory } from "studio-kedi-factory.slint";

// Launcher tools: available before a project exists; not part of MediaFilter.
export enum StudioRoute {
    production, film, opentalking, live, workflows, scripts, bulk,
    jobs, channels, publish, history, settings, keys, auto-shorts,
    web, hotclip,
    kedi-factory, kedi-providers, ai-control,
}

export struct StudioWorkflowRow {
    id: string,
    name: string,
    version: string,
    description: string,
    nodes: int,
    edges: int,
}

export global StudioBridge {
    in-out property <bool> show-advanced: false;
    in-out property <bool> checking;
    // 0 unchecked, 1 reachable JSON, 2 unavailable, 3 invalid response.
    in-out property <int> promax-state;
    in-out property <int> artcraft-state;
    in-out property <int> nexora-state;
    callback check-services();
    callback start-nexora();
    in-out property <[StudioWorkflowRow]> workflows;
    in-out property <bool> workflows-loading;
    in-out property <bool> workflow-worker-busy;
    in-out property <int> workflow-generation;
    // 0 idle, 1 success, 2 auth, 3 forbidden, 4 limit, 5 unavailable,
    // 6 invalid response, 7 configuration. Error text never comes from server.
    in-out property <int> workflows-state;
    callback refresh-workflows();
    callback cancel-workflows();

    public pure function workflow-status(state: int) -> string {
        return state == 1 ? I18n.t("productionStudio.workflowsLoaded")
            : state == 2 ? I18n.t("productionStudio.authRequired")
            : state == 3 ? I18n.t("productionStudio.accessDenied")
            : state == 4 ? I18n.t("productionStudio.rateLimited")
            : state == 5 ? I18n.t("productionStudio.workflowUnavailable")
            : state == 6 ? I18n.t("productionStudio.workflowInvalid")
            : state == 7 ? I18n.t("productionStudio.workflowConfiguration")
            : state == 8 ? I18n.t("productionStudio.workflowCancelled")
            : I18n.t("productionStudio.workflowIdle");
    }

    public pure function status-label(state: int) -> string {
        return state == 1 ? I18n.t("productionStudio.reachable")
            : state == 2 ? I18n.t("productionStudio.unavailable")
            : state == 3 ? I18n.t("productionStudio.invalidResponse") : I18n.t("productionStudio.unchecked");
    }

    public pure function title(route: StudioRoute) -> string {
        return route == StudioRoute.ai-control ? "AI Control" : route == StudioRoute.film ? "Làm phim từ ý tưởng" : route == StudioRoute.auto-shorts ? "Video dài → clip ngắn"
            : route == StudioRoute.web ? "NexPulse"
            : route == StudioRoute.hotclip ? "Hotclip"
            : route == StudioRoute.kedi-factory ? "Kedi Factory"
            : route == StudioRoute.kedi-providers ? "Nguồn & Provider"
            : route == StudioRoute.production ? I18n.t("productionStudio.production")
            : route == StudioRoute.opentalking ? I18n.t("studioOpenTalking.nav")
            : route == StudioRoute.live ? I18n.t("studioLive.nav")
            : route == StudioRoute.workflows ? I18n.t("productionStudio.workflows")
            : route == StudioRoute.scripts ? I18n.t("productionStudio.scripts")
            : route == StudioRoute.bulk ? "Danh sách video"
            : route == StudioRoute.jobs ? I18n.t("productionStudio.jobs")
            : route == StudioRoute.channels ? I18n.t("productionStudio.channels")
            : route == StudioRoute.publish ? I18n.t("productionStudio.publish")
            : route == StudioRoute.history ? I18n.t("productionStudio.history")
            : route == StudioRoute.settings ? I18n.t("productionStudio.settings") : I18n.t("productionStudio.keys");
    }
}

export component StudioPage inherits VerticalLayout {
    min-width: 0px;
    in property <length> viewport-width: 1080px;
    in property <length> viewport-height: 720px;
    in property <StudioRoute> route;
    callback choose-project();
    callback back();
    callback navigate(route: StudioRoute);
    padding: 16px;
    spacing: 16px;
    alignment: start;
    if root.route != StudioRoute.auto-shorts: FlexboxLayout {
        min-width: 0px; spacing: 8px;
        if root.route != StudioRoute.live: Text { text: StudioBridge.title(root.route); color: Floword.text; font-size: 20px; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; vertical-alignment: center; }
        if root.route != StudioRoute.ai-control && root.route != StudioRoute.film && root.route != StudioRoute.production && root.route != StudioRoute.kedi-factory && root.route != StudioRoute.kedi-providers: StudioButton { label: "← Xưởng phim AI"; compact: true; clicked => { root.navigate(StudioRoute.production); } }
        if root.route == StudioRoute.production: StudioButton { label: "Mẫu kịch bản"; compact: true; clicked => { root.navigate(StudioRoute.scripts); } }
        if root.route == StudioRoute.production: StudioButton { label: "Quy trình"; compact: true; clicked => { root.navigate(StudioRoute.workflows); } }
        if root.route == StudioRoute.production: StudioButton { label: "Tác vụ"; compact: true; clicked => { root.navigate(StudioRoute.jobs); } }
        if root.route == StudioRoute.production: StudioButton { label: "Kedi Factory"; compact: true; clicked => { root.navigate(StudioRoute.kedi-factory); } }
        if root.route == StudioRoute.kedi-factory: StudioButton { label: "Công cụ và nguồn"; compact: true; clicked => { root.navigate(StudioRoute.kedi-providers); } }
        if root.route == StudioRoute.kedi-providers: StudioButton { label: "Về Kedi Factory"; compact: true; clicked => { root.navigate(StudioRoute.kedi-factory); } }
    }
    if root.route == StudioRoute.ai-control: StudioCard {
        init => {AiControl.workspace-open=true;}
        StudioHeading { title:"Phòng điều hành AI"; }
        Text { text:"Quản lý yêu cầu, kế hoạch và các bước AI đang thực hiện trong không gian riêng."; color:Floword.muted; wrap:word-wrap; min-width:0px; }
        StudioButton { label:"Mở phòng điều hành AI"; primary:true; clicked=>{AiControl.workspace-open=true;} }
    }
    if root.route == StudioRoute.production: StudioCard {
        HorizontalLayout {
            spacing: 12px;
            alignment: space-between;
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Rectangle { width: 22px; height: 22px; border-radius: 11px; background: Floword.accent; Text { text: "1"; color: Floword.on-accent; font-weight: 700; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                Text { text: "1. Tạo kịch bản"; color: Floword.text; font-weight: 600; font-size: 13px; vertical-alignment: center; }
            }
            Text { text: "→"; color: Floword.muted; font-size: 14px; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Rectangle { width: 22px; height: 22px; border-radius: 11px; background: Floword.field; border-width: 1px; border-color: Floword.line; Text { text: "2"; color: Floword.text; font-weight: 700; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                Text { text: "2. Tạo tư liệu media"; color: Floword.muted; font-size: 13px; vertical-alignment: center; }
            }
            Text { text: "→"; color: Floword.muted; font-size: 14px; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Rectangle { width: 22px; height: 22px; border-radius: 11px; background: Floword.field; border-width: 1px; border-color: Floword.line; Text { text: "3"; color: Floword.text; font-weight: 700; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                Text { text: "3. Dựng & Xuất video"; color: Floword.muted; font-size: 13px; vertical-alignment: center; }
            }
        }
    }
    if root.route == StudioRoute.auto-shorts: AutoShortsPage { }
    if root.route == StudioRoute.production: StudioProduction { }
    if root.route == StudioRoute.film: StudioFilmPage { viewport-width: root.viewport-width; }
    if root.route == StudioRoute.opentalking: StudioOpenTalkingPage {
        viewport-width: Math.max(0px, root.viewport-width - 32px);
        viewport-height: root.viewport-height;
        motion-clips: StudioLive.director-clips;
        motion-enabled: StudioLive.director-enabled;
        motion-busy: StudioLive.director-busy || StudioLive.is-speaking;
        motion-status: StudioLive.director-status;
        choose-motion-clip(index) => { StudioLive.choose-director-clip(index); }
        clear-motion-clip(index) => { StudioLive.clear-director-clip(index); }
        toggle-motion-clips => { StudioLive.toggle-director(); }
        navigate-to-live => { root.navigate(StudioRoute.live); }
    }
    if root.route == StudioRoute.live: StudioLivePage {
        viewport-width: Math.max(0px, root.viewport-width - 32px);
        viewport-height: root.viewport-height;
        configure-ai => { root.navigate(StudioRoute.keys); }
        configure-services => { }
        manage-avatars => { StudioOpenTalking.active-tab = 1; root.navigate(StudioRoute.opentalking); }
    }
    if root.route == StudioRoute.scripts: StudioScripts {
        apply-template(brief, scenes, duration) => {
            ProductionStudio.brief = brief; ProductionStudio.scenes = scenes;
            ProductionStudio.duration = duration; ProductionStudio.invalidate();
            root.navigate(StudioRoute.production);
        }
    }
    if root.route == StudioRoute.jobs || root.route == StudioRoute.history: VerticalLayout {
        spacing: 16px;
        Text { text: ProductionStudio.status; color: Floword.muted; wrap: word-wrap; }
        StudioRunList { history-only: root.route == StudioRoute.history; }
    }
    if root.route == StudioRoute.workflows: StudioCard {
        StudioHeading { title: "Danh mục quy trình"; }
        Text { text: "Dịch vụ thực thi chưa được cấu hình. Chưa thể chạy quy trình."; color: Floword.warning; wrap: word-wrap; }
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioButton {
                label: StudioBridge.workflows-loading ? "Đang tải…" : "Tải danh mục";
                enabled: !StudioBridge.workflow-worker-busy;
                clicked => { StudioBridge.refresh-workflows(); }
            }
            if StudioBridge.workflows-loading: StudioButton { label: "Hủy tải"; clicked => { StudioBridge.cancel-workflows(); } }
        }
        if StudioBridge.workflows-state != 0: Text { text: StudioBridge.workflow-status(StudioBridge.workflows-state); color: Floword.warning; wrap: word-wrap; }
        if !StudioBridge.workflows-loading && StudioBridge.workflows.length == 0: Text { text: "Chưa có quy trình."; color: Floword.muted; wrap: word-wrap; }
        for workflow in StudioBridge.workflows: VerticalLayout {
            spacing: 8px;
            Rectangle { height: 1px; background: Floword.line; }
            Text { text: workflow.name; color: Floword.text; font-size: 16px; font-weight: 600; wrap: word-wrap; }
            if workflow.description != "": Text { text: workflow.description; color: Floword.muted; wrap: word-wrap; }
            StudioButton {
                label: "Dùng tên làm ý tưởng";
                clicked => {
                    ProductionStudio.brief = "Chạy workflow: " + workflow.name;
                    ProductionStudio.invalidate(); root.navigate(StudioRoute.production);
                }
            }
        }
    }
    if root.route == StudioRoute.settings: StudioCard {
        StudioHeading { title: "Giao diện và chuyển động"; }
        Text { text: "Chọn cách hiển thị phù hợp với bạn. Các lựa chọn được lưu trên máy."; color: Floword.muted; wrap: word-wrap; }
        FlexboxLayout {
            min-width: 0px; spacing: 8px;
            StudioButton { label: Theme.dark ? "Chuyển sang giao diện sáng" : "Chuyển sang giao diện tối"; clicked => { LauncherUi.theme-changed(!Theme.dark); } }
            StudioButton { label: Theme.system-reduced-motion ? "Giảm chuyển động theo hệ điều hành" : Theme.reduced-motion ? "Chuyển động: Đã giảm" : "Chuyển động: Đầy đủ"; enabled: !Theme.system-reduced-motion; clicked => { LauncherUi.reduced-motion-changed(!Theme.reduced-motion); } }
        }
        Select {
            options: ["Thanh bên tự động", "Ghim thanh bên mở", "Thu gọn thanh bên"];
            current: LauncherUi.sidebar-mode;
            changed(index) => { LauncherUi.sidebar-mode-changed(index); }
        }
    }
    if root.route == StudioRoute.channels: StudioPagesPanel { }
    if root.route == StudioRoute.keys: StudioAiPage { account => { root.navigate(StudioRoute.live); } }
    if root.route == StudioRoute.bulk: StudioBulkPanel { }
    if root.route == StudioRoute.publish: StudioPublishPanel { }
    if root.route == StudioRoute.kedi-factory: KediFactoryPanel { viewport-width: root.viewport-width; }
    if root.route == StudioRoute.kedi-providers: KediProviderPanel { }
}




