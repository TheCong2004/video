## Do not remove these
test/assets/
test/assets/*

# Rust
target/
**/target/
*.pdb

# Nix build output
/result
/result-*

# Python (tooling and one-off scripts live at the repo root for now)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Scratch media at the repo root.
#
# Test clips are large and change constantly, so they do not belong in git
# history. Fixtures that tests genuinely depend on should live in a `fixtures/`
# directory next to those tests and be committed deliberately - this pattern
# only covers loose files dropped at the top level.
/*.mp4
/*.mov
/*.mkv
/*.webm
/*.mp3
/*.wav
/*.flac
/*.aac
/scratch_*

# Local environment
.env
.env.local

# An FFmpeg development build unpacked locally for the linked engine
# (headers + import libraries), pointed at with FFMPEG_DIR. Large and
# machine-specific.
# Local build dependencies
.deps/
# Native compiler scratch, isolated acceptance fixtures and local service logs.
# Keep caches on D without accidentally committing them or credentials.
/.runtime/
# Generated Windows packages/installers are deliverables, not source.
/dist/
dist/
/vendor/
/ffmpeg-dev/
# FFmpeg built for a phone by src/scripts/ffmpeg-mobile.sh: sources,
# build trees and the installed prefixes, all machine-built.
/src/vendor/

# Dependencies across all tools and scripts
**/node_modules/
node_modules/

# Logs and debug files
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files, backups and crash dumps
*.tmp
*.temp
*.bak
*.orig
*.rej
*.dmp
*.stackdump
*.crash

# Cache directories
.cache/
**/.cache/
.turbo/
.parcel-cache/
.eslintcache

# Media scratch and partial downloads
*.part
*.crdownload
# AI agent rules and scratch files
.ai-*
*.ai-*
/scratch/
scratch/


