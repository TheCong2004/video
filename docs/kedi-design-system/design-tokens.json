{
  "name": "Kedi Liquid Design System",
  "version": 1,
  "kind": "portable-native-token-snapshot",
  "source": [
    "src/crates/concat/ui/theme/theme.slint",
    "src/crates/concat/ui/theme/light.slint",
    "src/crates/concat/ui/theme/dark.slint",
    "src/crates/concat/ui/theme/floword.slint"
  ],
  "scope": "Studio and launcher shell; editor timeline/media semantic colors are not redefined",
  "colors": {
    "light": {
      "background-primary": "#F7FAFE",
      "background-secondary": "#EDF5FC",
      "surface-primary": "#FFFFFF",
      "surface-secondary": "#F5F8FC",
      "surface-raised": "#FFFFFF",
      "surface-tint": "#E6EEFF",
      "text-primary": "#17365D",
      "text-secondary": "#506985",
      "text-muted": "#637B97",
      "brand-primary": "#315DCC",
      "brand-hover": "#264DAF",
      "brand-soft": "#E6EEFF",
      "on-brand": "#FFFFFF",
      "accent-yellow": "#FFC83D",
      "navigation-selected": "#FFF3CF",
      "navigation-selected-ink": "#17365D",
      "border-default": "#DCE6F2",
      "border-strong": "#B4C7DE",
      "border-soft": "#EAF0F7",
      "success": "#087F5B",
      "warning": "#94600C",
      "danger": "#D70015",
      "info": "#1667AC",
      "violet": "#6C4FC5"
    },
    "dark": {
      "background-primary": "#0B1221",
      "background-secondary": "#121D30",
      "surface-primary": "#172339",
      "surface-secondary": "#1D2D46",
      "surface-raised": "#1D2D46",
      "surface-tint": "#1E2D4A",
      "text-primary": "#F5F5F7",
      "text-secondary": "#A1A1A6",
      "text-muted": "#6E6E73",
      "brand-primary": "#7BA6FF",
      "brand-hover": "#96B9FF",
      "brand-soft": "#1E2D4A",
      "on-brand": "#0B1221",
      "accent-yellow": "#FFD359",
      "navigation-selected": "#382F16",
      "navigation-selected-ink": "#FFE8A3",
      "border-default": "#304460",
      "border-strong": "#FFFFFF33",
      "border-soft": "#243552",
      "success": "#38D9A5",
      "warning": "#FFBE62",
      "danger": "#FF453A",
      "info": "#70C7FF",
      "violet": "#B59EFF"
    }
  },
  "typography": {
    "font-family": "Hanken Grotesk",
    "font-fallback": "system-ui, sans-serif",
    "display-px": 34,
    "page-title-px": 24,
    "section-title-px": 18,
    "body-px": 14,
    "input-px": 15,
    "body-weight": 400,
    "title-weight": 500,
    "display-weight": 700
  },
  "spacingPx": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24
  },
  "radiusPx": {
    "control": 12,
    "navigation": 12,
    "card": 16,
    "card-large": 20,
    "dialog": 24
  },
  "motion": {
    "reduced-default": true,
    "persisted": "existing Studio preferences",
    "native-os-detection": "Windows SPI_GETCLIENTAREAANIMATION read once at startup; query failure/non-Windows safely reduce",
    "effective-rule": "Theme.motion-reduced = Theme.reduced-motion || Theme.system-reduced-motion",
    "system-setting-mutated": false,
    "live-os-change-watched": false,
    "hover-ms": 160,
    "press-ms": 100,
    "tab-ms": 220,
    "panel-ms": 260,
    "reduced-ms": 0,
    "easing": [
      0.16,
      1,
      0.3,
      1
    ],
    "ambient": "up to two native StartScreen washes; Timer toggles phase every 10s with 10s x/y/radius transitions, yielding 20s cycle when active and effective motion permits; static fallback otherwise",
    "ambient-phase-ms": 10000,
    "ambient-cycle-ms": 20000,
    "ambient-minimize-timer-explicitly-suspended": false,
    "ambient-editor-lifecycle": "StartScreen destroyed on editor entry; component and timer absent from editor",
    "performance": "not benchmarked"
  },
  "sidebar": {
    "mode-ids": {
      "auto": 0,
      "pinned": 1,
      "collapsed": 2
    },
    "expanded-px": 252,
    "collapsed-px": 68,
    "medium-below-px": 1100,
    "drawer-below-px": 680,
    "drawer-max-px": 280,
    "drawer-viewport-margin-px": 28,
    "hover-exit-delay-ms": 420,
    "transition-ms": 240,
    "hover-pushes-content": false,
    "pinned-reserves-expanded-at-or-above-px": 680,
    "auto-medium-reserved-px": 68,
    "pin-row-space-always-reserved": true,
    "group-heading-reserved-px": 16,
    "hover-vertically-shifts-routes": false,
    "hotclip-launcher-entry-visible": false,
    "legacy-long-to-short-launcher-entry-visible": false,
    "hotclip-entry": "native editor next to AI assistant",
    "persisted": "StudioPrefs.sidebar_mode"
  }
}
